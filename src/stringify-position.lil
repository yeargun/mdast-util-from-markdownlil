// unist-util-stringify-position, as this package uses it: every caller passes a token, and upstream
// builds `{start: token.start, end: token.end}` for it, which always takes the `start`/`end` branch.
JsValue index(JsValue value) {
  return if (value.truthy() && JS.typeOf(value) == "number") { value } else { 1 };
}

string point(JsValue value) {
  return index(JS.and(value, value["line"])) + ":" + index(JS.and(value, value["column"]));
}

export string stringifyPosition(JsValue token) {
  return point(token["start"]) + "-" + point(token["end"]);
}
