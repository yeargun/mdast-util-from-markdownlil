import { Opts, DefRec } from "./options.lil";
import {
  kids, add, count, at, isWsCode, isSpaceTab, isDigit, isAlpha, isAlnum, isAsciiPunct,
  skipSpaceTab, rtrimWs, unescape, findClosing, isPunctOrWs
} from "./util.lil";
import {
  nodeText, nodeInlineCode, nodeHtml, nodeEmphasis, nodeStrong, nodeDelete, nodeBreak,
  nodeLink, nodeImage, nodeLinkRef, nodeImageRef, nodeInlineMath, mergeText
} from "./nodes.lil";

class Piece {
  int kind;
  string text;
  string mark;
  int num;
  bool canOpen;
  bool canClose;
  JsValue node;

  init() {
    this.kind = 0;
    this.text = "";
    this.mark = "";
    this.num = 0;
    this.canOpen = false;
    this.canClose = false;
    this.node = JS.object();
  }
}

class Dest {
  bool ok;
  string url;
  string title;
  int pos;

  init() {
    this.ok = false;
    this.url = "";
    this.title = "";
    this.pos = 0;
  }
}

Piece makeText(string text) {
  Piece p = new Piece();
  p.kind = 0;
  p.text = text;
  return p;
}

Piece makeDelim(string mark, int num, bool canOpen, bool canClose) {
  Piece p = new Piece();
  p.kind = 1;
  p.mark = mark;
  p.num = num;
  p.text = mark.repeat(num);
  p.canOpen = canOpen;
  p.canClose = canClose;
  return p;
}

Piece makeNode(JsValue node) {
  Piece p = new Piece();
  p.kind = 2;
  p.node = node;
  return p;
}

int prevCode(string s, int i) {
  if (i <= 0) {
    return -1;
  }
  return s.charCodeAt(i - 1);
}

int nextCode(string s, int i) {
  if (i >= s.length) {
    return -1;
  }
  return s.charCodeAt(i);
}

bool leftFlank(int prev, int next) {
  if (next < 0 || isWsCode(next)) {
    return false;
  }
  if (!isAsciiPunct(next)) {
    return true;
  }
  return prev < 0 || isWsCode(prev) || isAsciiPunct(prev);
}

bool rightFlank(int prev, int next) {
  if (prev < 0 || isWsCode(prev)) {
    return false;
  }
  if (!isAsciiPunct(prev)) {
    return true;
  }
  return next < 0 || isWsCode(next) || isAsciiPunct(next);
}

bool ruleOfThree(Piece opener, Piece closer) {
  bool both = (opener.canOpen && opener.canClose) || (closer.canOpen && closer.canClose);
  if (!both) {
    return false;
  }
  int sum = opener.num + closer.num;
  if (sum % 3 != 0) {
    return false;
  }
  return opener.num % 3 != 0 || closer.num % 3 != 0;
}

JsValue flattenPieces(Piece[] pieces, int from, int to) {
  JsValue out = kids();
  if (to < from) {
    return out;
  }
  string buf = "";
  int i = from;
  while (i <= to) {
    Piece p = pieces[i];
    if (p.kind == 2) {
      if (buf.length > 0) {
        add(out, nodeText(buf));
        buf = "";
      }
      add(out, p.node);
    } else {
      buf = buf + p.text;
    }
    i = i + 1;
  }
  if (buf.length > 0) {
    add(out, nodeText(buf));
  }
  return mergeText(out);
}

void replaceSpan(Piece[] pieces, Piece[] next) {
  pieces.splice(0, pieces.length);
  int i = 0;
  while (i < next.length) {
    pieces.push(next[i]);
    i = i + 1;
  }
}

void applyMatch(Piece[] pieces, int openIdx, int closeIdx) {
  Piece opener = pieces[openIdx];
  Piece closer = pieces[closeIdx];
  int use = 1;
  if (opener.num >= 2 && closer.num >= 2) {
    use = 2;
  }
  JsValue children = flattenPieces(pieces, openIdx + 1, closeIdx - 1);
  JsValue node = nodeEmphasis(children);
  if (use == 2) {
    node = nodeStrong(children);
  }
  opener.num = opener.num - use;
  closer.num = closer.num - use;
  opener.text = opener.mark.repeat(opener.num);
  closer.text = closer.mark.repeat(closer.num);
  Piece[] next = [];
  int i = 0;
  while (i < openIdx) {
    next.push(pieces[i]);
    i = i + 1;
  }
  if (opener.num > 0) {
    next.push(opener);
  }
  next.push(makeNode(node));
  if (closer.num > 0) {
    next.push(closer);
  }
  i = closeIdx + 1;
  while (i < pieces.length) {
    next.push(pieces[i]);
    i = i + 1;
  }
  replaceSpan(pieces, next);
}

void resolveEmphasis(Piece[] pieces) {
  int guard = 0;
  int i = 0;
  while (i < pieces.length && guard < 10000) {
    guard = guard + 1;
    Piece closer = pieces[i];
    if (closer.kind != 1 || !closer.canClose) {
      i = i + 1;
      continue;
    }
    int j = i - 1;
    bool found = false;
    while (j >= 0) {
      Piece opener = pieces[j];
      if (opener.kind == 1 && opener.canOpen && opener.mark == closer.mark && !ruleOfThree(opener, closer)) {
        applyMatch(pieces, j, i);
        i = j;
        found = true;
        break;
      }
      j = j - 1;
    }
    if (!found) {
      i = i + 1;
    }
  }
}

int countRun(string src, int i, string mark) {
  int n = 0;
  while (i + n < src.length && src.charAt(i + n) == mark) {
    n = n + 1;
  }
  return n;
}

string codeValue(string raw) {
  string v = "";
  int i = 0;
  while (i < raw.length) {
    string ch = raw.charAt(i);
    if (ch == "\n") {
      v = v + " ";
    } else {
      v = v + ch;
    }
    i = i + 1;
  }
  if (v.length >= 2 && v.charAt(0) == " " && v.charAt(v.length - 1) == " ") {
    int k = 0;
    bool inner = false;
    while (k < v.length) {
      if (v.charAt(k) != " ") {
        inner = true;
        break;
      }
      k = k + 1;
    }
    if (inner) {
      return v.slice(1, v.length - 1);
    }
  }
  return v;
}

int tryCode(string src, int i, Piece[] pieces) {
  if (src.charAt(i) != "`") {
    return i;
  }
  int ticks = countRun(src, i, "`");
  int j = i + ticks;
  while (j < src.length) {
    if (src.charAt(j) == "`") {
      int close = countRun(src, j, "`");
      if (close == ticks) {
        string raw = src.slice(i + ticks, j);
        pieces.push(makeNode(nodeInlineCode(codeValue(raw))));
        return j + close;
      }
      j = j + close;
    } else {
      j = j + 1;
    }
  }
  pieces.push(makeText(src.slice(i, i + ticks)));
  return i + ticks;
}

int tryEscape(string src, int i, Piece[] pieces, Opts opt) {
  if (src.charAt(i) != "\\") {
    return i;
  }
  if (i + 1 >= src.length) {
    pieces.push(makeText("\\"));
    return i + 1;
  }
  string next = src.charAt(i + 1);
  if (next == "\n") {
    pieces.push(makeNode(nodeBreak()));
    return i + 2;
  }
  int c = next.charCodeAt(0);
  if (isAsciiPunct(c)) {
    pieces.push(makeText(next));
    return i + 2;
  }
  pieces.push(makeText("\\"));
  return i + 1;
}

int tryBreak(string src, int i, Piece[] pieces, Opts opt) {
  if (src.charAt(i) != "\n") {
    return i;
  }
  bool hard = false;
  if (i >= 2 && src.charAt(i - 1) == " " && src.charAt(i - 2) == " ") {
    hard = true;
  }
  if (hard || opt.breaks) {
    if (hard && pieces.length > 0) {
      Piece last = pieces[pieces.length - 1];
      if (last.kind == 0) {
        last.text = rtrimWs(last.text);
      }
    }
    pieces.push(makeNode(nodeBreak()));
  } else {
    pieces.push(makeText("\n"));
  }
  return i + 1;
}

Dest parseDestination(string src, int i) {
  Dest d = new Dest();
  i = skipSpaceTab(src, i);
  if (i >= src.length) {
    return d;
  }
  if (src.charAt(i) == "<") {
    int close = findClosing(src, i + 1, "<", ">");
    if (close < 0) {
      return d;
    }
    d.url = unescape(src.slice(i + 1, close));
    i = close + 1;
  } else {
    int depth = 0;
    int start = i;
    while (i < src.length) {
      string ch = src.charAt(i);
      int c = ch.charCodeAt(0);
      if (ch == "\\" && i + 1 < src.length) {
        i = i + 2;
        continue;
      }
      if (isWsCode(c)) {
        break;
      }
      if (ch == "(") {
        depth = depth + 1;
      } else if (ch == ")") {
        if (depth == 0) {
          break;
        }
        depth = depth - 1;
      }
      i = i + 1;
    }
    if (i == start) {
      return d;
    }
    d.url = unescape(src.slice(start, i));
  }
  int after = skipSpaceTab(src, i);
  if (after < src.length) {
    string q = src.charAt(after);
    string end = "";
    if (q == "\"") {
      end = "\"";
    } else if (q == "'") {
      end = "'";
    } else if (q == "(") {
      end = ")";
    }
    if (end.length > 0) {
      int close = findClosing(src, after + 1, q, end);
      if (close >= 0) {
        d.title = unescape(src.slice(after + 1, close));
        i = skipSpaceTab(src, close + 1);
      } else {
        i = after;
      }
    } else {
      i = after;
    }
  } else {
    i = after;
  }
  d.ok = true;
  d.pos = i;
  return d;
}

string textOf(JsValue children) {
  string out = "";
  int n = count(children);
  int i = 0;
  while (i < n) {
    JsValue node = at(children, i);
    string typ = JS.string(node["type"]);
    if (typ == "text" || typ == "inlineCode" || typ == "html" || typ == "inlineMath") {
      out = out + JS.string(node["value"]);
    } else {
      JsValue nested = node["children"];
      if (!(JS.isUndefined(nested) || JS.isNullish(nested))) {
        out = out + textOf(nested);
      }
    }
    i = i + 1;
  }
  return out;
}

int tryLink(string src, int i, Piece[] pieces, Opts opt, Map<string, DefRec> defs, bool inLink) {
  bool image = false;
  int start = i;
  if (src.charAt(i) == "!" && i + 1 < src.length && src.charAt(i + 1) == "[") {
    image = true;
    i = i + 1;
  }
  if (src.charAt(i) != "[") {
    return start;
  }
  if (inLink && !image) {
    pieces.push(makeText("["));
    return start + 1;
  }
  int close = findClosing(src, i + 1, "[", "]");
  if (close < 0) {
    pieces.push(makeText(src.slice(start, start + 1)));
    return start + 1;
  }
  string label = src.slice(i + 1, close);
  int after = close + 1;
  JsValue children = parseInlines(label, opt, defs, true);
  if (after < src.length && src.charAt(after) == "(") {
    Dest dest = parseDestination(src, after + 1);
    if (dest.ok && dest.pos < src.length && src.charAt(dest.pos) == ")") {
      string? title = null;
      if (dest.title.length > 0) {
        title = dest.title;
      }
      if (image) {
        pieces.push(makeNode(nodeImage(dest.url, title, textOf(children))));
      } else {
        pieces.push(makeNode(nodeLink(dest.url, title, children)));
      }
      return dest.pos + 1;
    }
  }
  string refType = "shortcut";
  string refLabel = label;
  if (after < src.length && src.charAt(after) == "[") {
    int refClose = findClosing(src, after + 1, "[", "]");
    if (refClose >= 0) {
      string inner = src.slice(after + 1, refClose);
      if (inner.length == 0) {
        refType = "collapsed";
      } else {
        refType = "full";
        refLabel = inner;
      }
      after = refClose + 1;
    }
  }
  string id = normIdent(refLabel);
  DefRec? found = defs.get(id);
  if (found != null) {
    string? title = null;
    if (found.title.length > 0) {
      title = found.title;
    }
    if (image) {
      pieces.push(makeNode(nodeImage(found.url, title, textOf(children))));
    } else {
      pieces.push(makeNode(nodeLink(found.url, title, children)));
    }
    return after;
  }
  if (refType != "shortcut") {
    if (image) {
      pieces.push(makeNode(nodeImageRef(id, refLabel, refType, textOf(children))));
    } else {
      pieces.push(makeNode(nodeLinkRef(id, refLabel, refType, children)));
    }
    return after;
  }
  pieces.push(makeText(src.slice(start, start + 1)));
  return start + 1;
}

string normIdent(string label) {
  string t = label.trim().toLowerCase();
  string out = "";
  bool space = false;
  int i = 0;
  while (i < t.length) {
    int c = t.charCodeAt(i);
    if (isWsCode(c)) {
      if (!space) {
        out = out + " ";
        space = true;
      }
    } else {
      out = out + t.charAt(i);
      space = false;
    }
    i = i + 1;
  }
  return out;
}

int tryAutolinkOrHtml(string src, int i, Piece[] pieces, Opts opt) {
  if (src.charAt(i) != "<") {
    return i;
  }
  int j = i + 1;
  if (j >= src.length) {
    pieces.push(makeText("<"));
    return i + 1;
  }
  if (src.slice(i, i + 4) == "<!--") {
    int end = src.indexOf("-->", i + 4);
    if (end >= 0) {
      string raw = src.slice(i, end + 3);
      if (opt.allowDangerousHtml) {
        pieces.push(makeNode(nodeHtml(raw)));
      } else {
        pieces.push(makeText(raw));
      }
      return end + 3;
    }
  }
  int c = src.charCodeAt(j);
  if (isAlpha(c)) {
    int k = j;
    while (k < src.length && (isAlnum(src.charCodeAt(k)) || src.charAt(k) == "+" || src.charAt(k) == "." || src.charAt(k) == "-")) {
      k = k + 1;
    }
    if (k < src.length && src.charAt(k) == ":") {
      int end = k + 1;
      while (end < src.length) {
        int e = src.charCodeAt(end);
        if (e == 62) {
          break;
        }
        if (isWsCode(e) || e == 60) {
          end = -1;
          break;
        }
        end = end + 1;
      }
      if (end > k && end < src.length && src.charAt(end) == ">") {
        string url = src.slice(j, end);
        JsValue child = kids();
        add(child, nodeText(url));
        pieces.push(makeNode(nodeLink(url, null, child)));
        return end + 1;
      }
    }
  }
  int at = src.indexOf("@", j);
  int gt = src.indexOf(">", j);
  if (at > j && gt > at) {
    string mail = src.slice(j, gt);
    if (mail.indexOf(" ") < 0 && mail.indexOf("\n") < 0) {
      JsValue child = kids();
      add(child, nodeText(mail));
      pieces.push(makeNode(nodeLink("mailto:" + mail, null, child)));
      return gt + 1;
    }
  }
  if (isAlpha(c) || src.charAt(j) == "/" || src.charAt(j) == "!" || src.charAt(j) == "?") {
    int end = src.indexOf(">", j);
    if (end > j && end - i < 1000 && src.slice(i, end).indexOf("\n") < 0) {
      string raw = src.slice(i, end + 1);
      if (opt.allowDangerousHtml) {
        pieces.push(makeNode(nodeHtml(raw)));
      } else {
        pieces.push(makeText(raw));
      }
      return end + 1;
    }
  }
  pieces.push(makeText("<"));
  return i + 1;
}

int tryMath(string src, int i, Piece[] pieces) {
  if (src.charAt(i) != "$") {
    return i;
  }
  if (i + 1 < src.length && src.charAt(i + 1) == "$") {
    pieces.push(makeText("$$"));
    return i + 2;
  }
  int j = i + 1;
  if (j < src.length && isWsCode(src.charCodeAt(j))) {
    pieces.push(makeText("$"));
    return i + 1;
  }
  while (j < src.length) {
    string ch = src.charAt(j);
    if (ch == "\\" && j + 1 < src.length) {
      j = j + 2;
      continue;
    }
    if (ch == "$") {
      string body = src.slice(i + 1, j);
      if (body.length > 0 && !isWsCode(src.charCodeAt(j - 1))) {
        pieces.push(makeNode(nodeInlineMath(body)));
        return j + 1;
      }
      break;
    }
    if (ch == "\n") {
      break;
    }
    j = j + 1;
  }
  pieces.push(makeText("$"));
  return i + 1;
}

int tryStrike(string src, int i, Piece[] pieces, Opts opt, Map<string, DefRec> defs, bool inLink) {
  if (!opt.gfm || src.charAt(i) != "~") {
    return i;
  }
  if (i + 1 >= src.length || src.charAt(i + 1) != "~") {
    pieces.push(makeText("~"));
    return i + 1;
  }
  if (i + 2 < src.length && src.charAt(i + 2) == "~") {
    pieces.push(makeText("~"));
    return i + 1;
  }
  int j = i + 2;
  while (j < src.length) {
    if (src.charAt(j) == "~" && j + 1 < src.length && src.charAt(j + 1) == "~") {
      if (j + 2 < src.length && src.charAt(j + 2) == "~") {
        j = j + 1;
        continue;
      }
      string inner = src.slice(i + 2, j);
      pieces.push(makeNode(nodeDelete(parseInlines(inner, opt, defs, inLink))));
      return j + 2;
    }
    j = j + 1;
  }
  pieces.push(makeText("~~"));
  return i + 2;
}

int tryDelim(string src, int i, Piece[] pieces) {
  string ch = src.charAt(i);
  if (ch != "*" && ch != "_") {
    return i;
  }
  int num = countRun(src, i, ch);
  int prev = prevCode(src, i);
  int next = nextCode(src, i + num);
  bool left = leftFlank(prev, next);
  bool right = rightFlank(prev, next);
  bool canOpen = left;
  bool canClose = right;
  if (ch == "_") {
    canOpen = left && (!right || prev < 0 || isAsciiPunct(prev));
    canClose = right && (!left || next < 0 || isAsciiPunct(next));
  }
  pieces.push(makeDelim(ch, num, canOpen, canClose));
  return i + num;
}

int gfmAutolinkEnd(string src, int i, bool inLink) {
  if (inLink) {
    return i;
  }
  if (i > 0 && !isPunctOrWs(src.charCodeAt(i - 1))) {
    return i;
  }
  string rest = src.slice(i);
  int scheme = 0;
  if (rest.startsWith("https://")) {
    scheme = 8;
  } else if (rest.startsWith("http://")) {
    scheme = 7;
  } else if (rest.startsWith("www.")) {
    scheme = 4;
  }
  if (scheme == 0) {
    return i;
  }
  int j = i + scheme;
  while (j < src.length) {
    int c = src.charCodeAt(j);
    if (isWsCode(c) || c == 60 || c == 62) {
      break;
    }
    j = j + 1;
  }
  while (j > i + scheme) {
    int c = src.charCodeAt(j - 1);
    if (c == 46 || c == 44 || c == 59 || c == 58 || c == 33 || c == 63 || c == 41) {
      j = j - 1;
    } else {
      break;
    }
  }
  if (j > i + scheme) {
    return j;
  }
  return i;
}

int tryGfmAutolink(string src, int i, Piece[] pieces, bool inLink) {
  int end = gfmAutolinkEnd(src, i, inLink);
  if (end == i) {
    return i;
  }
  string raw = src.slice(i, end);
  string href = raw;
  if (raw.startsWith("www.")) {
    href = "http://" + raw;
  }
  JsValue child = kids();
  add(child, nodeText(raw));
  pieces.push(makeNode(nodeLink(href, null, child)));
  return end;
}

bool isSpecial(string src, int i, Opts opt) {
  string ch = src.charAt(i);
  if (ch == "\\" || ch == "`" || ch == "*" || ch == "_" || ch == "[" || ch == "<" || ch == "\n") {
    return true;
  }
  if (ch == "!" && i + 1 < src.length && src.charAt(i + 1) == "[") {
    return true;
  }
  if (opt.gfm && ch == "~") {
    return true;
  }
  if (opt.math && ch == "$") {
    return true;
  }
  return false;
}

int tryText(string src, int i, Piece[] pieces, Opts opt, bool inLink) {
  int start = i;
  if (opt.gfm) {
    int gfm = tryGfmAutolink(src, i, pieces, inLink);
    if (gfm != i) {
      return gfm;
    }
  }
  while (i < src.length && !isSpecial(src, i, opt)) {
    if (opt.gfm && gfmAutolinkEnd(src, i, inLink) != i) {
      break;
    }
    i = i + 1;
  }
  if (i == start) {
    pieces.push(makeText(src.charAt(i)));
    return i + 1;
  }
  pieces.push(makeText(src.slice(start, i)));
  return i;
}

Piece[] scanPieces(string src, Opts opt, Map<string, DefRec> defs, bool inLink) {
  Piece[] pieces = [];
  int i = 0;
  int guard = 0;
  while (i < src.length && guard < src.length + 8) {
    guard = guard + 1;
    int next = tryEscape(src, i, pieces, opt);
    if (next != i) {
      i = next;
      continue;
    }
    next = tryBreak(src, i, pieces, opt);
    if (next != i) {
      i = next;
      continue;
    }
    next = tryCode(src, i, pieces);
    if (next != i) {
      i = next;
      continue;
    }
    if (opt.math) {
      next = tryMath(src, i, pieces);
      if (next != i) {
        i = next;
        continue;
      }
    }
    next = tryStrike(src, i, pieces, opt, defs, inLink);
    if (next != i) {
      i = next;
      continue;
    }
    next = tryLink(src, i, pieces, opt, defs, inLink);
    if (next != i) {
      i = next;
      continue;
    }
    next = tryAutolinkOrHtml(src, i, pieces, opt);
    if (next != i) {
      i = next;
      continue;
    }
    next = tryDelim(src, i, pieces);
    if (next != i) {
      i = next;
      continue;
    }
    i = tryText(src, i, pieces, opt, inLink);
  }
  return pieces;
}

export JsValue parseInlines(string src, Opts opt, Map<string, DefRec> defs, bool inLink) {
  Piece[] pieces = scanPieces(src, opt, defs, inLink);
  resolveEmphasis(pieces);
  return flattenPieces(pieces, 0, pieces.length - 1);
}
