// mdast-util-to-string, as `resume` calls it: no options, so `includeImageAlt` and `includeHtml` are both true.
export JsValue toString(JsValue value) {
  if (value.truthy() && JS.typeOf(value) == "object") {
    if (JS.in("value", value)) {
      return value["value"];
    }
    if (JS.in("alt", value) && value["alt"].truthy()) {
      return value["alt"];
    }
    if (JS.in("children", value)) {
      return all(value["children"]);
    }
  }
  if (value.isArray()) {
    return all(value);
  }
  return "";
}

JsValue all(JsValue values) {
  JsValue[] result = [];
  for (float index = 0; index < values.length; index++) {
    result.push(toString(values[index]));
  }
  return JS.invoke(result, "join", "");
}
