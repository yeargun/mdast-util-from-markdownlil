// mdast-util-from-markdown@2.0.x lib/index.js.
//
// Upstream keeps the compile state (`stack`, `tokenStack`, `data`) on a context object and every handler
// reads it through `this`, which is a fresh `Object.assign({sliceSerialize}, context)` per event. Those
// copies share the context's arrays and `data`, so `this.stack` is always the one `stack`: the handlers
// here close over them instead. `this` is still what handlers pass on (`sliceSerialize`, error handlers,
// extension handlers called through `this.config`).
import { hasOwn } from "./micromark/host.lil";
import { parse } from "./micromark/parse.lil";
import { postprocess } from "./micromark/postprocess.lil";
import { preprocess } from "./micromark/preprocess.lil";
import { decodeNumericCharacterReference } from "./micromark/util-decode-numeric.lil";
import { decodeString } from "./micromark/util-decode-string.lil";
import { normalizeIdentifier } from "./micromark/util-normalize-identifier.lil";
import { decodeNamedCharacterReference } from "./micromark/decode-named.lil";
import {
  tBlockQuote,
  tBlockQuoteMarker,
  tBlockQuotePrefix,
  tBlockQuotePrefixWhitespace,
  tCharacterReferenceMarkerNumeric,
  tLineEnding,
  tLineEndingBlank,
  tLinePrefix,
  tListItemIndent,
  tListItemMarker,
  tListItemPrefix,
  tListItemPrefixWhitespace,
  tListItemValue,
  tListOrdered,
  tListUnordered
} from "./micromark/symbol/types.lil";
import { stringifyPosition } from "./stringify-position.lil";
import { toString } from "./to-string.lil";

extern JsValue Error;
extern JsValue Number;
extern JsValue Object;

extern class Tokenizer {
  JsValue write(JsValue chunks);
}

extern class Parser {
  Tokenizer document();
}

Regex fenceEdges = new Regex("^(\\r?\\n|\\r)|(\\r?\\n|\\r)$", "g");
Regex trailingBreak = new Regex("(\\r?\\n|\\r)$", "g");

JsValue point(JsValue d) {
  return JS.object("line", d["line"], "column", d["column"], "offset", d["offset"]);
}

string slice(JsValue self, JsValue token) {
  return JS.assume(JS.invoke(self, "sliceSerialize", token));
}

JsValue defaultOnError = JS.method2((JsValue _self, JsValue left, JsValue right) => {
  throw JS.construct(Error, if (left.truthy()) {
    "Cannot close `" + left["type"] + "` (" + stringifyPosition(left) + "): a different token (`" + right["type"] + "`, " + stringifyPosition(right) + ") is open"
  } else {
    "Cannot close document, a token (`" + right["type"] + "`, " + stringifyPosition(right) + ") is still open"
  });
  return JS.undefined();
});

void configure(JsValue combined, JsValue extensions) {
  for (float index = 0; index < extensions.length; index++) {
    JsValue value = extensions[index];
    if (value.isArray()) {
      configure(combined, value);
    } else {
      extension(combined, value);
    }
  }
}

void extension(JsValue combined, JsValue ext) {
  for (string key in ext) {
    if (hasOwn(ext, key)) {
      if (key == "canContainEols" || key == "transforms") {
        JsValue right = ext[key];
        if (right.truthy()) {
          JsValue left = combined[key];
          JsValue[] items = JS.assume(right);
          JS.apply(left["push"], left, [...items]);
        }
      } else if (key == "enter" || key == "exit") {
        JsValue right = ext[key];
        if (right.truthy()) {
          JS.invoke(Object, "assign", combined[key], right);
        }
      }
    }
  }
}

float prepareList(JsValue events, float start, float length) {
  float index = start - 1;
  float containerBalance = -1;
  bool listSpread = false;
  JsValue listItem = JS.undefined();
  float lineIndex = 0;
  float firstBlankLineIndex = 0;
  bool atMarker = false;

  while (index < length) {
    index++;
    JsValue event = events[index];
    JsValue type = event[1]["type"];
    bool enter = event[0] == "enter";
    bool list = type == tListUnordered || type == tListOrdered;
    if (list || type == tBlockQuote) {
      if (enter) {
        containerBalance++;
      } else {
        containerBalance--;
      }
      atMarker = false;
    } else if (type == tLineEndingBlank) {
      if (enter) {
        if (listItem.truthy() && !atMarker && containerBalance == 0 && firstBlankLineIndex == 0) {
          firstBlankLineIndex = index;
        }
        atMarker = false;
      }
    } else if (type != tLinePrefix && type != tListItemValue && type != tListItemMarker && type != tListItemPrefix && type != tListItemPrefixWhitespace) {
      atMarker = false;
    }

    if (containerBalance == 0 && enter && type == tListItemPrefix || containerBalance == -1 && event[0] == "exit" && list) {
      if (listItem.truthy()) {
        float tailIndex = index;
        lineIndex = 0;
        while (tailIndex > 0) {
          tailIndex--;
          JsValue tailEvent = events[tailIndex];
          JsValue tailType = tailEvent[1]["type"];
          if (tailType == tLineEnding || tailType == tLineEndingBlank) {
            if (tailEvent[0] == "exit") {
              continue;
            }
            if (lineIndex != 0) {
              events[lineIndex][1]["type"] = tLineEndingBlank;
              listSpread = true;
            }
            tailEvent[1]["type"] = tLineEnding;
            lineIndex = tailIndex;
          } else if (tailType != tLinePrefix && tailType != tBlockQuotePrefix && tailType != tBlockQuotePrefixWhitespace && tailType != tBlockQuoteMarker && tailType != tListItemIndent) {
            break;
          }
        }
        if (firstBlankLineIndex != 0 && (lineIndex == 0 || firstBlankLineIndex < lineIndex)) {
          listItem["_spread"] = true;
        }
        listItem["end"] = JS.invoke(Object, "assign", JS.object(), if (lineIndex != 0) { events[lineIndex][1]["start"] } else { event[1]["end"] });
        JS.invoke(events, "splice", if (lineIndex != 0) { lineIndex } else { index }, 0, JS.array("exit", listItem, event[2]));
        index++;
        length++;
      }
      if (type == tListItemPrefix) {
        listItem = JS.object("type", "listItem", "_spread", false, "start", JS.invoke(Object, "assign", JS.object(), event[1]["start"]), "end", JS.undefined());
        JS.invoke(events, "splice", index, 0, JS.array("enter", listItem, event[2]));
        index++;
        length++;
        firstBlankLineIndex = 0;
        atMarker = true;
      }
    }
  }
  events[start][1]["_spread"] = listSpread;
  return length;
}

export JsValue fromMarkdown(JsValue value, JsValue encoding, JsValue options) {
  if (encoding.truthy() && JS.typeOf(encoding) == "object") {
    options = encoding;
    encoding = JS.undefined();
  }

  JsValue tree = JS.object("type", "root", "children", JS.array());
  JsValue[] stack = [tree];
  JsValue[] tokenStack = [];
  JsValue data = JS.object();
  // Assigned below; `onexitlineending` reads `config.canContainEols` live, as upstream does.
  JsValue config = JS.undefined();

  func()->JsValue top = () => stack[stack.length - 1];

  JsValue buffer = JS.method0((JsValue _self) => {
    stack.push(JS.object("type", "fragment", "children", JS.array()));
    return JS.undefined();
  });

  JsValue resume = JS.method0((JsValue _self) => toString(stack.pop()));

  JsValue enter = JS.method3((JsValue _self, JsValue node, JsValue token, JsValue errorHandler) => {
    JS.invoke(top()["children"], "push", node);
    stack.push(node);
    tokenStack.push(JS.array(token, JS.or(errorHandler, JS.undefined())));
    node["position"] = JS.object("start", point(token["start"]), "end", JS.undefined());
    return JS.undefined();
  });

  JsValue exit = JS.method2((JsValue self, JsValue token, JsValue onExitError) => {
    JsValue node = stack.pop();
    JsValue open = tokenStack.pop();
    if (!open.truthy()) {
      throw JS.construct(Error, "Cannot close `" + token["type"] + "` (" + stringifyPosition(token) + "): it’s not open");
    }
    if (open[0]["type"] != token["type"]) {
      if (onExitError.truthy()) {
        JS.call(onExitError, self, token, open[0]);
      } else {
        JS.call(JS.or(open[1], defaultOnError), self, token, open[0]);
      }
    }
    node["position"]["end"] = point(token["end"]);
    return JS.undefined();
  });

  func(func(JsValue)->JsValue, JsValue)->JsValue opener = (func(JsValue)->JsValue create, JsValue and) => JS.method1((JsValue _self, JsValue token) => {
    JS.call(enter, JS.undefined(), create(token), token);
    if (and.truthy()) {
      JS.call(and, JS.undefined(), token);
    }
    return JS.undefined();
  });

  func(JsValue)->JsValue closer = (JsValue and) => JS.method1((JsValue self, JsValue token) => {
    if (and.truthy()) {
      JS.call(and, JS.undefined(), token);
    }
    JS.call(exit, self, token);
    return JS.undefined();
  });

  // The handlers that only move the text of the node on top of the stack into a field of its parent.
  func(string)->JsValue resumeInto = (string field) => JS.method0((JsValue _self) => {
    JsValue value = JS.call(resume, JS.undefined());
    top()[field] = value;
    return JS.undefined();
  });

  JsValue onenterlistordered = JS.method0((JsValue _self) => {
    data["expectingFirstListItemValue"] = true;
    return JS.undefined();
  });

  JsValue onexitcodefencedfence = JS.method0((JsValue _self) => {
    if (!data["flowCodeInside"].truthy()) {
      JS.call(buffer, JS.undefined());
      data["flowCodeInside"] = true;
    }
    return JS.undefined();
  });

  JsValue onexitcodefenced = JS.method0((JsValue _self) => {
    JsValue value = JS.call(resume, JS.undefined());
    top()["value"] = JS.invoke(value, "replace", fenceEdges, "");
    data["flowCodeInside"] = JS.undefined();
    return JS.undefined();
  });

  JsValue onexitcodeindented = JS.method0((JsValue _self) => {
    JsValue value = JS.call(resume, JS.undefined());
    top()["value"] = JS.invoke(value, "replace", trailingBreak, "");
    return JS.undefined();
  });

  JsValue onexitdefinitionlabelstring = JS.method1((JsValue self, JsValue token) => {
    JsValue label = JS.call(resume, JS.undefined());
    JsValue node = top();
    node["label"] = label;
    node["identifier"] = normalizeIdentifier(slice(self, token)).toLowerCase();
    return JS.undefined();
  });

  JsValue onexitsetextheadingtext = JS.method0((JsValue _self) => {
    data["setextHeadingSlurpLineEnding"] = true;
    return JS.undefined();
  });

  JsValue onexitsetextheading = JS.method0((JsValue _self) => {
    data["setextHeadingSlurpLineEnding"] = JS.undefined();
    return JS.undefined();
  });

  JsValue onenterdata = JS.method1((JsValue _self, JsValue token) => {
    JsValue siblings = top()["children"];
    JsValue tail = siblings[siblings.length - 1];
    if (!tail.truthy() || tail["type"] != "text") {
      tail = JS.object("type", "text", "value", "", "position", JS.object("start", point(token["start"]), "end", JS.undefined()));
      JS.invoke(siblings, "push", tail);
    }
    stack.push(tail);
    return JS.undefined();
  });

  JsValue onexitdata = JS.method1((JsValue self, JsValue token) => {
    JsValue tail = stack.pop();
    tail["value"] = JS.add(tail["value"], slice(self, token));
    tail["position"]["end"] = point(token["end"]);
    return JS.undefined();
  });

  JsValue onexithardbreak = JS.method0((JsValue _self) => {
    data["atHardBreak"] = true;
    return JS.undefined();
  });

  // onexitlink and onexitimage: the same body upstream.
  JsValue onexitmedia = JS.method0((JsValue _self) => {
    JsValue node = top();
    if (data["inReference"].truthy()) {
      JsValue referenceType = JS.or(data["referenceType"], "shortcut");
      node["type"] = JS.add(node["type"], "Reference");
      node["referenceType"] = referenceType;
      JS.delete(node, "url");
      JS.delete(node, "title");
    } else {
      JS.delete(node, "identifier");
      JS.delete(node, "label");
    }
    data["referenceType"] = JS.undefined();
    return JS.undefined();
  });

  JsValue onexitlabel = JS.method0((JsValue _self) => {
    JsValue fragment = top();
    JsValue value = JS.call(resume, JS.undefined());
    JsValue node = top();
    data["inReference"] = true;
    if (node["type"] == "link") {
      node["children"] = fragment["children"];
    } else {
      node["alt"] = value;
    }
    return JS.undefined();
  });

  JsValue onexitresource = JS.method0((JsValue _self) => {
    data["inReference"] = JS.undefined();
    return JS.undefined();
  });

  JsValue onenterreference = JS.method0((JsValue _self) => {
    data["referenceType"] = "collapsed";
    return JS.undefined();
  });

  JsValue onexitreferencestring = JS.method1((JsValue self, JsValue token) => {
    JS.call(onexitdefinitionlabelstring, self, token);
    data["referenceType"] = "full";
    return JS.undefined();
  });

  JsValue onexitcharacterreferencemarker = JS.method1((JsValue _self, JsValue token) => {
    data["characterReferenceType"] = token["type"];
    return JS.undefined();
  });

  JsValue onexitcharacterreference = JS.method1((JsValue _self, JsValue token) => {
    stack.pop()["position"]["end"] = point(token["end"]);
    return JS.undefined();
  });

  // onexitautolinkprotocol and onexitautolinkemail: the URL is the slice, after a `mailto:` for an email.
  func(string)->JsValue autolinkUrl = (string prefix) => JS.method1((JsValue self, JsValue token) => {
    JS.call(onexitdata, self, token);
    top()["url"] = prefix + slice(self, token);
    return JS.undefined();
  });

  func(JsValue)->JsValue codeFlow = (JsValue _token) => JS.object("type", "code", "lang", null, "meta", null, "value", "");
  func(JsValue)->JsValue hardBreak = (JsValue _token) => JS.object("type", "break");
  func(JsValue)->JsValue heading = (JsValue _token) => JS.object("type", "heading", "depth", 0, "children", JS.array());
  func(JsValue)->JsValue html = (JsValue _token) => JS.object("type", "html", "value", "");
  func(JsValue)->JsValue link = (JsValue _token) => JS.object("type", "link", "title", null, "url", "", "children", JS.array());
  func(JsValue)->JsValue list = (JsValue token) => JS.object("type", "list", "ordered", token["type"] == "listOrdered", "start", null, "spread", token["_spread"], "children", JS.array());

  JsValue transforms = JS.array();
  JsValue eols = JS.array("emphasis", "fragment", "heading", "paragraph", "strong");
  JsValue enterMap = JS.object(
      "autolink", opener(link, JS.undefined()),
      "autolinkProtocol", onenterdata,
      "autolinkEmail", onenterdata,
      "atxHeading", opener(heading, JS.undefined()),
      "blockQuote", opener((JsValue _token) => JS.object("type", "blockquote", "children", JS.array()), JS.undefined()),
      "characterEscape", onenterdata,
      "characterReference", onenterdata,
      "codeFenced", opener(codeFlow, JS.undefined()),
      "codeFencedFenceInfo", buffer,
      "codeFencedFenceMeta", buffer,
      "codeIndented", opener(codeFlow, buffer),
      "codeText", opener((JsValue _token) => JS.object("type", "inlineCode", "value", ""), buffer),
      "codeTextData", onenterdata,
      "data", onenterdata,
      "codeFlowValue", onenterdata,
      "definition", opener((JsValue _token) => JS.object("type", "definition", "identifier", "", "label", null, "title", null, "url", ""), JS.undefined()),
      "definitionDestinationString", buffer,
      "definitionLabelString", buffer,
      "definitionTitleString", buffer,
      "emphasis", opener((JsValue _token) => JS.object("type", "emphasis", "children", JS.array()), JS.undefined()),
      "hardBreakEscape", opener(hardBreak, JS.undefined()),
      "hardBreakTrailing", opener(hardBreak, JS.undefined()),
      "htmlFlow", opener(html, buffer),
      "htmlFlowData", onenterdata,
      "htmlText", opener(html, buffer),
      "htmlTextData", onenterdata,
      "image", opener((JsValue _token) => JS.object("type", "image", "title", null, "url", "", "alt", null), JS.undefined()),
      "label", buffer,
      "link", opener(link, JS.undefined()),
      "listItem", opener((JsValue token) => JS.object("type", "listItem", "spread", token["_spread"], "checked", null, "children", JS.array()), JS.undefined()),
      "listItemValue", JS.method1((JsValue self, JsValue token) => {
        if (data["expectingFirstListItemValue"].truthy()) {
          stack[stack.length - 2]["start"] = JS.invoke(Number, "parseInt", slice(self, token), 10);
          data["expectingFirstListItemValue"] = JS.undefined();
        }
        return JS.undefined();
      }),
      "listOrdered", opener(list, onenterlistordered),
      "listUnordered", opener(list, JS.undefined()),
      "paragraph", opener((JsValue _token) => JS.object("type", "paragraph", "children", JS.array()), JS.undefined()),
      "reference", onenterreference,
      "referenceString", buffer,
      "resourceDestinationString", buffer,
      "resourceTitleString", buffer,
      "setextHeading", opener(heading, JS.undefined()),
      "strong", opener((JsValue _token) => JS.object("type", "strong", "children", JS.array()), JS.undefined()),
      "thematicBreak", opener((JsValue _token) => JS.object("type", "thematicBreak"), JS.undefined())
    );
  JsValue exitMap = JS.object(
      "atxHeading", closer(JS.undefined()),
      "atxHeadingSequence", JS.method1((JsValue self, JsValue token) => {
        JsValue node = top();
        if (!node["depth"].truthy()) {
          node["depth"] = slice(self, token).length;
        }
        return JS.undefined();
      }),
      "autolink", closer(JS.undefined()),
      "autolinkEmail", autolinkUrl("mailto:"),
      "autolinkProtocol", autolinkUrl(""),
      "blockQuote", closer(JS.undefined()),
      "characterEscapeValue", onexitdata,
      "characterReferenceMarkerHexadecimal", onexitcharacterreferencemarker,
      "characterReferenceMarkerNumeric", onexitcharacterreferencemarker,
      "characterReferenceValue", JS.method1((JsValue self, JsValue token) => {
        string text = slice(self, token);
        JsValue type = data["characterReferenceType"];
        JsValue value = JS.undefined();
        if (type.truthy()) {
          value = decodeNumericCharacterReference(text, if (type == tCharacterReferenceMarkerNumeric) { 10 } else { 16 });
          data["characterReferenceType"] = JS.undefined();
        } else {
          value = decodeNamedCharacterReference(text);
        }
        JsValue tail = top();
        tail["value"] = JS.add(tail["value"], value);
        return JS.undefined();
      }),
      "characterReference", onexitcharacterreference,
      "codeFenced", closer(onexitcodefenced),
      "codeFencedFence", onexitcodefencedfence,
      "codeFencedFenceInfo", resumeInto("lang"),
      "codeFencedFenceMeta", resumeInto("meta"),
      "codeFlowValue", onexitdata,
      "codeIndented", closer(onexitcodeindented),
      "codeText", closer(resumeInto("value")),
      "codeTextData", onexitdata,
      "data", onexitdata,
      "definition", closer(JS.undefined()),
      "definitionDestinationString", resumeInto("url"),
      "definitionLabelString", onexitdefinitionlabelstring,
      "definitionTitleString", resumeInto("title"),
      "emphasis", closer(JS.undefined()),
      "hardBreakEscape", closer(onexithardbreak),
      "hardBreakTrailing", closer(onexithardbreak),
      "htmlFlow", closer(resumeInto("value")),
      "htmlFlowData", onexitdata,
      "htmlText", closer(resumeInto("value")),
      "htmlTextData", onexitdata,
      "image", closer(onexitmedia),
      "label", onexitlabel,
      "labelText", JS.method1((JsValue self, JsValue token) => {
        string text = slice(self, token);
        JsValue ancestor = stack[stack.length - 2];
        ancestor["label"] = decodeString(text);
        ancestor["identifier"] = normalizeIdentifier(text).toLowerCase();
        return JS.undefined();
      }),
      "lineEnding", JS.method1((JsValue self, JsValue token) => {
        JsValue context = top();
        if (data["atHardBreak"].truthy()) {
          JsValue children = context["children"];
          children[children.length - 1]["position"]["end"] = point(token["end"]);
          data["atHardBreak"] = JS.undefined();
          return JS.undefined();
        }
        if (!data["setextHeadingSlurpLineEnding"].truthy() && JS.invoke(config["canContainEols"], "includes", context["type"]).truthy()) {
          JS.call(onenterdata, JS.undefined(), token);
          JS.call(onexitdata, self, token);
        }
        return JS.undefined();
      }),
      "link", closer(onexitmedia),
      "listItem", closer(JS.undefined()),
      "listOrdered", closer(JS.undefined()),
      "listUnordered", closer(JS.undefined()),
      "paragraph", closer(JS.undefined()),
      "referenceString", onexitreferencestring,
      "resourceDestinationString", resumeInto("url"),
      "resourceTitleString", resumeInto("title"),
      "resource", onexitresource,
      "setextHeading", closer(onexitsetextheading),
      "setextHeadingLineSequence", JS.method1((JsValue self, JsValue token) => {
        top()["depth"] = if (JS.strictEqual(JS.invoke(slice(self, token), "codePointAt", 0), 61)) { 1 } else { 2 };
        return JS.undefined();
      }),
      "setextHeadingText", onexitsetextheadingtext,
      "strong", closer(JS.undefined()),
      "thematicBreak", closer(JS.undefined())
    );
  config = JS.object("transforms", transforms, "canContainEols", eols, "enter", enterMap, "exit", exitMap);
  configure(config, JS.or(JS.or(options, JS.object())["mdastExtensions"], JS.array()));

  Parser parser = JS.assume(parse(options));
  JsValue events = postprocess(parser.document().write(JS.call(preprocess(), JS.undefined(), value, encoding, true)));

  JsValue context = JS.object("stack", stack, "tokenStack", tokenStack, "config", config, "enter", enter, "exit", exit, "buffer", buffer, "resume", resume, "data", data);
  float[] listStack = [];
  for (float index = 0; index < events.length; index++) {
    JsValue type = events[index][1]["type"];
    if (type == tListOrdered || type == tListUnordered) {
      if (events[index][0] == "enter") {
        listStack.push(index);
      } else {
        index = prepareList(events, listStack.pop(), index);
      }
    }
  }

  for (float index = 0; index < events.length; index++) {
    JsValue event = events[index];
    JsValue handler = config[event[0]];
    if (hasOwn(handler, event[1]["type"])) {
      JS.call(handler[event[1]["type"]], JS.invoke(Object, "assign", JS.object("sliceSerialize", event[2]["sliceSerialize"]), context), event[1]);
    }
  }

  if (tokenStack.length > 0) {
    JsValue tail = tokenStack[tokenStack.length - 1];
    JS.call(JS.or(tail[1], defaultOnError), context, JS.undefined(), tail[0]);
  }

  JsValue start = JS.object("line", 1, "column", 1, "offset", 0);
  JsValue end = start;
  if (events.length > 0) {
    start = events[0][1]["start"];
    end = events[events.length - 2][1]["end"];
  }
  tree["position"] = JS.object("start", point(start), "end", point(end));

  JsValue transformList = config["transforms"];
  for (float index = 0; index < transformList.length; index++) {
    tree = JS.or(JS.call(transformList[index], transformList, tree), tree);
  }
  return tree;
}
