export extern class ParseOptions {
  JsValue gfm;
  JsValue breaks;
  JsValue math;
  JsValue allowDangerousHtml;
  JsValue singleTilde;
}

export class Opts {
  bool gfm;
  bool breaks;
  bool math;
  bool allowDangerousHtml;
  bool singleTilde;

  init() {
    this.gfm = false;
    this.breaks = false;
    this.math = false;
    this.allowDangerousHtml = false;
    this.singleTilde = false;
  }
}

export class DefRec {
  string identifier;
  string label;
  string url;
  string title;

  init() {
    this.identifier = "";
    this.label = "";
    this.url = "";
    this.title = "";
  }
}

export bool flagOf(JsValue value, bool fallback) {
  if (JS.isUndefined(value) || JS.isNullish(value)) {
    return fallback;
  }
  return value.truthy();
}

export string readText(JsValue value) {
  if (JS.isUndefined(value) || JS.isNullish(value)) {
    return "";
  }
  return JS.string(value);
}

export Opts readOpts(JsValue raw) {
  Opts opt = new Opts();
  if (JS.isUndefined(raw) || JS.isNullish(raw) || raw is string) {
    return opt;
  }
  ParseOptions parsed = JS.assume(raw);
  opt.gfm = flagOf(parsed.gfm, false);
  opt.breaks = flagOf(parsed.breaks, false);
  opt.math = flagOf(parsed.math, false);
  opt.allowDangerousHtml = flagOf(parsed.allowDangerousHtml, false);
  opt.singleTilde = flagOf(parsed.singleTilde, false);
  return opt;
}

export JsValue pickOptions(JsValue args) {
  int n = JS.number(args["length"]).toInt();
  if (n >= 3) {
    return args[2];
  }
  if (n >= 2) {
    JsValue second = args[1];
    if (!(second is string)) {
      return second;
    }
  }
  return JS.undefined();
}
