import { TokenizerToken, copyPoint, isEof } from "../host.lil";

extern JsValue Object;

JsValue resolveAllLineSuffixes = JS.method2((JsValue _self, JsValue events, JsValue context) => {
  for (float eventIndex = 1.0; eventIndex <= events.length; eventIndex++) {
    if (
      (eventIndex == events.length || JS.strictEqual(JS.get(events[eventIndex][1], "type"), "lineEnding")) &&
      JS.strictEqual(JS.get(events[eventIndex - 1.0][1], "type"), "data")
    ) {
      TokenizerToken data = JS.assume(events[eventIndex - 1.0][1]);
      JsValue chunks = JS.invoke(context, "sliceStream", data);
      float index = chunks.length;
      float bufferIndex = -1.0;
      float size = 0.0;
      bool tabs = false;
      while (true) {
        index--;
        if (index < 0.0) {
          break;
        }
        JsValue chunk = chunks[index];
        if (JS.typeOf(chunk) == "string") {
          bufferIndex = chunk.length;
          while (JS.strictEqual(JS.invoke(chunk, "charCodeAt", bufferIndex - 1.0), 32)) {
            size++;
            bufferIndex--;
          }
          if (bufferIndex != 0.0) {
            break;
          }
          bufferIndex = -1.0;
        } else if (JS.strictEqual(chunk, -2)) {
          tabs = true;
          size++;
        } else if (!JS.strictEqual(chunk, -1)) {
          index++;
          break;
        }
      }
      if (JS.get(context, "_contentTypeTextTrailing").truthy() && eventIndex == events.length) {
        size = 0.0;
      }
      if (size != 0.0) {
        JsValue token = JS.object(
          "type", if (eventIndex == events.length || tabs || size < 2.0) { "lineSuffix" } else { "hardBreakTrailing" },
          "start", JS.object(
            "_bufferIndex", if (index != 0.0) { bufferIndex } else { data.start._bufferIndex + bufferIndex },
            "_index", data.start._index + index,
            "line", data.end.line,
            "column", data.end.column - size,
            "offset", data.end.offset - size
          ),
          "end", copyPoint(data.end)
        );
        JS.set(data, "end", copyPoint(JS.get(token, "start")));
        if (data.start.offset == data.end.offset) {
          JS.call(JS.get(Object, "assign"), Object, data, token);
        } else {
          JS.invoke(events, "splice", eventIndex, 0, JS.array("enter", token, context), JS.array("exit", token, context));
          eventIndex = eventIndex + 2.0;
        }
      }
      eventIndex++;
    }
  }
  return events;
});

JsValue createResolver(JsValue extraResolver) {
  return JS.method2((JsValue _self, JsValue events, JsValue context) => {
    float enter = -1.0;
    for (float index = 0.0; index <= events.length; index++) {
      if (enter < 0.0) {
        if (JS.and(events[index], JS.strictEqual(JS.get(events[index][1], "type"), "data")).truthy()) {
          enter = index;
          index++;
        }
      } else if (!JS.and(events[index], JS.strictEqual(JS.get(events[index][1], "type"), "data")).truthy()) {
        if (index != enter + 2.0) {
          JS.set(events[enter][1], "end", JS.get(events[index - 1.0][1], "end"));
          JS.invoke(events, "splice", enter + 2.0, index - enter - 2.0);
          index = enter + 2.0;
        }
        enter = -1.0;
      }
    }
    if (extraResolver.truthy()) {
      return JS.call(extraResolver, JS.undefined(), events, context);
    }
    return events;
  });
}

JsValue initializeFactory(string field, JsValue extraResolver) {
  return JS.object(
    "resolveAll", createResolver(extraResolver),
    "tokenize", JS.method1((JsValue self, JsValue effects) => {
      JsValue constructs = JS.get(JS.get(JS.get(self, "parser"), "constructs"), field);
      JsValue text = JS.undefined();

      func(JsValue)->bool atBreak = (JsValue code) => {
        if (isEof(code)) {
          return true;
        }
        JsValue list = constructs[code];
        if (list.truthy()) {
          for (float index = 0.0; index < list.length; index++) {
            JsValue previous = JS.get(list[index], "previous");
            if (!previous.truthy() || JS.call(previous, self, JS.get(self, "previous")).truthy()) {
              return true;
            }
          }
        }
        return false;
      };

      JsValue notText = JS.undefined();
      JsValue data = JS.method1((JsValue _s, JsValue code) => {
        if (atBreak(code)) {
          JS.invoke(effects, "exit", "data");
          return JS.call(text, JS.undefined(), code);
        }
        JS.invoke(effects, "consume", code);
        return data;
      });
      notText = JS.method1((JsValue _s, JsValue code) => {
        if (isEof(code)) {
          JS.invoke(effects, "consume", code);
          return JS.undefined();
        }
        JS.invoke(effects, "enter", "data");
        JS.invoke(effects, "consume", code);
        return data;
      });
      JsValue start = JS.method1((JsValue _s, JsValue code) => {
        return JS.call(if (atBreak(code)) { text } else { notText }, JS.undefined(), code);
      });
      text = JS.invoke(effects, "attempt", constructs, start, notText);
      return start;
    })
  );
}

export JsValue resolver = JS.object("resolveAll", createResolver(JS.undefined()));

export JsValue stringConstruct = initializeFactory("string", JS.undefined());
export JsValue textConstruct = initializeFactory("text", resolveAllLineSuffixes);
