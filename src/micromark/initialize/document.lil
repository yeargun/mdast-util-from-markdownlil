import {
  arrLen,
  call0,
  call1,
  call2,
  call3,
  copyPoint,
  includesStr,
  isEof,
  isFn,
  jsInt,
  objGet,
  objGetVal,
  objSetVal,
  push,
  slice1,
  undef
} from "../host.lil";
import { factorySpace } from "../factory-space.lil";
import { markdownLineEnding } from "../util-character.lil";
import { splice } from "../util-chunked.lil";
import { codes } from "../symbol/codes.lil";
import { kContentTypeFlow, kTabSize } from "../symbol/constants.lil";
import { tChunkFlow, tLinePrefix } from "../symbol/types.lil";

JsValue tokenizeContainer = JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
  JsValue disable = objGet(objGet(objGet(self, "parser"), "constructs"), "disable")["null"];
  JsValue max = undef();
  if (!includesStr(disable, "codeIndented")) {
    max = kTabSize;
  }
  return factorySpace(
    effects,
    call3(objGet(effects, "attempt"), effects, objGet(objGet(self, "parser"), "constructs")["document"], ok, nok),
    tLinePrefix,
    max
  );
});

JsValue containerConstruct = JS.object();
JS.set(containerConstruct, "tokenize", tokenizeContainer);

void exitContainers(JsValue self, JsValue effects, JsValue stack, int size) {
  int index = arrLen(stack);
  while (index > size) {
    index = index - 1;
    JsValue entry = stack[index];
    JS.set(self, "containerState", entry[1]);
    call1(objGet(entry[0], "exit"), self, effects);
  }
  JS.set(stack, "length", size);
}

void closeFlow(JsValue self, JsValue st) {
  JsValue childFlow = objGet(st, "childFlow");
  if (childFlow.truthy()) {
    JsValue eofSlice = JS.array();
    push(eofSlice, objGet(codes, "eof"));
    call1(objGet(childFlow, "write"), childFlow, eofSlice);
  }
  JS.set(st, "childToken", undef());
  JS.set(st, "childFlow", undef());
  JS.set(objGet(self, "containerState"), "_closeFlow", undef());
}

void writeToChild(JsValue self, JsValue st, JsValue token, JsValue endOfFile) {
  JsValue childFlow = objGet(st, "childFlow");
  JsValue stream = call1(objGet(self, "sliceStream"), self, token);
  if (endOfFile.truthy()) {
    push(stream, objGet(codes, "eof"));
  }
  JS.set(token, "previous", objGet(st, "childToken"));
  if (objGet(st, "childToken").truthy()) {
    JS.set(objGet(st, "childToken"), "next", token);
  }
  JS.set(st, "childToken", token);
  call1(objGet(childFlow, "defineSkip"), childFlow, objGet(token, "start"));
  call1(objGet(childFlow, "write"), childFlow, stream);
  if (objGet(objGet(self, "parser"), "lazy")[objGet(objGet(token, "start"), "line")].truthy()) {
    int index = arrLen(objGet(childFlow, "events"));
    float lineStartOffset = JS.number(objGet(st, "lineStartOffset"));
    while (true) {
      index = index - 1;
      if (index < 0) {
        break;
      }
      JsValue evTok = objGet(childFlow, "events")[index][1];
      if (JS.number(objGet(objGet(evTok, "start"), "offset")) < lineStartOffset && (!objGet(evTok, "end").truthy() || JS.number(objGet(objGet(evTok, "end"), "offset")) > lineStartOffset)) {
        return;
      }
    }
    int indexBeforeExits = arrLen(objGet(self, "events"));
    int indexBeforeFlow = indexBeforeExits;
    bool seen = false;
    JsValue point = undef();
    while (true) {
      indexBeforeFlow = indexBeforeFlow - 1;
      if (indexBeforeFlow < 0) {
        break;
      }
      JsValue ev = objGet(self, "events")[indexBeforeFlow];
      if (ev[0] == "exit" && objGet(ev[1], "type") == tChunkFlow) {
        if (seen) {
          point = objGet(ev[1], "end");
          break;
        }
        seen = true;
      }
    }
    exitContainers(self, objGet(st, "effects"), objGet(st, "stack"), jsInt(objGet(st, "continued")));
    int fix = indexBeforeExits;
    while (fix < arrLen(objGet(self, "events"))) {
      JS.set(objGet(self, "events")[fix][1], "end", copyPoint(point));
      fix = fix + 1;
    }
    splice(objGet(self, "events"), indexBeforeFlow + 1, 0, slice1(objGet(self, "events"), indexBeforeExits));
    JS.set(objGet(self, "events"), "length", fix);
  }
}

JsValue initializeDocument = JS.method1((JsValue self, JsValue effects) => {
  JsValue st = JS.object();
  JS.set(st, "stack", JS.array());
  JS.set(st, "continued", 0);
  JS.set(st, "effects", effects);
  JS.set(st, "childFlow", undef());
  JS.set(st, "childToken", undef());

  JsValue flowContinue = JS.method1((JsValue _s, JsValue code) => {
    if (isEof(code)) {
      writeToChild(self, st, call1(objGet(effects, "exit"), effects, tChunkFlow), true);
      exitContainers(self, effects, objGet(st, "stack"), 0);
      call1(objGet(effects, "consume"), effects, code);
      return undef();
    }
    if (markdownLineEnding(code)) {
      call1(objGet(effects, "consume"), effects, code);
      writeToChild(self, st, call1(objGet(effects, "exit"), effects, tChunkFlow), undef());
      JS.set(st, "continued", 0);
      JS.set(self, "interrupt", undef());
      return objGet(st, "start");
    }
    call1(objGet(effects, "consume"), effects, code);
    return flowContinue;
  });

  JsValue flowStart = JS.method1((JsValue _s, JsValue code) => {
    if (isEof(code)) {
      if (objGet(st, "childFlow").truthy()) {
        closeFlow(self, st);
      }
      exitContainers(self, effects, objGet(st, "stack"), 0);
      call1(objGet(effects, "consume"), effects, code);
      return undef();
    }
    if (!objGet(st, "childFlow").truthy()) {
      JS.set(st, "childFlow", call1(objGet(objGet(self, "parser"), "flow"), objGet(self, "parser"), call0(objGet(self, "now"), self)));
    }
    JsValue fields = JS.object();
    JS.set(fields, "_tokenizer", objGet(st, "childFlow"));
    JS.set(fields, "contentType", kContentTypeFlow);
    JS.set(fields, "previous", objGet(st, "childToken"));
    call2(objGet(effects, "enter"), effects, tChunkFlow, fields);
    return call1(flowContinue, JS.undefined(), code);
  });

  JsValue containerContinue = JS.method1((JsValue _s, JsValue code) => {
    JS.set(st, "continued", jsInt(objGet(st, "continued")) + 1);
    JsValue item = JS.array();
    push(item, objGet(self, "currentConstruct"));
    push(item, objGet(self, "containerState"));
    push(objGet(st, "stack"), item);
    return call1(objGet(st, "documentContinued"), JS.undefined(), code);
  });

  JsValue documentContinued = JS.method1((JsValue _s, JsValue code) => {
    JS.set(self, "containerState", JS.object());
    return call1(call3(objGet(effects, "attempt"), effects, containerConstruct, containerContinue, flowStart), JS.undefined(), code);
  });

  JsValue thereIsNoNewContainer = JS.method1((JsValue _s, JsValue code) => {
    objSetVal(objGet(objGet(self, "parser"), "lazy"), objGet(call0(objGet(self, "now"), self), "line"), jsInt(objGet(st, "continued")) != arrLen(objGet(st, "stack")));
    JS.set(st, "lineStartOffset", objGet(call0(objGet(self, "now"), self), "offset"));
    return call1(flowStart, JS.undefined(), code);
  });

  JsValue thereIsANewContainer = JS.method1((JsValue _s, JsValue code) => {
    if (objGet(st, "childFlow").truthy()) {
      closeFlow(self, st);
    }
    exitContainers(self, effects, objGet(st, "stack"), jsInt(objGet(st, "continued")));
    return call1(documentContinued, JS.undefined(), code);
  });

  JsValue checkNewContainers = JS.method1((JsValue _s, JsValue code) => {
    if (jsInt(objGet(st, "continued")) == arrLen(objGet(st, "stack"))) {
      if (!objGet(st, "childFlow").truthy()) {
        return call1(documentContinued, JS.undefined(), code);
      }
      JsValue current = objGet(objGet(st, "childFlow"), "currentConstruct");
      if (current.truthy() && objGet(current, "concrete").truthy()) {
        return call1(flowStart, JS.undefined(), code);
      }
      JS.set(self, "interrupt", current.truthy() && !objGet(objGet(st, "childFlow"), "_gfmTableDynamicInterruptHack").truthy());
    }
    JS.set(self, "containerState", JS.object());
    return call1(call3(objGet(effects, "check"), effects, containerConstruct, thereIsANewContainer, thereIsNoNewContainer), JS.undefined(), code);
  });

  JsValue documentContinue = JS.method1((JsValue _s, JsValue code) => {
    JS.set(st, "continued", jsInt(objGet(st, "continued")) + 1);
    if (objGet(objGet(self, "containerState"), "_closeFlow").truthy()) {
      JS.set(objGet(self, "containerState"), "_closeFlow", undef());
      if (objGet(st, "childFlow").truthy()) {
        closeFlow(self, st);
      }
      int indexBeforeExits = arrLen(objGet(self, "events"));
      int indexBeforeFlow = indexBeforeExits;
      JsValue point = undef();
      while (true) {
        indexBeforeFlow = indexBeforeFlow - 1;
        if (indexBeforeFlow < 0) {
          break;
        }
        JsValue ev = objGet(self, "events")[indexBeforeFlow];
        if (ev[0] == "exit" && objGet(ev[1], "type") == tChunkFlow) {
          point = objGet(ev[1], "end");
          break;
        }
      }
      exitContainers(self, effects, objGet(st, "stack"), jsInt(objGet(st, "continued")));
      int fix = indexBeforeExits;
      while (fix < arrLen(objGet(self, "events"))) {
        JS.set(objGet(self, "events")[fix][1], "end", copyPoint(point));
        fix = fix + 1;
      }
      splice(objGet(self, "events"), indexBeforeFlow + 1, 0, slice1(objGet(self, "events"), indexBeforeExits));
      JS.set(objGet(self, "events"), "length", fix);
      return call1(checkNewContainers, JS.undefined(), code);
    }
    return call1(objGet(st, "start"), JS.undefined(), code);
  });

  JsValue start = JS.method1((JsValue _s, JsValue code) => {
    if (jsInt(objGet(st, "continued")) < arrLen(objGet(st, "stack"))) {
      JsValue item = objGet(st, "stack")[jsInt(objGet(st, "continued"))];
      JS.set(self, "containerState", item[1]);
      return call1(call3(objGet(effects, "attempt"), effects, objGet(item[0], "continuation"), documentContinue, checkNewContainers), JS.undefined(), code);
    }
    return call1(checkNewContainers, JS.undefined(), code);
  });

  JS.set(st, "start", start);
  JS.set(st, "documentContinued", documentContinued);
  return start;
});

export JsValue documentConstruct = JS.object();
JS.set(documentConstruct, "tokenize", initializeDocument);
