import { copyPoint, isEof } from "../host.lil";
import { factorySpace } from "../factory-space.lil";
import { markdownLineEnding } from "../util-character.lil";
import { splice } from "../util-chunked.lil";

JsValue containerConstruct = JS.object("tokenize", JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
  JsValue constructs = JS.get(JS.get(self, "parser"), "constructs");
  return factorySpace(
    effects,
    JS.invoke(effects, "attempt", JS.get(constructs, "document"), ok, nok),
    "linePrefix",
    if (JS.invoke(JS.get(JS.get(constructs, "disable"), "null"), "includes", "codeIndented").truthy()) { 0.0 } else { 4.0 }
  );
}));

// After a container closes (or a lazy line turns out not to continue it), move the exits of the closed
// containers to just after the last flow chunk, ending them where that chunk ended.
void moveExits(JsValue events, float indexBeforeExits, float indexBeforeFlow, JsValue point) {
  float index = indexBeforeExits;
  while (index < events.length) {
    JS.set(events[index][1], "end", copyPoint(point));
    index++;
  }
  splice(events, indexBeforeFlow + 1.0, 0, JS.invoke(events, "slice", indexBeforeExits));
  JS.set(events, "length", index);
}

export JsValue documentConstruct = JS.object("tokenize", JS.method1((JsValue self, JsValue effects) => {
  JsValue stack = JS.array();
  float continued = 0.0;
  JsValue childFlow = JS.undefined();
  JsValue childToken = JS.undefined();
  JsValue lineStartOffset = JS.undefined();
  JsValue start = JS.undefined();
  JsValue checkNewContainers = JS.undefined();
  JsValue documentContinued = JS.undefined();
  JsValue flowStart = JS.undefined();

  func(float)->void exitContainers = (float size) => {
    float index = stack.length;
    while (index > size) {
      index--;
      JsValue entry = stack[index];
      JS.set(self, "containerState", entry[1]);
      JS.call(JS.get(entry[0], "exit"), self, effects);
    }
    JS.set(stack, "length", size);
  };

  func()->void closeFlow = () => {
    JS.invoke(childFlow, "write", JS.array(null));
    childToken = JS.undefined();
    childFlow = JS.undefined();
    JS.set(JS.get(self, "containerState"), "_closeFlow", JS.undefined());
  };

  func(JsValue, bool)->void writeToChild = (JsValue token, bool endOfFile) => {
    JsValue stream = JS.invoke(self, "sliceStream", token);
    if (endOfFile) {
      JS.invoke(stream, "push", null);
    }
    JS.set(token, "previous", childToken);
    if (childToken.truthy()) {
      JS.set(childToken, "next", token);
    }
    childToken = token;
    JS.invoke(childFlow, "defineSkip", JS.get(token, "start"));
    JS.invoke(childFlow, "write", stream);
    if (JS.get(JS.get(self, "parser"), "lazy")[JS.get(JS.get(token, "start"), "line")].truthy()) {
      JsValue childEvents = JS.get(childFlow, "events");
      float index = childEvents.length;
      while (index > 0.0) {
        index--;
        JsValue child = childEvents[index][1];
        JsValue end = JS.get(child, "end");
        if (JS.lessThan(JS.get(JS.get(child, "start"), "offset"), lineStartOffset) && (!end.truthy() || JS.greaterThan(JS.get(end, "offset"), lineStartOffset))) {
          return;
        }
      }
      JsValue events = JS.get(self, "events");
      float indexBeforeExits = events.length;
      float indexBeforeFlow = indexBeforeExits;
      bool seen = false;
      JsValue point = JS.undefined();
      while (true) {
        indexBeforeFlow--;
        if (indexBeforeFlow < 0.0) {
          break;
        }
        JsValue event = events[indexBeforeFlow];
        if (JS.strictEqual(event[0], "exit") && JS.strictEqual(JS.get(event[1], "type"), "chunkFlow")) {
          if (seen) {
            point = JS.get(event[1], "end");
            break;
          }
          seen = true;
        }
      }
      exitContainers(continued);
      moveExits(JS.get(self, "events"), indexBeforeExits, indexBeforeFlow, point);
    }
  };

  JsValue flowContinue = JS.method1((JsValue _s, JsValue code) => {
    if (isEof(code)) {
      writeToChild(JS.invoke(effects, "exit", "chunkFlow"), true);
      exitContainers(0.0);
      JS.invoke(effects, "consume", code);
      return JS.undefined();
    }
    if (markdownLineEnding(code)) {
      JS.invoke(effects, "consume", code);
      writeToChild(JS.invoke(effects, "exit", "chunkFlow"), false);
      continued = 0.0;
      JS.set(self, "interrupt", JS.undefined());
      return start;
    }
    JS.invoke(effects, "consume", code);
    return flowContinue;
  });

  flowStart = JS.method1((JsValue _s, JsValue code) => {
    if (isEof(code)) {
      if (childFlow.truthy()) {
        closeFlow();
      }
      exitContainers(0.0);
      JS.invoke(effects, "consume", code);
      return JS.undefined();
    }
    childFlow = JS.or(childFlow, JS.invoke(JS.get(self, "parser"), "flow", JS.invoke(self, "now")));
    JS.invoke(effects, "enter", "chunkFlow", JS.object("_tokenizer", childFlow, "contentType", "flow", "previous", childToken));
    return JS.call(flowContinue, JS.undefined(), code);
  });

  JsValue containerContinue = JS.method1((JsValue _s, JsValue code) => {
    continued++;
    JS.invoke(stack, "push", JS.array(JS.get(self, "currentConstruct"), JS.get(self, "containerState")));
    return JS.call(documentContinued, JS.undefined(), code);
  });

  documentContinued = JS.method1((JsValue _s, JsValue code) => {
    JS.set(self, "containerState", JS.object());
    return JS.call(JS.invoke(effects, "attempt", containerConstruct, containerContinue, flowStart), JS.undefined(), code);
  });

  JsValue thereIsANewContainer = JS.method1((JsValue _s, JsValue code) => {
    if (childFlow.truthy()) {
      closeFlow();
    }
    exitContainers(continued);
    return JS.call(documentContinued, JS.undefined(), code);
  });

  JsValue thereIsNoNewContainer = JS.method1((JsValue _s, JsValue code) => {
    JS.get(JS.get(self, "parser"), "lazy")[JS.get(JS.invoke(self, "now"), "line")] = continued != stack.length;
    lineStartOffset = JS.get(JS.invoke(self, "now"), "offset");
    return JS.call(flowStart, JS.undefined(), code);
  });

  checkNewContainers = JS.method1((JsValue _s, JsValue code) => {
    if (continued == stack.length) {
      if (!childFlow.truthy()) {
        return JS.call(documentContinued, JS.undefined(), code);
      }
      JsValue current = JS.get(childFlow, "currentConstruct");
      if (JS.and(current, JS.get(current, "concrete")).truthy()) {
        return JS.call(flowStart, JS.undefined(), code);
      }
      JS.set(self, "interrupt", current.truthy() && !JS.get(childFlow, "_gfmTableDynamicInterruptHack").truthy());
    }
    JS.set(self, "containerState", JS.object());
    return JS.call(JS.invoke(effects, "check", containerConstruct, thereIsANewContainer, thereIsNoNewContainer), JS.undefined(), code);
  });

  JsValue documentContinue = JS.method1((JsValue _s, JsValue code) => {
    continued++;
    JsValue containerState = JS.get(self, "containerState");
    if (JS.get(containerState, "_closeFlow").truthy()) {
      JS.set(containerState, "_closeFlow", JS.undefined());
      if (childFlow.truthy()) {
        closeFlow();
      }
      JsValue events = JS.get(self, "events");
      float indexBeforeExits = events.length;
      float indexBeforeFlow = indexBeforeExits;
      JsValue point = JS.undefined();
      while (true) {
        indexBeforeFlow--;
        if (indexBeforeFlow < 0.0) {
          break;
        }
        JsValue event = events[indexBeforeFlow];
        if (JS.strictEqual(event[0], "exit") && JS.strictEqual(JS.get(event[1], "type"), "chunkFlow")) {
          point = JS.get(event[1], "end");
          break;
        }
      }
      exitContainers(continued);
      moveExits(JS.get(self, "events"), indexBeforeExits, indexBeforeFlow, point);
      return JS.call(checkNewContainers, JS.undefined(), code);
    }
    return JS.call(start, JS.undefined(), code);
  });

  start = JS.method1((JsValue _s, JsValue code) => {
    if (continued < stack.length) {
      JsValue item = stack[continued];
      JS.set(self, "containerState", item[1]);
      return JS.call(JS.invoke(effects, "attempt", JS.get(item[0], "continuation"), documentContinue, checkNewContainers), JS.undefined(), code);
    }
    return JS.call(checkNewContainers, JS.undefined(), code);
  });

  return start;
}));
