import { isEof } from "../host.lil";
import { factorySpace } from "../factory-space.lil";
import { markdownLineEnding } from "../util-character.lil";

export JsValue contentConstruct = JS.object("tokenize", JS.method1((JsValue self, JsValue effects) => {
  JsValue previous = JS.undefined();
  JsValue contentStart = JS.undefined();
  JsValue lineStart = JS.undefined();

  JsValue data = JS.method1((JsValue _s, JsValue code) => {
    if (isEof(code)) {
      JS.invoke(effects, "exit", "chunkText");
      JS.invoke(effects, "exit", "paragraph");
      JS.invoke(effects, "consume", code);
      return JS.undefined();
    }
    if (markdownLineEnding(code)) {
      JS.invoke(effects, "consume", code);
      JS.invoke(effects, "exit", "chunkText");
      return lineStart;
    }
    JS.invoke(effects, "consume", code);
    return data;
  });

  lineStart = JS.method1((JsValue _s, JsValue code) => {
    JsValue token = JS.invoke(effects, "enter", "chunkText", JS.object("contentType", "text", "previous", previous));
    if (previous.truthy()) {
      JS.set(previous, "next", token);
    }
    previous = token;
    return JS.call(data, JS.undefined(), code);
  });

  contentStart = JS.invoke(
    effects,
    "attempt",
    JS.get(JS.get(JS.get(self, "parser"), "constructs"), "contentInitial"),
    JS.method1((JsValue _s, JsValue code) => {
      if (isEof(code)) {
        JS.invoke(effects, "consume", code);
        return JS.undefined();
      }
      JS.invoke(effects, "enter", "lineEnding");
      JS.invoke(effects, "consume", code);
      JS.invoke(effects, "exit", "lineEnding");
      return factorySpace(effects, contentStart, "linePrefix", 0.0);
    }),
    JS.method1((JsValue _s, JsValue code) => {
      JS.invoke(effects, "enter", "paragraph");
      return JS.call(lineStart, JS.undefined(), code);
    })
  );
  return contentStart;
}));
