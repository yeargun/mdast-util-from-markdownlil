import { call1, call2, call3, makeConstruct, objGet, undef } from "../host.lil";
import { factorySpace } from "../factory-space.lil";
import { markdownLineEnding } from "../util-character.lil";
import { isEof } from "../host.lil";
import { tLineEnding, tLineEndingBlank, tLinePrefix } from "../symbol/types.lil";
import { blankLine } from "../core/blank-line.lil";
import { content } from "../core/content.lil";

JsValue initializeFlow = JS.method1((JsValue self, JsValue effects) => {
  JsValue constructs = objGet(self, "parser")["constructs"];
  JsValue initial = JS.undefined();

  JsValue afterConstruct = JS.method1((JsValue _s, JsValue code) => {
    if (isEof(code)) {
      call1(objGet(effects, "consume"), effects, code);
      return undef();
    }
    call1(objGet(effects, "enter"), effects, tLineEnding);
    call1(objGet(effects, "consume"), effects, code);
    call1(objGet(effects, "exit"), effects, tLineEnding);
    JS.set(self, "currentConstruct", undef());
    return initial;
  });

  JsValue atBlankEnding = JS.method1((JsValue _s, JsValue code) => {
    if (isEof(code)) {
      call1(objGet(effects, "consume"), effects, code);
      return undef();
    }
    call1(objGet(effects, "enter"), effects, tLineEndingBlank);
    call1(objGet(effects, "consume"), effects, code);
    call1(objGet(effects, "exit"), effects, tLineEndingBlank);
    JS.set(self, "currentConstruct", undef());
    return initial;
  });

  JsValue flowAttempt = call3(
    objGet(effects, "attempt"),
    effects,
    objGet(constructs, "flow"),
    afterConstruct,
    call3(objGet(effects, "attempt"), effects, content, afterConstruct, undef())
  );
  JsValue spaced = factorySpace(effects, flowAttempt, tLinePrefix, 0);
  JsValue flowInitial = call3(objGet(effects, "attempt"), effects, objGet(constructs, "flowInitial"), afterConstruct, spaced);
  initial = call3(objGet(effects, "attempt"), effects, blankLine, atBlankEnding, flowInitial);
  return initial;
});

export JsValue flowConstruct = makeConstruct(initializeFlow);
