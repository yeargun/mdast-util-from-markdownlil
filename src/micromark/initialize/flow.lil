import { isEof } from "../host.lil";
import { factorySpace } from "../factory-space.lil";
import { blankLine } from "../core/blank-line.lil";
import { content } from "../core/content.lil";

export JsValue flowConstruct = JS.object("tokenize", JS.method1((JsValue self, JsValue effects) => {
  JsValue constructs = JS.get(JS.get(self, "parser"), "constructs");
  JsValue initial = JS.undefined();

  func(string)->JsValue after = (string type) => {
    return JS.method1((JsValue _s, JsValue code) => {
      if (isEof(code)) {
        JS.invoke(effects, "consume", code);
        return JS.undefined();
      }
      JS.invoke(effects, "enter", type);
      JS.invoke(effects, "consume", code);
      JS.invoke(effects, "exit", type);
      JS.set(self, "currentConstruct", JS.undefined());
      return initial;
    });
  };

  JsValue afterConstruct = after("lineEnding");
  initial = JS.invoke(
    effects,
    "attempt",
    blankLine,
    after("lineEndingBlank"),
    JS.invoke(
      effects,
      "attempt",
      JS.get(constructs, "flowInitial"),
      afterConstruct,
      factorySpace(
        effects,
        JS.invoke(effects, "attempt", JS.get(constructs, "flow"), afterConstruct, JS.invoke(effects, "attempt", content, afterConstruct)),
        "linePrefix",
        0.0
      )
    )
  );
  return initial;
}));
