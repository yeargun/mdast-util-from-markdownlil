extern JsValue String;

// A code is a character code (number), a negative virtual code, or `null` at the
// end of input. Each check is a closure over its expression, as upstream's.
func(JsValue)->bool regexCheck(Regex regex) {
  return (JsValue code) => JS.strictNotEqual(code, null) && JS.greaterThan(code, -1) && regex.test(JS.assume(JS.invoke(String, "fromCharCode", code)));
}

export func(JsValue)->bool asciiAlpha = regexCheck(new Regex("[A-Za-z]", ""));
export func(JsValue)->bool asciiAlphanumeric = regexCheck(new Regex("[\\dA-Za-z]", ""));
export func(JsValue)->bool asciiAtext = regexCheck(new Regex("[#-'*+\\--9=?A-Z^-~]", ""));

export bool asciiControl(JsValue code) {
  return JS.strictNotEqual(code, null) && (JS.lessThan(code, 32) || JS.strictEqual(code, 127));
}

export func(JsValue)->bool asciiDigit = regexCheck(new Regex("\\d", ""));
export func(JsValue)->bool asciiHexDigit = regexCheck(new Regex("[\\dA-Fa-f]", ""));
export func(JsValue)->bool asciiPunctuation = regexCheck(new Regex("[!-/:-@[-`{-~]", ""));

export bool markdownLineEnding(JsValue code) {
  return JS.strictNotEqual(code, null) && JS.lessThan(code, -2);
}

export bool markdownLineEndingOrSpace(JsValue code) {
  return JS.strictNotEqual(code, null) && (JS.lessThan(code, 0) || JS.strictEqual(code, 32));
}

export bool markdownSpace(JsValue code) {
  return JS.strictEqual(code, -2) || JS.strictEqual(code, -1) || JS.strictEqual(code, 32);
}

export func(JsValue)->bool unicodePunctuation = regexCheck(new Regex("\\p{P}|\\p{S}", "u"));
export func(JsValue)->bool unicodeWhitespace = regexCheck(new Regex("\\s", ""));
