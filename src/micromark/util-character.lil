import { fromCharCode1 } from "./host.lil";

Regex asciiAlphaRe = new Regex("[A-Za-z]", "");
Regex asciiAlphanumericRe = new Regex("[\\dA-Za-z]", "");
Regex asciiAtextRe = new Regex("[#-'*+\\--9=?A-Z^-~]", "");
Regex asciiDigitRe = new Regex("\\d", "");
Regex asciiHexDigitRe = new Regex("[\\dA-Fa-f]", "");
Regex asciiPunctuationRe = new Regex("[!-/:-@[-`{-~]", "");
Regex unicodePunctuationRe = new Regex("\\p{P}|\\p{S}", "u");
Regex unicodeWhitespaceRe = new Regex("\\s", "");

bool regexCode(Regex pattern, JsValue code) {
  return JS.strictNotEqual(code, null) && JS.number(code) > -1.0 && pattern.test(fromCharCode1(code));
}

export bool asciiAlpha(JsValue code) {
  return regexCode(asciiAlphaRe, code);
}

export bool asciiAlphanumeric(JsValue code) {
  return regexCode(asciiAlphanumericRe, code);
}

export bool asciiAtext(JsValue code) {
  return regexCode(asciiAtextRe, code);
}

export bool asciiControl(JsValue code) {
  return JS.strictNotEqual(code, null) && (JS.number(code) < 32.0 || JS.strictEqual(code, 127));
}

export bool asciiDigit(JsValue code) {
  return regexCode(asciiDigitRe, code);
}

export bool asciiHexDigit(JsValue code) {
  return regexCode(asciiHexDigitRe, code);
}

export bool asciiPunctuation(JsValue code) {
  return regexCode(asciiPunctuationRe, code);
}

export bool markdownLineEnding(JsValue code) {
  return JS.strictNotEqual(code, null) && JS.number(code) < -2.0;
}

export bool markdownLineEndingOrSpace(JsValue code) {
  return JS.strictNotEqual(code, null) && (JS.number(code) < 0.0 || JS.strictEqual(code, 32));
}

export bool markdownSpace(JsValue code) {
  return JS.strictEqual(code, -2) || JS.strictEqual(code, -1) || JS.strictEqual(code, 32);
}

export bool unicodePunctuation(JsValue code) {
  return regexCode(unicodePunctuationRe, code);
}

export bool unicodeWhitespace(JsValue code) {
  return regexCode(unicodeWhitespaceRe, code);
}
