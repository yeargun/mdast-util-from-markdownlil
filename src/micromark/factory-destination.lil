import { asciiControl, markdownLineEnding, markdownLineEndingOrSpace } from "./util-character.lil";
import { cBackslash, cGreaterThan, cLeftParenthesis, cLessThan, cRightParenthesis, cSpace, codeEq } from "./symbol/codes.lil";
import { kContentTypeString } from "./symbol/constants.lil";
import { tChunkString } from "./symbol/types.lil";

// `max` is optional, as upstream's: `JS.undefined()` (elided at the call site)
// means no limit on nested parentheses.
export JsValue factoryDestination(
  JsValue effects,
  JsValue ok,
  JsValue nok,
  string typ,
  string literalType,
  string literalMarkerType,
  string rawType,
  string stringType,
  JsValue max
) {
  float limit = if (max.truthy()) { JS.number(max) } else { 1.0 / 0.0 };
  float balance = 0.0;
  JsValue enclosedBefore = JS.undefined();
  JsValue enclosed = JS.undefined();
  JsValue enclosedEscape = JS.undefined();
  JsValue raw = JS.undefined();
  JsValue rawEscape = JS.undefined();

  JsValue start = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cLessThan)) {
      JS.invoke(effects, "enter", typ);
      JS.invoke(effects, "enter", literalType);
      JS.invoke(effects, "enter", literalMarkerType);
      JS.invoke(effects, "consume", code);
      JS.invoke(effects, "exit", literalMarkerType);
      return enclosedBefore;
    }
    if (JS.strictEqual(code, null) || codeEq(code, cSpace) || codeEq(code, cRightParenthesis) || asciiControl(code)) {
      return JS.call(nok, JS.undefined(), code);
    }
    JS.invoke(effects, "enter", typ);
    JS.invoke(effects, "enter", rawType);
    JS.invoke(effects, "enter", stringType);
    JS.invoke(effects, "enter", tChunkString, JS.object("contentType", kContentTypeString));
    return JS.call(raw, JS.undefined(), code);
  });

  enclosedBefore = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cGreaterThan)) {
      JS.invoke(effects, "enter", literalMarkerType);
      JS.invoke(effects, "consume", code);
      JS.invoke(effects, "exit", literalMarkerType);
      JS.invoke(effects, "exit", literalType);
      JS.invoke(effects, "exit", typ);
      return ok;
    }
    JS.invoke(effects, "enter", stringType);
    JS.invoke(effects, "enter", tChunkString, JS.object("contentType", kContentTypeString));
    return JS.call(enclosed, JS.undefined(), code);
  });

  enclosed = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cGreaterThan)) {
      JS.invoke(effects, "exit", tChunkString);
      JS.invoke(effects, "exit", stringType);
      return JS.call(enclosedBefore, JS.undefined(), code);
    }
    if (JS.strictEqual(code, null) || codeEq(code, cLessThan) || markdownLineEnding(code)) {
      return JS.call(nok, JS.undefined(), code);
    }
    JS.invoke(effects, "consume", code);
    return if (codeEq(code, cBackslash)) { enclosedEscape } else { enclosed };
  });

  enclosedEscape = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cLessThan) || codeEq(code, cGreaterThan) || codeEq(code, cBackslash)) {
      JS.invoke(effects, "consume", code);
      return enclosed;
    }
    return JS.call(enclosed, JS.undefined(), code);
  });

  raw = JS.method1((JsValue _s, JsValue code) => {
    if (balance == 0.0 && (JS.strictEqual(code, null) || codeEq(code, cRightParenthesis) || markdownLineEndingOrSpace(code))) {
      JS.invoke(effects, "exit", tChunkString);
      JS.invoke(effects, "exit", stringType);
      JS.invoke(effects, "exit", rawType);
      JS.invoke(effects, "exit", typ);
      return JS.call(ok, JS.undefined(), code);
    }
    if (balance < limit && codeEq(code, cLeftParenthesis)) {
      JS.invoke(effects, "consume", code);
      balance++;
      return raw;
    }
    if (codeEq(code, cRightParenthesis)) {
      JS.invoke(effects, "consume", code);
      balance--;
      return raw;
    }
    if (JS.strictEqual(code, null) || codeEq(code, cSpace) || codeEq(code, cLeftParenthesis) || asciiControl(code)) {
      return JS.call(nok, JS.undefined(), code);
    }
    JS.invoke(effects, "consume", code);
    return if (codeEq(code, cBackslash)) { rawEscape } else { raw };
  });

  rawEscape = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cLeftParenthesis) || codeEq(code, cRightParenthesis) || codeEq(code, cBackslash)) {
      JS.invoke(effects, "consume", code);
      return raw;
    }
    return JS.call(raw, JS.undefined(), code);
  });

  return start;
}
