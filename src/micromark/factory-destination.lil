import { call1, call2, objGet, undef } from "./host.lil";
import { asciiControl, markdownLineEnding, markdownLineEndingOrSpace } from "./util-character.lil";
import { cLessThan, codeEq } from "./symbol/codes.lil";
import { isEof } from "./host.lil";
import { kContentTypeString } from "./symbol/constants.lil";
import { tChunkString } from "./symbol/types.lil";

JsValue chunkStringFields() {
  JsValue fields = JS.object();
  JS.set(fields, "contentType", kContentTypeString);
  return fields;
}

export JsValue factoryDestination(
  JsValue effects,
  JsValue ok,
  JsValue nok,
  string typ,
  string literalType,
  string literalMarkerType,
  string rawType,
  string stringType,
  float max
) {
  float limit = 1.0 / 0.0;
  if (max != 0.0) {
    limit = max;
  }
  int balance = 0;
  JsValue enclosed = undef();
  JsValue enclosedBefore = undef();
  JsValue raw = undef();

  JsValue enclosedEscape = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cLessThan) || codeEq(code, 62) || codeEq(code, 92)) {
      call1(objGet(effects, "consume"), effects, code);
      return enclosed;
    }
    return call1(enclosed, JS.undefined(), code);
  });

  enclosed = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, 62)) {
      call1(objGet(effects, "exit"), effects, tChunkString);
      call1(objGet(effects, "exit"), effects, stringType);
      return call1(enclosedBefore, JS.undefined(), code);
    }
    if (isEof(code) || codeEq(code, 60) || markdownLineEnding(code)) {
      return call1(nok, JS.undefined(), code);
    }
    call1(objGet(effects, "consume"), effects, code);
    if (codeEq(code, 92)) {
      return enclosedEscape;
    }
    return enclosed;
  });

  enclosedBefore = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, 62)) {
      call1(objGet(effects, "enter"), effects, literalMarkerType);
      call1(objGet(effects, "consume"), effects, code);
      call1(objGet(effects, "exit"), effects, literalMarkerType);
      call1(objGet(effects, "exit"), effects, literalType);
      call1(objGet(effects, "exit"), effects, typ);
      return ok;
    }
    call1(objGet(effects, "enter"), effects, stringType);
    call2(objGet(effects, "enter"), effects, tChunkString, chunkStringFields());
    return call1(enclosed, JS.undefined(), code);
  });

  JsValue rawEscape = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, 40) || codeEq(code, 41) || codeEq(code, 92)) {
      call1(objGet(effects, "consume"), effects, code);
      return raw;
    }
    return call1(raw, JS.undefined(), code);
  });

  raw = JS.method1((JsValue _s, JsValue code) => {
    if (balance == 0 && (isEof(code) || codeEq(code, 41) || markdownLineEndingOrSpace(code))) {
      call1(objGet(effects, "exit"), effects, tChunkString);
      call1(objGet(effects, "exit"), effects, stringType);
      call1(objGet(effects, "exit"), effects, rawType);
      call1(objGet(effects, "exit"), effects, typ);
      return call1(ok, JS.undefined(), code);
    }
    if (balance < limit && codeEq(code, 40)) {
      call1(objGet(effects, "consume"), effects, code);
      balance = balance + 1;
      return raw;
    }
    if (codeEq(code, 41)) {
      call1(objGet(effects, "consume"), effects, code);
      balance = balance - 1;
      return raw;
    }
    if (isEof(code) || codeEq(code, 32) || codeEq(code, 40) || asciiControl(code)) {
      return call1(nok, JS.undefined(), code);
    }
    call1(objGet(effects, "consume"), effects, code);
    if (codeEq(code, 92)) {
      return rawEscape;
    }
    return raw;
  });

  JsValue start = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, 60)) {
      call1(objGet(effects, "enter"), effects, typ);
      call1(objGet(effects, "enter"), effects, literalType);
      call1(objGet(effects, "enter"), effects, literalMarkerType);
      call1(objGet(effects, "consume"), effects, code);
      call1(objGet(effects, "exit"), effects, literalMarkerType);
      return enclosedBefore;
    }
    if (isEof(code) || codeEq(code, 32) || codeEq(code, 41) || asciiControl(code)) {
      return call1(nok, JS.undefined(), code);
    }
    call1(objGet(effects, "enter"), effects, typ);
    call1(objGet(effects, "enter"), effects, rawType);
    call1(objGet(effects, "enter"), effects, stringType);
    call2(objGet(effects, "enter"), effects, tChunkString, chunkStringFields());
    return call1(raw, JS.undefined(), code);
  });

  return start;
}
