import { asList, hasOwn } from "./host.lil";
import { splice } from "./util-chunked.lil";

// Syntax and HTML extensions merge the same way per hook; only what happens per key differs.
JsValue combine(JsValue extensions, bool html) {
  JsValue all = JS.object();
  for (float index = 0.0; index < extensions.length; index++) {
    JsValue extension = extensions[index];
    for (string hook in extension) {
      JsValue left = JS.get(all, hook);
      if (!hasOwn(all, hook) || !left.truthy()) {
        left = JS.object();
        JS.set(all, hook, left);
      }
      JsValue right = JS.get(extension, hook);
      if (right.truthy()) {
        for (string key in right) {
          JsValue value = JS.get(right, key);
          if (html) {
            JS.set(left, key, value);
          } else {
            if (!hasOwn(left, key)) {
              JS.set(left, key, JS.array());
            }
            JsValue list = asList(value);
            JsValue existing = JS.get(left, key);
            JsValue[] before = [];
            for (float item = 0.0; item < list.length; item++) {
              if (JS.strictEqual(JS.get(list[item], "add"), "after")) {
                JS.invoke(existing, "push", list[item]);
              } else {
                before.push(list[item]);
              }
            }
            splice(existing, 0, 0, before);
          }
        }
      }
    }
  }
  return all;
}

export JsValue combineExtensions(JsValue extensions) {
  return combine(extensions, false);
}

export JsValue combineHtmlExtensions(JsValue htmlExtensions) {
  return combine(htmlExtensions, true);
}
