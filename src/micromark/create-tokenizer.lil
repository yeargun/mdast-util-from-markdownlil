import {
  arrLen,
  arrayFrom,
  call0,
  call1,
  call2,
  call3,
  codeEof,
  eventEnter,
  eventExit,
  fromCharCode1,
  includesVal,
  isEof,
  isStr,
  jsInt,
  jsNum,
  jsString,
  objGet,
  objGetVal,
  objSetVal,
  objectAssign,
  objectCreate,
  pop,
  push,
  slice1,
  slice2,
  undef
} from "./host.lil";
import { markdownLineEnding } from "./util-character.lil";
import { pushAll, splice } from "./util-chunked.lil";
import { resolveAll } from "./util-resolve-all.lil";
import {
  cCarriageReturn,
  cCarriageReturnLineFeed,
  cHorizontalTab,
  cLineFeed,
  cVirtualSpace,
  codeEq
} from "./symbol/codes.lil";
import { vCr, vHt, vLf, vSpace } from "./symbol/values.lil";

struct PointState {
  float _bufferIndex;
  float _index;
  float line;
  float column;
  float offset;

}

JsValue sliceChunks(JsValue chunks, JsValue token) {
  JsValue start = objGet(token, "start");
  JsValue end = objGet(token, "end");
  int startIndex = jsInt(objGet(start, "_index"));
  int startBufferIndex = jsInt(objGet(start, "_bufferIndex"));
  int endIndex = jsInt(objGet(end, "_index"));
  int endBufferIndex = jsInt(objGet(end, "_bufferIndex"));
  JsValue[] view = [];
  if (startIndex == endIndex) {
    string chunk = JS.assume(chunks[startIndex]);
    view = [chunk.slice(startBufferIndex, endBufferIndex)];
  } else {
    view = JS.assume(slice2(chunks, startIndex, endIndex));
    if (startBufferIndex > -1) {
      JsValue head = view[0];
      if (isStr(head)) {
        view[0] = JS.call(JS.get(head, "slice"), head, startBufferIndex);
      } else {
        JS.call(JS.get(view, "shift"), view);
      }
    }
    if (endBufferIndex > 0) {
      string chunk = JS.assume(chunks[endIndex]);
      push(view, chunk.slice(0, endBufferIndex));
    }
  }
  return view;
}

string serializeChunks(JsValue chunks, JsValue expandTabs) {
  int index = -1;
  string[] result = [];
  bool atTab = false;
  int n = arrLen(chunks);
  while (true) {
    index = index + 1;
    if (index >= n) {
      break;
    }
    JsValue chunk = chunks[index];
    string value = "";
    if (isStr(chunk)) {
      value = jsString(chunk);
    } else if (codeEq(chunk, cCarriageReturn)) {
      value = vCr;
    } else if (codeEq(chunk, cLineFeed)) {
      value = vLf;
    } else if (codeEq(chunk, cCarriageReturnLineFeed)) {
      value = vCr + vLf;
    } else if (codeEq(chunk, cHorizontalTab)) {
      if (expandTabs.truthy()) {
        value = vSpace;
      } else {
        value = vHt;
      }
    } else if (codeEq(chunk, cVirtualSpace)) {
      if (!expandTabs.truthy() && atTab) {
        continue;
      }
      value = vSpace;
    } else {
      value = fromCharCode1(chunk);
    }
    atTab = codeEq(chunk, cHorizontalTab);
    result.push(value);
  }
  return result.join("");
}

pure PointState clonePointState(PointState point) {
  return PointState{point._bufferIndex, point._index, point.line, point.column, point.offset};
}

pure JsValue pointValue(PointState point) {
  return JS.object(
    "_bufferIndex", point._bufferIndex,
    "_index", point._index,
    "line", point.line,
    "column", point.column,
    "offset", point.offset
  );
}

export JsValue createTokenizer(JsValue parser, JsValue initialize, JsValue from) {
  float line = 1.0;
  float column = 1.0;
  float offset = 0.0;
  if (from.truthy()) {
    JsValue fromLine = objGet(from, "line");
    if (fromLine.truthy()) {
      line = jsNum(fromLine);
    }
    JsValue fromColumn = objGet(from, "column");
    if (fromColumn.truthy()) {
      column = jsNum(fromColumn);
    }
    JsValue fromOffset = objGet(from, "offset");
    if (fromOffset.truthy()) {
      offset = jsNum(fromOffset);
    }
  }
  PointState point = PointState{-1.0, 0.0, line, column, offset};
  JsValue columnStart = JS.object();
  JsValue resolveAllConstructs = JS.array();
  JsValue chunks = JS.array();
  JsValue[] stack = [];
  JsValue context = JS.object();
  JsValue effects = undef();
  JsValue state = undef();

  JsValue accountForPotentialSkip = JS.method0((JsValue _self) => {
    string lineKey = JS.string(point.line);
    if (JS.has(columnStart, lineKey) && point.column < 2.0) {
      point.column = jsNum(objGetVal(columnStart, lineKey));
      point.offset = point.offset + jsNum(objGetVal(columnStart, lineKey)) - 1.0;
    }
    return undef();
  });

  JsValue addResult = JS.method2((JsValue _self, JsValue construct, JsValue from) => {
    if (objGet(construct, "resolveAll").truthy() && !includesVal(resolveAllConstructs, construct)) {
      push(resolveAllConstructs, construct);
    }
    if (objGet(construct, "resolve").truthy()) {
      JsValue events = objGet(context, "events");
      JsValue resolved = call2(objGet(construct, "resolve"), construct, slice1(events, from), context);
      splice(events, from, arrLen(events) - jsInt(from), resolved);
    }
    if (objGet(construct, "resolveTo").truthy()) {
      JS.set(context, "events", call2(objGet(construct, "resolveTo"), construct, objGet(context, "events"), context));
    }
    return undef();
  });

  JsValue constructFactory = JS.method2((JsValue _self, JsValue onreturn, JsValue fields) => {
    return JS.method3((JsValue _hookSelf, JsValue constructs, JsValue returnState, JsValue bogusState) => {
      JsValue[] listOfConstructs = [];
      int constructIndex = 0;
      JsValue currentConstruct = undef();
      float eventStart = 0.0;
      JsValue restore = undef();
      JsValue handleConstruct = undef();
      JsValue handleListOfConstructs = undef();

      JsValue ok = JS.method1((JsValue _s, JsValue code) => {
        call3(onreturn, JS.undefined(), currentConstruct, restore, eventStart);
        return returnState;
      });
      JsValue nok = JS.method1((JsValue _s, JsValue code) => {
        call0(restore, JS.undefined());
        constructIndex = constructIndex + 1;
        if (constructIndex < listOfConstructs.length) {
          return call1(handleConstruct, JS.undefined(), listOfConstructs[constructIndex]);
        }
        return bogusState;
      });

      handleConstruct = JS.method1((JsValue _s, JsValue construct) => {
        return JS.method1((JsValue _stateSelf, JsValue code) => {
          PointState startPoint = clonePointState(point);
          JsValue startPrevious = objGet(context, "previous");
          JsValue startCurrentConstruct = objGet(context, "currentConstruct");
          eventStart = arrLen(objGet(context, "events"));
          JsValue[] startStack = JS.assume(arrayFrom(stack));
          restore = JS.method0((JsValue _restoreSelf) => {
            point = startPoint;
            JS.set(context, "previous", startPrevious);
            JS.set(context, "currentConstruct", startCurrentConstruct);
            JS.set(objGet(context, "events"), "length", eventStart);
            stack = startStack;
            call0(accountForPotentialSkip, JS.undefined());
            return undef();
          });
          currentConstruct = construct;
          if (!objGet(construct, "partial").truthy()) {
            JS.set(context, "currentConstruct", construct);
          }
          JsValue name = objGet(construct, "name");
          if (name.truthy()) {
            JsValue disable = objGet(objGet(objGet(context, "parser"), "constructs"), "disable");
            JsValue disabled = objGet(disable, "null");
            if (JS.call(JS.get(disabled, "includes"), disabled, objGet(construct, "name")).truthy()) {
              return call1(nok, JS.undefined(), code);
            }
          }
          JsValue selfCtx = context;
          if (fields.truthy()) {
            selfCtx = objectAssign(objectCreate(context), fields);
          }
          JsValue next = call3(objGet(construct, "tokenize"), selfCtx, effects, ok, nok);
          return call1(next, JS.undefined(), code);
        });
      });

      handleListOfConstructs = JS.method1((JsValue _s, JsValue list) => {
        listOfConstructs = JS.assume(list);
        constructIndex = 0;
        if (listOfConstructs.length == 0) {
          return bogusState;
        }
        return call1(handleConstruct, JS.undefined(), listOfConstructs[0]);
      });

      if (constructs.isArray()) {
        return call1(handleListOfConstructs, JS.undefined(), constructs);
      }
      if (JS.has(constructs, "tokenize")) {
        JsValue[] list = [constructs];
        return call1(handleListOfConstructs, JS.undefined(), list);
      }
      return JS.method1((JsValue _s, JsValue code) => {
        JsValue left = undef();
        JsValue all = undef();
        if (!isEof(code)) {
          left = objGetVal(constructs, code);
          all = objGet(constructs, "null");
        }
        JsValue[] leftList = [];
        if (left.isArray()) {
          leftList = JS.assume(left);
        } else if (left.truthy()) {
          leftList = [left];
        }
        JsValue[] allList = [];
        if (all.isArray()) {
          allList = JS.assume(all);
        } else if (all.truthy()) {
          allList = [all];
        }
        JsValue[] list = [...leftList, ...allList];
        return call1(call1(handleListOfConstructs, JS.undefined(), list), JS.undefined(), code);
      });
    });
  });

  JsValue nowFn = JS.method0((JsValue _self) => {
    return pointValue(point);
  });
  JsValue defineSkipFn = JS.method1((JsValue _self, JsValue value) => {
    objSetVal(columnStart, objGet(value, "line"), objGet(value, "column"));
    call0(accountForPotentialSkip, JS.undefined());
    return undef();
  });
  JsValue sliceStreamFn = JS.method1((JsValue _self, JsValue token) => {
    return sliceChunks(chunks, token);
  });
  JsValue sliceSerializeFn = JS.method2((JsValue _self, JsValue token, JsValue expandTabs) => {
    return serializeChunks(sliceChunks(chunks, token), expandTabs);
  });
  JsValue consumeFn = JS.method1((JsValue _self, JsValue code) => {
    if (markdownLineEnding(code)) {
      point.line = point.line + 1.0;
      point.column = 1.0;
      float add = if (codeEq(code, cCarriageReturnLineFeed)) { 2.0 } else { 1.0 };
      point.offset = point.offset + add;
      call0(accountForPotentialSkip, JS.undefined());
    } else if (!codeEq(code, cVirtualSpace)) {
      point.column = point.column + 1.0;
      point.offset = point.offset + 1.0;
    }
    if (point._bufferIndex < 0.0) {
      point._index = point._index + 1.0;
    } else {
      point._bufferIndex = point._bufferIndex + 1.0;
      JsValue chunk = chunks[point._index.toInt()];
      float chunkLength = chunk.length;
      if (point._bufferIndex == chunkLength) {
        point._bufferIndex = -1.0;
        point._index = point._index + 1.0;
      }
    }
    JS.set(context, "previous", code);
    return undef();
  });
  JsValue enterFn = JS.method2((JsValue _self, JsValue typ, JsValue fields) => {
    JsValue token = fields;
    if (!fields.truthy()) {
      token = JS.object();
    }
    JS.set(token, "type", typ);
    JS.set(token, "start", pointValue(point));
    push(objGet(context, "events"), eventEnter(token, context));
    stack.push(token);
    return token;
  });
  JsValue exitFn = JS.method1((JsValue _self, JsValue typ) => {
    JsValue token = stack.pop();
    JS.set(token, "end", pointValue(point));
    push(objGet(context, "events"), eventExit(token, context));
    return token;
  });
  JsValue writeFn = JS.method1((JsValue _self, JsValue slice) => {
    chunks = pushAll(chunks, slice);
    while (point._index < arrLen(chunks)) {
      JsValue chunk = chunks[point._index.toInt()];
      if (chunk is string) {
        float chunkIndex = point._index;
        if (point._bufferIndex < 0.0) {
          point._bufferIndex = 0.0;
        }
        string text = chunk;
        while (point._index == chunkIndex && point._bufferIndex < text.length) {
          state = call1(state, JS.undefined(), text.charCodeAt(point._bufferIndex.toInt()));
        }
      } else {
        state = call1(state, JS.undefined(), chunk);
      }
    }
    if (!isEof(chunks[arrLen(chunks) - 1])) {
      return JS.array();
    }
    call2(addResult, JS.undefined(), initialize, 0);
    JS.set(context, "events", resolveAll(resolveAllConstructs, objGet(context, "events"), context));
    return objGet(context, "events");
  });
  JsValue onsuccessfulconstruct = JS.method3((JsValue _s, JsValue construct, JsValue _restore, JsValue from) => {
    call2(addResult, JS.undefined(), construct, from);
    return undef();
  });
  JsValue onsuccessfulcheck = JS.method3((JsValue _s, JsValue _construct, JsValue restore, JsValue _from) => {
    call0(restore, JS.undefined());
    return undef();
  });
  JsValue interruptFields = JS.object("interrupt", true);
  effects = JS.object(
    "attempt", call2(constructFactory, JS.undefined(), onsuccessfulconstruct, undef()),
    "check", call2(constructFactory, JS.undefined(), onsuccessfulcheck, undef()),
    "consume", consumeFn,
    "enter", enterFn,
    "exit", exitFn,
    "interrupt", call2(constructFactory, JS.undefined(), onsuccessfulcheck, interruptFields)
  );
  JS.set(context, "code", codeEof);
  JS.set(context, "containerState", JS.object());
  JS.set(context, "defineSkip", defineSkipFn);
  JS.set(context, "events", JS.array());
  JS.set(context, "now", nowFn);
  JS.set(context, "parser", parser);
  JS.set(context, "previous", codeEof);
  JS.set(context, "sliceSerialize", sliceSerializeFn);
  JS.set(context, "sliceStream", sliceStreamFn);
  JS.set(context, "write", writeFn);
  state = call1(objGet(initialize, "tokenize"), context, effects);
  if (objGet(initialize, "resolveAll").truthy()) {
    push(resolveAllConstructs, initialize);
  }
  return context;
}
