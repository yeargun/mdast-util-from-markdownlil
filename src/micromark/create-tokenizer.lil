import { TokenizerPoint, TokenizerToken, asList, copyPoint, isEof, undef } from "./host.lil";
import { markdownLineEnding } from "./util-character.lil";
import { pushAll, splice } from "./util-chunked.lil";
import { resolveAll } from "./util-resolve-all.lil";

extern JsValue Object;
extern JsValue Array;
extern JsValue String;

JsValue sliceChunks(JsValue chunks, TokenizerToken token) {
  float startIndex = token.start._index;
  float startBufferIndex = token.start._bufferIndex;
  float endIndex = token.end._index;
  float endBufferIndex = token.end._bufferIndex;
  if (startIndex == endIndex) {
    JsValue chunk = chunks[startIndex];
    return JS.array(JS.call(JS.get(chunk, "slice"), chunk, startBufferIndex, endBufferIndex));
  }
  JsValue view = JS.call(JS.get(chunks, "slice"), chunks, startIndex, endIndex);
  if (startBufferIndex > -1.0) {
    JsValue head = view[0];
    if (JS.typeOf(head) == "string") {
      view[0] = JS.call(JS.get(head, "slice"), head, startBufferIndex);
    } else {
      JS.call(JS.get(view, "shift"), view);
    }
  }
  if (endBufferIndex > 0.0) {
    JsValue chunk = chunks[endIndex];
    JS.call(JS.get(view, "push"), view, JS.call(JS.get(chunk, "slice"), chunk, 0, endBufferIndex));
  }
  return view;
}

JsValue serializeChunks(JsValue chunks, JsValue expandTabs) {
  JsValue[] result = [];
  bool atTab = false;
  for (float index = 0.0; index < chunks.length; index++) {
    JsValue chunk = chunks[index];
    JsValue value = chunk;
    if (JS.typeOf(chunk) != "string") {
      if (JS.strictEqual(chunk, -5)) {
        value = "\r";
      } else if (JS.strictEqual(chunk, -4)) {
        value = "\n";
      } else if (JS.strictEqual(chunk, -3)) {
        value = "\r\n";
      } else if (JS.strictEqual(chunk, -2)) {
        value = if (expandTabs.truthy()) { " " } else { "\t" };
      } else if (JS.strictEqual(chunk, -1)) {
        if (!expandTabs.truthy() && atTab) {
          continue;
        }
        value = " ";
      } else {
        value = JS.call(JS.get(String, "fromCharCode"), String, chunk);
      }
    }
    atTab = JS.strictEqual(chunk, -2);
    result.push(value);
  }
  return JS.call(JS.get(result, "join"), result, "");
}

export JsValue createTokenizer(JsValue parser, JsValue initialize, JsValue from) {
  TokenizerPoint point = JS.assume(JS.object(
    "_bufferIndex", -1,
    "_index", 0,
    "line", JS.or(JS.and(from, JS.get(from, "line")), 1),
    "column", JS.or(JS.and(from, JS.get(from, "column")), 1),
    "offset", JS.or(JS.and(from, JS.get(from, "offset")), 0)
  ));
  JsValue columnStart = JS.object();
  JsValue[] resolveAllConstructs = [];
  JsValue chunks = JS.array();
  JsValue[] stack = [];
  JsValue context = undef();
  JsValue effects = undef();
  JsValue state = undef();

  JsValue now = JS.method0((JsValue _self) => {
    return copyPoint(point);
  });

  JsValue accountForPotentialSkip = JS.method0((JsValue _self) => {
    if (JS.in(point.line, columnStart) && point.column < 2.0) {
      float column = JS.assume(columnStart[point.line]);
      point.column = column;
      point.offset = point.offset + column - 1.0;
    }
    return undef();
  });

  JsValue addResult = JS.method2((JsValue _self, JsValue construct, JsValue from) => {
    if (JS.get(construct, "resolveAll").truthy() && !resolveAllConstructs.includes(construct)) {
      resolveAllConstructs.push(construct);
    }
    if (JS.get(construct, "resolve").truthy()) {
      JsValue events = JS.get(context, "events");
      float start = JS.assume(from);
      splice(events, from, events.length - start, JS.invoke(construct, "resolve", JS.invoke(events, "slice", from), context));
    }
    if (JS.get(construct, "resolveTo").truthy()) {
      JS.set(context, "events", JS.invoke(construct, "resolveTo", JS.get(context, "events"), context));
    }
    return undef();
  });

  JsValue constructFactory = JS.method2((JsValue _self, JsValue onreturn, JsValue fields) => {
    return JS.method3((JsValue _hookSelf, JsValue constructs, JsValue returnState, JsValue bogusState) => {
      JsValue listOfConstructs = undef();
      float constructIndex = 0.0;
      JsValue currentConstruct = undef();
      float eventStart = 0.0;
      JsValue restore = undef();
      JsValue handleConstruct = undef();

      JsValue ok = JS.method1((JsValue _s, JsValue code) => {
        JS.call(onreturn, undef(), currentConstruct, restore, eventStart);
        return returnState;
      });
      JsValue nok = JS.method1((JsValue _s, JsValue code) => {
        JS.call(restore, undef());
        constructIndex = constructIndex + 1.0;
        if (constructIndex < listOfConstructs.length) {
          return JS.call(handleConstruct, undef(), listOfConstructs[constructIndex]);
        }
        return bogusState;
      });

      handleConstruct = JS.method1((JsValue _s, JsValue construct) => {
        return JS.method1((JsValue _stateSelf, JsValue code) => {
          JsValue startPoint = JS.call(now, undef());
          JsValue startPrevious = JS.get(context, "previous");
          JsValue startCurrentConstruct = JS.get(context, "currentConstruct");
          eventStart = JS.get(context, "events").length;
          JsValue startStack = JS.call(JS.get(Array, "from"), Array, stack);
          restore = JS.method0((JsValue _restoreSelf) => {
            point = JS.assume(startPoint);
            JS.set(context, "previous", startPrevious);
            JS.set(context, "currentConstruct", startCurrentConstruct);
            JS.set(JS.get(context, "events"), "length", eventStart);
            stack = JS.assume(startStack);
            JS.call(accountForPotentialSkip, undef());
            return undef();
          });
          currentConstruct = construct;
          if (!JS.get(construct, "partial").truthy()) {
            JS.set(context, "currentConstruct", construct);
          }
          JsValue name = JS.get(construct, "name");
          if (name.truthy()) {
            JsValue disabled = JS.get(JS.get(JS.get(JS.get(context, "parser"), "constructs"), "disable"), "null");
            if (JS.call(JS.get(disabled, "includes"), disabled, name).truthy()) {
              return JS.call(nok, undef(), code);
            }
          }
          JsValue self = context;
          if (fields.truthy()) {
            self = JS.call(JS.get(Object, "assign"), Object, JS.call(JS.get(Object, "create"), Object, context), fields);
          }
          JsValue next = JS.call(JS.get(construct, "tokenize"), self, effects, ok, nok);
          return JS.call(next, undef(), code);
        });
      });

      JsValue handleListOfConstructs = JS.method1((JsValue _s, JsValue list) => {
        listOfConstructs = list;
        constructIndex = 0.0;
        if (list.length == 0.0) {
          return bogusState;
        }
        return JS.call(handleConstruct, undef(), list[0]);
      });

      if (constructs.isArray()) {
        return JS.call(handleListOfConstructs, undef(), constructs);
      }
      if (JS.in("tokenize", constructs)) {
        return JS.call(handleListOfConstructs, undef(), JS.array(constructs));
      }
      return JS.method1((JsValue _s, JsValue code) => {
        JsValue left = code;
        JsValue all = code;
        if (!isEof(code)) {
          left = constructs[code];
          all = JS.get(constructs, "null");
        }
        JsValue[] leftList = JS.assume(asList(left));
        JsValue[] allList = JS.assume(asList(all));
        JsValue[] list = [...leftList, ...allList];
        return JS.call(JS.call(handleListOfConstructs, undef(), list), undef(), code);
      });
    });
  });

  JsValue onsuccessfulcheck = JS.method3((JsValue _s, JsValue _construct, JsValue restore, JsValue _from) => {
    JS.call(restore, undef());
    return undef();
  });

  JsValue attempt = JS.call(constructFactory, undef(), JS.method3((JsValue _s, JsValue construct, JsValue _restore, JsValue from) => {
      JS.call(addResult, undef(), construct, from);
      return undef();
    }), undef());
  JsValue check = JS.call(constructFactory, undef(), onsuccessfulcheck, undef());
  JsValue interrupt = JS.call(constructFactory, undef(), onsuccessfulcheck, JS.object("interrupt", true));
  effects = JS.object(
    "attempt", attempt,
    "check", check,
    "consume", JS.method1((JsValue _self, JsValue code) => {
      if (markdownLineEnding(code)) {
        point.line = point.line + 1.0;
        point.column = 1.0;
        point.offset = point.offset + if (JS.strictEqual(code, -3)) { 2.0 } else { 1.0 };
        JS.call(accountForPotentialSkip, undef());
      } else if (!JS.strictEqual(code, -1)) {
        point.column = point.column + 1.0;
        point.offset = point.offset + 1.0;
      }
      if (point._bufferIndex < 0.0) {
        point._index = point._index + 1.0;
      } else {
        point._bufferIndex = point._bufferIndex + 1.0;
        if (point._bufferIndex == chunks[point._index].length) {
          point._bufferIndex = -1.0;
          point._index = point._index + 1.0;
        }
      }
      JS.set(context, "previous", code);
      return undef();
    }),
    "enter", JS.method2((JsValue _self, JsValue type, JsValue fields) => {
      JsValue token = JS.or(fields, JS.object());
      JS.set(token, "type", type);
      JS.set(token, "start", JS.call(now, undef()));
      JsValue events = JS.get(context, "events");
      JS.call(JS.get(events, "push"), events, JS.array("enter", token, context));
      stack.push(token);
      return token;
    }),
    "exit", JS.method1((JsValue _self, JsValue type) => {
      JsValue token = stack.pop();
      JS.set(token, "end", JS.call(now, undef()));
      JsValue events = JS.get(context, "events");
      JS.call(JS.get(events, "push"), events, JS.array("exit", token, context));
      return token;
    }),
    "interrupt", interrupt
  );

  context = JS.object(
    "code", null,
    "containerState", JS.object(),
    "defineSkip", JS.method1((JsValue _self, JsValue value) => {
      columnStart[JS.get(value, "line")] = JS.get(value, "column");
      JS.call(accountForPotentialSkip, undef());
      return undef();
    }),
    "events", JS.array(),
    "now", now,
    "parser", parser,
    "previous", null,
    "sliceSerialize", JS.method2((JsValue _self, JsValue token, JsValue expandTabs) => {
      return serializeChunks(sliceChunks(chunks, JS.assume(token)), expandTabs);
    }),
    "sliceStream", JS.method1((JsValue _self, JsValue token) => {
      return sliceChunks(chunks, JS.assume(token));
    }),
    "write", JS.method1((JsValue _self, JsValue slice) => {
      chunks = pushAll(chunks, slice);
      while (point._index < chunks.length) {
        JsValue chunk = chunks[point._index];
        if (JS.typeOf(chunk) == "string") {
          float chunkIndex = point._index;
          if (point._bufferIndex < 0.0) {
            point._bufferIndex = 0.0;
          }
          while (point._index == chunkIndex && point._bufferIndex < chunk.length) {
            state = JS.call(state, undef(), JS.call(JS.get(chunk, "charCodeAt"), chunk, point._bufferIndex));
          }
        } else {
          state = JS.call(state, undef(), chunk);
        }
      }
      if (!isEof(chunks[chunks.length - 1.0])) {
        return JS.array();
      }
      JS.call(addResult, undef(), initialize, 0);
      JS.set(context, "events", resolveAll(resolveAllConstructs, JS.get(context, "events"), context));
      return JS.get(context, "events");
    })
  );
  state = JS.call(JS.get(initialize, "tokenize"), context, effects);
  if (JS.get(initialize, "resolveAll").truthy()) {
    resolveAllConstructs.push(initialize);
  }
  return context;
}
