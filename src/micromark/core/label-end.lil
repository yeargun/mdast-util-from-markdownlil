import { factoryDestination } from "../factory-destination.lil";
import { factoryLabel } from "../factory-label.lil";
import { factoryTitle } from "../factory-title.lil";
import { factoryWhitespace } from "../factory-whitespace.lil";
import { markdownLineEndingOrSpace } from "../util-character.lil";
import { pushAll, splice } from "../util-chunked.lil";
import { normalizeIdentifier } from "../util-normalize-identifier.lil";
import { resolveAll } from "../util-resolve-all.lil";
import { cApostrophe, cLeftParenthesis, cLeftSquareBracket, cQuotationMark, cRightParenthesis, cRightSquareBracket, codeEq } from "../symbol/codes.lil";
import { kLinkResourceDestinationBalanceMax } from "../symbol/constants.lil";
import { tData, tImage, tLabel, tLabelEnd, tLabelImage, tLabelLink, tLabelMarker, tLabelText, tLink, tReference, tReferenceMarker, tReferenceString, tResource, tResourceDestination, tResourceDestinationLiteral, tResourceDestinationLiteralMarker, tResourceDestinationRaw, tResourceDestinationString, tResourceMarker, tResourceTitle, tResourceTitleMarker, tResourceTitleString } from "../symbol/types.lil";

import { copyPoint } from "../host.lil";

JsValue resolveAllLabelEnd = JS.method1((JsValue _self, JsValue events) => {
  float index = -1.0;
  JsValue newEvents = JS.array();
  while (true) {
    index++;
    if (index >= events.length) {
      break;
    }
    JsValue token = events[index][1];
    JS.invoke(newEvents, "push", events[index]);
    if (JS.strictEqual(JS.get(token, "type"), tLabelImage) || JS.strictEqual(JS.get(token, "type"), tLabelLink) || JS.strictEqual(JS.get(token, "type"), tLabelEnd)) {
      float offset = if (JS.strictEqual(JS.get(token, "type"), tLabelImage)) { 4.0 } else { 2.0 };
      JS.set(token, "type", tData);
      index += offset;
    }
  }
  if (events.length != newEvents.length) {
    splice(events, 0, events.length, newEvents);
  }
  return events;
});

JsValue resolveToLabelEnd = JS.method2((JsValue _self, JsValue events, JsValue context) => {
  float index = events.length;
  float offset = 0.0;
  float open = 0.0;
  float close = 0.0;
  while (true) {
    index--;
    if (index < 0.0) {
      break;
    }
    JsValue token = events[index][1];
    if (open != 0.0) {
      if (JS.strictEqual(JS.get(token, "type"), tLink) || (JS.strictEqual(JS.get(token, "type"), tLabelLink) && JS.get(token, "_inactive").truthy())) {
        break;
      }
      if (JS.strictEqual(events[index][0], "enter") && JS.strictEqual(JS.get(token, "type"), tLabelLink)) {
        JS.set(token, "_inactive", true);
      }
    } else if (close != 0.0) {
      if (JS.strictEqual(events[index][0], "enter") && (JS.strictEqual(JS.get(token, "type"), tLabelImage) || JS.strictEqual(JS.get(token, "type"), tLabelLink)) && !JS.get(token, "_balanced").truthy()) {
        open = index;
        if (JS.strictNotEqual(JS.get(token, "type"), tLabelLink)) {
          offset = 2.0;
          break;
        }
      }
    } else if (JS.strictEqual(JS.get(token, "type"), tLabelEnd)) {
      close = index;
    }
  }
  JsValue group = JS.object(
    "type", if (JS.strictEqual(JS.get(events[open][1], "type"), tLabelLink)) { tLink } else { tImage },
    "start", copyPoint(JS.get(events[open][1], "start")),
    "end", copyPoint(JS.get(events[events.length - 1.0][1], "end"))
  );
  JsValue label = JS.object(
    "type", tLabel,
    "start", copyPoint(JS.get(events[open][1], "start")),
    "end", copyPoint(JS.get(events[close][1], "end"))
  );
  JsValue text = JS.object(
    "type", tLabelText,
    "start", copyPoint(JS.get(events[open + offset + 2.0][1], "end")),
    "end", copyPoint(JS.get(events[close - 2.0][1], "start"))
  );
  JsValue media = JS.array(JS.array("enter", group, context), JS.array("enter", label, context));
  media = pushAll(media, JS.invoke(events, "slice", open + 1.0, open + offset + 3.0));
  media = pushAll(media, JS.array(JS.array("enter", text, context)));
  media = pushAll(media, resolveAll(JS.get(JS.get(JS.get(JS.get(context, "parser"), "constructs"), "insideSpan"), "null"), JS.invoke(events, "slice", open + offset + 4.0, close - 3.0), context));
  media = pushAll(media, JS.array(JS.array("exit", text, context), events[close - 2.0], events[close - 1.0], JS.array("exit", label, context)));
  media = pushAll(media, JS.invoke(events, "slice", close + 1.0));
  media = pushAll(media, JS.array(JS.array("exit", group, context)));
  splice(events, open, events.length, media);
  return events;
});

JsValue tokenizeResource = JS.method3((JsValue _self, JsValue effects, JsValue ok, JsValue nok) => {
  JsValue resourceBefore = JS.undefined();
  JsValue resourceOpen = JS.undefined();
  JsValue resourceDestinationAfter = JS.undefined();
  JsValue resourceDestinationMissing = JS.undefined();
  JsValue resourceBetween = JS.undefined();
  JsValue resourceTitleAfter = JS.undefined();
  JsValue resourceEnd = JS.undefined();

  JsValue resourceStart = JS.method1((JsValue _s, JsValue code) => {
    JS.invoke(effects, "enter", tResource);
    JS.invoke(effects, "enter", tResourceMarker);
    JS.invoke(effects, "consume", code);
    JS.invoke(effects, "exit", tResourceMarker);
    return resourceBefore;
  });

  resourceBefore = JS.method1((JsValue _s, JsValue code) => {
    if (markdownLineEndingOrSpace(code)) {
      return JS.call(factoryWhitespace(effects, resourceOpen), JS.undefined(), code);
    }
    return JS.call(resourceOpen, JS.undefined(), code);
  });

  resourceOpen = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cRightParenthesis)) {
      return JS.call(resourceEnd, JS.undefined(), code);
    }
    return JS.call(factoryDestination(effects, resourceDestinationAfter, resourceDestinationMissing, tResourceDestination, tResourceDestinationLiteral, tResourceDestinationLiteralMarker, tResourceDestinationRaw, tResourceDestinationString, kLinkResourceDestinationBalanceMax), JS.undefined(), code);
  });

  resourceDestinationAfter = JS.method1((JsValue _s, JsValue code) => {
    if (markdownLineEndingOrSpace(code)) {
      return JS.call(factoryWhitespace(effects, resourceBetween), JS.undefined(), code);
    }
    return JS.call(resourceEnd, JS.undefined(), code);
  });

  resourceDestinationMissing = JS.method1((JsValue _s, JsValue code) => {
    return JS.call(nok, JS.undefined(), code);
  });

  resourceBetween = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cQuotationMark) || codeEq(code, cApostrophe) || codeEq(code, cLeftParenthesis)) {
      return JS.call(factoryTitle(effects, resourceTitleAfter, nok, tResourceTitle, tResourceTitleMarker, tResourceTitleString), JS.undefined(), code);
    }
    return JS.call(resourceEnd, JS.undefined(), code);
  });

  resourceTitleAfter = JS.method1((JsValue _s, JsValue code) => {
    if (markdownLineEndingOrSpace(code)) {
      return JS.call(factoryWhitespace(effects, resourceEnd), JS.undefined(), code);
    }
    return JS.call(resourceEnd, JS.undefined(), code);
  });

  resourceEnd = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cRightParenthesis)) {
      JS.invoke(effects, "enter", tResourceMarker);
      JS.invoke(effects, "consume", code);
      JS.invoke(effects, "exit", tResourceMarker);
      JS.invoke(effects, "exit", tResource);
      return ok;
    }
    return JS.call(nok, JS.undefined(), code);
  });

  return resourceStart;
});

JsValue tokenizeReferenceFull = JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
  JsValue referenceFullAfter = JS.method1((JsValue _s, JsValue code) => {
    string label = JS.assume(JS.invoke(self, "sliceSerialize", JS.get(self, "events")[JS.get(self, "events").length - 1.0][1]));
    if (JS.invoke(JS.get(JS.get(self, "parser"), "defined"), "includes", normalizeIdentifier(label.slice(1, -1))).truthy()) {
      return JS.call(ok, JS.undefined(), code);
    }
    return JS.call(nok, JS.undefined(), code);
  });

  JsValue referenceFullMissing = JS.method1((JsValue _s, JsValue code) => {
    return JS.call(nok, JS.undefined(), code);
  });

  return JS.method1((JsValue _s, JsValue code) => {
    return JS.call(factoryLabel(self, effects, referenceFullAfter, referenceFullMissing, tReference, tReferenceMarker, tReferenceString), JS.undefined(), code);
  });
});

JsValue tokenizeReferenceCollapsed = JS.method3((JsValue _self, JsValue effects, JsValue ok, JsValue nok) => {
  JsValue referenceCollapsedOpen = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cRightSquareBracket)) {
      JS.invoke(effects, "enter", tReferenceMarker);
      JS.invoke(effects, "consume", code);
      JS.invoke(effects, "exit", tReferenceMarker);
      JS.invoke(effects, "exit", tReference);
      return ok;
    }
    return JS.call(nok, JS.undefined(), code);
  });

  return JS.method1((JsValue _s, JsValue code) => {
    JS.invoke(effects, "enter", tReference);
    JS.invoke(effects, "enter", tReferenceMarker);
    JS.invoke(effects, "consume", code);
    JS.invoke(effects, "exit", tReferenceMarker);
    return referenceCollapsedOpen;
  });
});

JsValue resourceConstruct = JS.object("tokenize", tokenizeResource);
JsValue referenceFullConstruct = JS.object("tokenize", tokenizeReferenceFull);
JsValue referenceCollapsedConstruct = JS.object("tokenize", tokenizeReferenceCollapsed);

JsValue tokenizeLabelEnd = JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
  float index = JS.get(self, "events").length;
  JsValue labelStart = JS.undefined();
  JsValue defined = JS.undefined();
  while (true) {
    index--;
    if (index < 0.0) {
      break;
    }
    JsValue token = JS.get(self, "events")[index][1];
    if ((JS.strictEqual(JS.get(token, "type"), tLabelImage) || JS.strictEqual(JS.get(token, "type"), tLabelLink)) && !JS.get(token, "_balanced").truthy()) {
      labelStart = token;
      break;
    }
  }
  JsValue after = JS.undefined();
  JsValue referenceNotFull = JS.undefined();

  JsValue labelEndOk = JS.method1((JsValue _s, JsValue code) => {
    return JS.call(ok, JS.undefined(), code);
  });

  JsValue labelEndNok = JS.method1((JsValue _s, JsValue code) => {
    JS.set(labelStart, "_balanced", true);
    return JS.call(nok, JS.undefined(), code);
  });

  JsValue start = JS.method1((JsValue _s, JsValue code) => {
    if (!labelStart.truthy()) {
      return JS.call(nok, JS.undefined(), code);
    }
    if (JS.get(labelStart, "_inactive").truthy()) {
      return JS.call(labelEndNok, JS.undefined(), code);
    }
    defined = JS.invoke(JS.get(JS.get(self, "parser"), "defined"), "includes", normalizeIdentifier(JS.assume(JS.invoke(self, "sliceSerialize", JS.object("start", JS.get(labelStart, "end"), "end", JS.invoke(self, "now"))))));
    JS.invoke(effects, "enter", tLabelEnd);
    JS.invoke(effects, "enter", tLabelMarker);
    JS.invoke(effects, "consume", code);
    JS.invoke(effects, "exit", tLabelMarker);
    JS.invoke(effects, "exit", tLabelEnd);
    return after;
  });

  after = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cLeftParenthesis)) {
      return JS.call(JS.invoke(effects, "attempt", resourceConstruct, labelEndOk, if (defined.truthy()) { labelEndOk } else { labelEndNok }), JS.undefined(), code);
    }
    if (codeEq(code, cLeftSquareBracket)) {
      return JS.call(JS.invoke(effects, "attempt", referenceFullConstruct, labelEndOk, if (defined.truthy()) { referenceNotFull } else { labelEndNok }), JS.undefined(), code);
    }
    if (defined.truthy()) {
      return JS.call(labelEndOk, JS.undefined(), code);
    }
    return JS.call(labelEndNok, JS.undefined(), code);
  });

  referenceNotFull = JS.method1((JsValue _s, JsValue code) => {
    return JS.call(JS.invoke(effects, "attempt", referenceCollapsedConstruct, labelEndOk, labelEndNok), JS.undefined(), code);
  });

  return start;
});

export JsValue labelEnd = JS.object("name", "labelEnd", "resolveAll", resolveAllLabelEnd, "resolveTo", resolveToLabelEnd, "tokenize", tokenizeLabelEnd);
