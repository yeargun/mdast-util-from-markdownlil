import { asciiAlpha, asciiAlphanumeric, markdownLineEnding, markdownLineEndingOrSpace, markdownSpace } from "../util-character.lil";
import { htmlBlockNames, htmlRawNames } from "../util-html-tag-name.lil";
import { cColon, cDash, cDot, cExclamationMark, cGreaterThan, cLeftSquareBracket, cLessThan, cQuestionMark, cRightSquareBracket, cSlash, cUnderscore, codeEq } from "../symbol/codes.lil";
import { cApostrophe, cEqualsTo, cGraveAccent, cQuotationMark } from "../symbol/codes.lil";
import { kCdataOpeningString, kHtmlBasic, kHtmlCdata, kHtmlComment, kHtmlComplete, kHtmlDeclaration, kHtmlInstruction, kHtmlRaw, kHtmlRawSizeMax } from "../symbol/constants.lil";
import { tHtmlFlow, tHtmlFlowData, tLineEnding, tLinePrefix } from "../symbol/types.lil";
import { blankLine } from "./blank-line.lil";

extern JsValue String;

JsValue resolveToHtmlFlow = JS.method2((JsValue _self, JsValue events, JsValue _context) => {
  float index = events.length;
  while (true) {
    index--;
    if (index < 0.0 || (JS.strictEqual(events[index][0], "enter") && JS.strictEqual(JS.get(events[index][1], "type"), tHtmlFlow))) {
      break;
    }
  }
  if (index > 1.0 && JS.strictEqual(JS.get(events[index - 2.0][1], "type"), tLinePrefix)) {
    JS.set(events[index][1], "start", JS.get(events[index - 2.0][1], "start"));
    JS.set(events[index + 1.0][1], "start", JS.get(events[index - 2.0][1], "start"));
    JS.invoke(events, "splice", index - 2.0, 2);
  }
  return events;
});

JsValue tokenizeNonLazyContinuationStart = JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
  JsValue after = JS.method1((JsValue _s, JsValue code) => {
    if (JS.get(JS.get(self, "parser"), "lazy")[JS.get(JS.invoke(self, "now"), "line")].truthy()) {
      return JS.call(nok, JS.undefined(), code);
    }
    return JS.call(ok, JS.undefined(), code);
  });

  return JS.method1((JsValue _s, JsValue code) => {
    if (markdownLineEnding(code)) {
      JS.invoke(effects, "enter", tLineEnding);
      JS.invoke(effects, "consume", code);
      JS.invoke(effects, "exit", tLineEnding);
      return after;
    }
    return JS.call(nok, JS.undefined(), code);
  });
});

JsValue nonLazyContinuationStart = JS.object("partial", true, "tokenize", tokenizeNonLazyContinuationStart);

JsValue tokenizeBlankLineBefore = JS.method3((JsValue _self, JsValue effects, JsValue ok, JsValue nok) => {
  return JS.method1((JsValue _s, JsValue code) => {
    JS.invoke(effects, "enter", tLineEnding);
    JS.invoke(effects, "consume", code);
    JS.invoke(effects, "exit", tLineEnding);
    return JS.invoke(effects, "attempt", blankLine, ok, nok);
  });
});

JsValue blankLineBefore = JS.object("partial", true, "tokenize", tokenizeBlankLineBefore);

JsValue tokenizeHtmlFlow = JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
  float marker = 0.0;
  bool closingTag = false;
  string buffer = "";
  float index = 0.0;
  JsValue markerB = JS.undefined();
  JsValue open = JS.undefined();
  JsValue declarationOpen = JS.undefined();
  JsValue commentOpenInside = JS.undefined();
  JsValue cdataOpenInside = JS.undefined();
  JsValue tagCloseStart = JS.undefined();
  JsValue tagName = JS.undefined();
  JsValue basicSelfClosing = JS.undefined();
  JsValue completeClosingTagAfter = JS.undefined();
  JsValue completeAttributeNameBefore = JS.undefined();
  JsValue completeAttributeName = JS.undefined();
  JsValue completeAttributeNameAfter = JS.undefined();
  JsValue completeAttributeValueBefore = JS.undefined();
  JsValue completeAttributeValueQuoted = JS.undefined();
  JsValue completeAttributeValueUnquoted = JS.undefined();
  JsValue completeAttributeValueQuotedAfter = JS.undefined();
  JsValue completeEnd = JS.undefined();
  JsValue completeAfter = JS.undefined();
  JsValue continuation = JS.undefined();
  JsValue continuationStart = JS.undefined();
  JsValue continuationStartNonLazy = JS.undefined();
  JsValue continuationBefore = JS.undefined();
  JsValue continuationCommentInside = JS.undefined();
  JsValue continuationRawTagOpen = JS.undefined();
  JsValue continuationRawEndTag = JS.undefined();
  JsValue continuationCdataInside = JS.undefined();
  JsValue continuationDeclarationInside = JS.undefined();
  JsValue continuationClose = JS.undefined();
  JsValue continuationAfter = JS.undefined();

  auto consume = (JsValue code) => {
    JS.invoke(effects, "consume", code);
  };

  JsValue start = JS.method1((JsValue _s, JsValue code) => {
    JS.invoke(effects, "enter", tHtmlFlow);
    JS.invoke(effects, "enter", tHtmlFlowData);
    consume(code);
    return open;
  });

  open = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cExclamationMark)) {
      consume(code);
      return declarationOpen;
    }
    if (codeEq(code, cSlash)) {
      consume(code);
      closingTag = true;
      return tagCloseStart;
    }
    if (codeEq(code, cQuestionMark)) {
      consume(code);
      marker = kHtmlInstruction;
      return if (JS.get(self, "interrupt").truthy()) { ok } else { continuationDeclarationInside };
    }
    if (asciiAlpha(code)) {
      consume(code);
      buffer = JS.assume(JS.invoke(String, "fromCharCode", code));
      return tagName;
    }
    return JS.call(nok, JS.undefined(), code);
  });

  declarationOpen = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cDash)) {
      consume(code);
      marker = kHtmlComment;
      return commentOpenInside;
    }
    if (codeEq(code, cLeftSquareBracket)) {
      consume(code);
      marker = kHtmlCdata;
      index = 0;
      return cdataOpenInside;
    }
    if (asciiAlpha(code)) {
      consume(code);
      marker = kHtmlDeclaration;
      return if (JS.get(self, "interrupt").truthy()) { ok } else { continuationDeclarationInside };
    }
    return JS.call(nok, JS.undefined(), code);
  });

  commentOpenInside = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cDash)) {
      consume(code);
      return if (JS.get(self, "interrupt").truthy()) { ok } else { continuationDeclarationInside };
    }
    return JS.call(nok, JS.undefined(), code);
  });

  cdataOpenInside = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, JS.invoke(kCdataOpeningString, "charCodeAt", index))) {
      index++;
      consume(code);
      if (index == kCdataOpeningString.length) {
        return if (JS.get(self, "interrupt").truthy()) { ok } else { continuation };
      }
      return cdataOpenInside;
    }
    return JS.call(nok, JS.undefined(), code);
  });

  tagCloseStart = JS.method1((JsValue _s, JsValue code) => {
    if (asciiAlpha(code)) {
      consume(code);
      buffer = JS.assume(JS.invoke(String, "fromCharCode", code));
      return tagName;
    }
    return JS.call(nok, JS.undefined(), code);
  });

  tagName = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null) || codeEq(code, cSlash) || codeEq(code, cGreaterThan) || markdownLineEndingOrSpace(code)) {
      bool slash = codeEq(code, cSlash);
      string name = buffer.toLowerCase();
      if (!slash && !closingTag && htmlRawNames.includes(name)) {
        marker = kHtmlRaw;
        if (JS.get(self, "interrupt").truthy()) {
          return JS.call(ok, JS.undefined(), code);
        }
        return JS.call(continuation, JS.undefined(), code);
      }
      if (htmlBlockNames.includes(name)) {
        marker = kHtmlBasic;
        if (slash) {
          consume(code);
          return basicSelfClosing;
        }
        if (JS.get(self, "interrupt").truthy()) {
          return JS.call(ok, JS.undefined(), code);
        }
        return JS.call(continuation, JS.undefined(), code);
      }
      marker = kHtmlComplete;
      if (JS.get(self, "interrupt").truthy() && !JS.get(JS.get(self, "parser"), "lazy")[JS.get(JS.invoke(self, "now"), "line")].truthy()) {
        return JS.call(nok, JS.undefined(), code);
      }
      if (closingTag) {
        return JS.call(completeClosingTagAfter, JS.undefined(), code);
      }
      return JS.call(completeAttributeNameBefore, JS.undefined(), code);
    }
    if (codeEq(code, cDash) || asciiAlphanumeric(code)) {
      consume(code);
      buffer += JS.assume(JS.invoke(String, "fromCharCode", code));
      return tagName;
    }
    return JS.call(nok, JS.undefined(), code);
  });

  basicSelfClosing = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cGreaterThan)) {
      consume(code);
      return if (JS.get(self, "interrupt").truthy()) { ok } else { continuation };
    }
    return JS.call(nok, JS.undefined(), code);
  });

  completeClosingTagAfter = JS.method1((JsValue _s, JsValue code) => {
    if (markdownSpace(code)) {
      consume(code);
      return completeClosingTagAfter;
    }
    return JS.call(completeEnd, JS.undefined(), code);
  });

  completeAttributeNameBefore = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cSlash)) {
      consume(code);
      return completeEnd;
    }
    if (codeEq(code, cColon) || codeEq(code, cUnderscore) || asciiAlpha(code)) {
      consume(code);
      return completeAttributeName;
    }
    if (markdownSpace(code)) {
      consume(code);
      return completeAttributeNameBefore;
    }
    return JS.call(completeEnd, JS.undefined(), code);
  });

  completeAttributeName = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cDash) || codeEq(code, cDot) || codeEq(code, cColon) || codeEq(code, cUnderscore) || asciiAlphanumeric(code)) {
      consume(code);
      return completeAttributeName;
    }
    return JS.call(completeAttributeNameAfter, JS.undefined(), code);
  });

  completeAttributeNameAfter = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cEqualsTo)) {
      consume(code);
      return completeAttributeValueBefore;
    }
    if (markdownSpace(code)) {
      consume(code);
      return completeAttributeNameAfter;
    }
    return JS.call(completeAttributeNameBefore, JS.undefined(), code);
  });

  completeAttributeValueBefore = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null) || codeEq(code, cLessThan) || codeEq(code, cEqualsTo) || codeEq(code, cGreaterThan) || codeEq(code, cGraveAccent)) {
      return JS.call(nok, JS.undefined(), code);
    }
    if (codeEq(code, cQuotationMark) || codeEq(code, cApostrophe)) {
      consume(code);
      markerB = code;
      return completeAttributeValueQuoted;
    }
    if (markdownSpace(code)) {
      consume(code);
      return completeAttributeValueBefore;
    }
    return JS.call(completeAttributeValueUnquoted, JS.undefined(), code);
  });

  completeAttributeValueQuoted = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, markerB)) {
      consume(code);
      markerB = null;
      return completeAttributeValueQuotedAfter;
    }
    if (JS.strictEqual(code, null) || markdownLineEnding(code)) {
      return JS.call(nok, JS.undefined(), code);
    }
    consume(code);
    return completeAttributeValueQuoted;
  });

  completeAttributeValueUnquoted = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null) || codeEq(code, cQuotationMark) || codeEq(code, cApostrophe) || codeEq(code, cSlash) || codeEq(code, cLessThan) || codeEq(code, cEqualsTo) || codeEq(code, cGreaterThan) || codeEq(code, cGraveAccent) || markdownLineEndingOrSpace(code)) {
      return JS.call(completeAttributeNameAfter, JS.undefined(), code);
    }
    consume(code);
    return completeAttributeValueUnquoted;
  });

  completeAttributeValueQuotedAfter = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cSlash) || codeEq(code, cGreaterThan) || markdownSpace(code)) {
      return JS.call(completeAttributeNameBefore, JS.undefined(), code);
    }
    return JS.call(nok, JS.undefined(), code);
  });

  completeEnd = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cGreaterThan)) {
      consume(code);
      return completeAfter;
    }
    return JS.call(nok, JS.undefined(), code);
  });

  completeAfter = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null) || markdownLineEnding(code)) {
      return JS.call(continuation, JS.undefined(), code);
    }
    if (markdownSpace(code)) {
      consume(code);
      return completeAfter;
    }
    return JS.call(nok, JS.undefined(), code);
  });

  continuation = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cDash) && marker == kHtmlComment) {
      consume(code);
      return continuationCommentInside;
    }
    if (codeEq(code, cLessThan) && marker == kHtmlRaw) {
      consume(code);
      return continuationRawTagOpen;
    }
    if (codeEq(code, cGreaterThan) && marker == kHtmlDeclaration) {
      consume(code);
      return continuationClose;
    }
    if (codeEq(code, cQuestionMark) && marker == kHtmlInstruction) {
      consume(code);
      return continuationDeclarationInside;
    }
    if (codeEq(code, cRightSquareBracket) && marker == kHtmlCdata) {
      consume(code);
      return continuationCdataInside;
    }
    if (markdownLineEnding(code) && (marker == kHtmlBasic || marker == kHtmlComplete)) {
      JS.invoke(effects, "exit", tHtmlFlowData);
      return JS.call(JS.invoke(effects, "check", blankLineBefore, continuationAfter, continuationStart), JS.undefined(), code);
    }
    if (JS.strictEqual(code, null) || markdownLineEnding(code)) {
      JS.invoke(effects, "exit", tHtmlFlowData);
      return JS.call(continuationStart, JS.undefined(), code);
    }
    consume(code);
    return continuation;
  });

  continuationStart = JS.method1((JsValue _s, JsValue code) => {
    return JS.call(JS.invoke(effects, "check", nonLazyContinuationStart, continuationStartNonLazy, continuationAfter), JS.undefined(), code);
  });

  continuationStartNonLazy = JS.method1((JsValue _s, JsValue code) => {
    JS.invoke(effects, "enter", tLineEnding);
    consume(code);
    JS.invoke(effects, "exit", tLineEnding);
    return continuationBefore;
  });

  continuationBefore = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null) || markdownLineEnding(code)) {
      return JS.call(continuationStart, JS.undefined(), code);
    }
    JS.invoke(effects, "enter", tHtmlFlowData);
    return JS.call(continuation, JS.undefined(), code);
  });

  continuationCommentInside = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cDash)) {
      consume(code);
      return continuationDeclarationInside;
    }
    return JS.call(continuation, JS.undefined(), code);
  });

  continuationRawTagOpen = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cSlash)) {
      consume(code);
      buffer = "";
      return continuationRawEndTag;
    }
    return JS.call(continuation, JS.undefined(), code);
  });

  continuationRawEndTag = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cGreaterThan)) {
      if (htmlRawNames.includes(buffer.toLowerCase())) {
        consume(code);
        return continuationClose;
      }
      return JS.call(continuation, JS.undefined(), code);
    }
    if (asciiAlpha(code) && buffer.length < kHtmlRawSizeMax) {
      consume(code);
      buffer += JS.assume(JS.invoke(String, "fromCharCode", code));
      return continuationRawEndTag;
    }
    return JS.call(continuation, JS.undefined(), code);
  });

  continuationCdataInside = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cRightSquareBracket)) {
      consume(code);
      return continuationDeclarationInside;
    }
    return JS.call(continuation, JS.undefined(), code);
  });

  continuationDeclarationInside = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cGreaterThan)) {
      consume(code);
      return continuationClose;
    }
    if (codeEq(code, cDash) && marker == kHtmlComment) {
      consume(code);
      return continuationDeclarationInside;
    }
    return JS.call(continuation, JS.undefined(), code);
  });

  continuationClose = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null) || markdownLineEnding(code)) {
      JS.invoke(effects, "exit", tHtmlFlowData);
      return JS.call(continuationAfter, JS.undefined(), code);
    }
    consume(code);
    return continuationClose;
  });

  continuationAfter = JS.method1((JsValue _s, JsValue code) => {
    JS.invoke(effects, "exit", tHtmlFlow);
    return JS.call(ok, JS.undefined(), code);
  });

  return start;
});

export JsValue htmlFlow = JS.object("concrete", true, "name", "htmlFlow", "resolveTo", resolveToHtmlFlow, "tokenize", tokenizeHtmlFlow);
