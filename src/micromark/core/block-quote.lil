import { factorySpace } from "../factory-space.lil";
import { markdownSpace } from "../util-character.lil";
import { cGreaterThan, codeEq } from "../symbol/codes.lil";
import { kTabSize } from "../symbol/constants.lil";
import { tBlockQuote, tBlockQuoteMarker, tBlockQuotePrefix, tBlockQuotePrefixWhitespace, tLinePrefix } from "../symbol/types.lil";

JsValue tokenizeBlockQuoteStart = JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
  JsValue after = JS.method1((JsValue _s, JsValue code) => {
    if (markdownSpace(code)) {
      JS.invoke(effects, "enter", tBlockQuotePrefixWhitespace);
      JS.invoke(effects, "consume", code);
      JS.invoke(effects, "exit", tBlockQuotePrefixWhitespace);
      JS.invoke(effects, "exit", tBlockQuotePrefix);
      return ok;
    }
    JS.invoke(effects, "exit", tBlockQuotePrefix);
    return JS.call(ok, JS.undefined(), code);
  });

  return JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cGreaterThan)) {
      JsValue state = JS.get(self, "containerState");
      if (!JS.get(state, "open").truthy()) {
        JS.invoke(effects, "enter", tBlockQuote, JS.object("_container", true));
        JS.set(state, "open", true);
      }
      JS.invoke(effects, "enter", tBlockQuotePrefix);
      JS.invoke(effects, "enter", tBlockQuoteMarker);
      JS.invoke(effects, "consume", code);
      JS.invoke(effects, "exit", tBlockQuoteMarker);
      return after;
    }
    return JS.call(nok, JS.undefined(), code);
  });
});

JsValue exitBlockQuote = JS.method1((JsValue _self, JsValue effects) => {
  JS.invoke(effects, "exit", tBlockQuote);
  return JS.undefined();
});

// The continuation tokenizer attempts `blockQuote` itself, so it is written
// inside the construct's own initializer.
export JsValue blockQuote = JS.object(
  "continuation", JS.object("tokenize", JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
    JsValue contBefore = JS.method1((JsValue _s, JsValue code) => {
      return JS.call(JS.invoke(effects, "attempt", blockQuote, ok, nok), JS.undefined(), code);
    });

    return JS.method1((JsValue _s, JsValue code) => {
      if (markdownSpace(code)) {
        JsValue max = if (JS.invoke(JS.get(JS.get(JS.get(self, "parser"), "constructs"), "disable")["null"], "includes", "codeIndented").truthy()) { JS.undefined() } else { kTabSize };
        return JS.call(factorySpace(effects, contBefore, tLinePrefix, max), JS.undefined(), code);
      }
      return JS.call(contBefore, JS.undefined(), code);
    });
  })),
  "exit", exitBlockQuote,
  "name", "blockQuote",
  "tokenize", tokenizeBlockQuoteStart
);
