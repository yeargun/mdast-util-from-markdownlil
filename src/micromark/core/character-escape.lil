import { asciiPunctuation } from "../util-character.lil";
import { tCharacterEscape, tCharacterEscapeValue, tEscapeMarker } from "../symbol/types.lil";

JsValue tokenizeCharacterEscape = JS.method3((JsValue _self, JsValue effects, JsValue ok, JsValue nok) => {
  JsValue inside = JS.method1((JsValue _s, JsValue code) => {
    if (asciiPunctuation(code)) {
      JS.invoke(effects, "enter", tCharacterEscapeValue);
      JS.invoke(effects, "consume", code);
      JS.invoke(effects, "exit", tCharacterEscapeValue);
      JS.invoke(effects, "exit", tCharacterEscape);
      return ok;
    }
    return JS.call(nok, JS.undefined(), code);
  });

  return JS.method1((JsValue _s, JsValue code) => {
    JS.invoke(effects, "enter", tCharacterEscape);
    JS.invoke(effects, "enter", tEscapeMarker);
    JS.invoke(effects, "consume", code);
    JS.invoke(effects, "exit", tEscapeMarker);
    return inside;
  });
});

export JsValue characterEscape = JS.object("name", "characterEscape", "tokenize", tokenizeCharacterEscape);
