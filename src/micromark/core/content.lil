import { factorySpace } from "../factory-space.lil";
import { markdownLineEnding } from "../util-character.lil";
import { subtokenize } from "../util-subtokenize.lil";
import { kContentTypeContent, kTabSize } from "../symbol/constants.lil";
import { tChunkContent, tContent, tLineEnding, tLinePrefix } from "../symbol/types.lil";

JsValue resolveContent = JS.method2((JsValue _self, JsValue events, JsValue _context) => {
  subtokenize(events);
  return events;
});

JsValue tokenizeContinuation = JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
  JsValue prefixed = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null) || markdownLineEnding(code)) {
      return JS.call(nok, JS.undefined(), code);
    }
    JsValue tail = JS.get(self, "events")[JS.get(self, "events").length - 1.0];
    if (!JS.invoke(JS.get(JS.get(JS.get(self, "parser"), "constructs"), "disable")["null"], "includes", "codeIndented").truthy() && tail.truthy() && JS.strictEqual(JS.get(tail[1], "type"), tLinePrefix) && JS.invoke(tail[2], "sliceSerialize", tail[1], true).length >= kTabSize) {
      return JS.call(ok, JS.undefined(), code);
    }
    return JS.call(JS.invoke(effects, "interrupt", JS.get(JS.get(JS.get(self, "parser"), "constructs"), "flow"), nok, ok), JS.undefined(), code);
  });

  return JS.method1((JsValue _s, JsValue code) => {
    JS.invoke(effects, "exit", tChunkContent);
    JS.invoke(effects, "enter", tLineEnding);
    JS.invoke(effects, "consume", code);
    JS.invoke(effects, "exit", tLineEnding);
    return factorySpace(effects, prefixed, tLinePrefix, JS.undefined());
  });
});

JsValue continuationConstruct = JS.object("partial", true, "tokenize", tokenizeContinuation);

JsValue tokenizeContent = JS.method3((JsValue _self, JsValue effects, JsValue ok, JsValue _nok) => {
  JsValue previous = JS.undefined();
  JsValue chunkInside = JS.undefined();
  JsValue contentEnd = JS.undefined();
  JsValue contentContinue = JS.undefined();

  JsValue chunkStart = JS.method1((JsValue _s, JsValue code) => {
    JS.invoke(effects, "enter", tContent);
    previous = JS.invoke(effects, "enter", tChunkContent, JS.object("contentType", kContentTypeContent));
    return JS.call(chunkInside, JS.undefined(), code);
  });

  chunkInside = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null)) {
      return JS.call(contentEnd, JS.undefined(), code);
    }
    if (markdownLineEnding(code)) {
      return JS.call(JS.invoke(effects, "check", continuationConstruct, contentContinue, contentEnd), JS.undefined(), code);
    }
    JS.invoke(effects, "consume", code);
    return chunkInside;
  });

  contentEnd = JS.method1((JsValue _s, JsValue code) => {
    JS.invoke(effects, "exit", tChunkContent);
    JS.invoke(effects, "exit", tContent);
    return JS.call(ok, JS.undefined(), code);
  });

  contentContinue = JS.method1((JsValue _s, JsValue code) => {
    JS.invoke(effects, "consume", code);
    JS.invoke(effects, "exit", tChunkContent);
    JS.set(previous, "next", JS.invoke(effects, "enter", tChunkContent, JS.object("contentType", kContentTypeContent, "previous", previous)));
    previous = JS.get(previous, "next");
    return chunkInside;
  });

  return chunkStart;
});

export JsValue content = JS.object("resolve", resolveContent, "tokenize", tokenizeContent);
