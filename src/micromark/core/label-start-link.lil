import { cCaret, codeEq } from "../symbol/codes.lil";
import { tLabelLink, tLabelMarker } from "../symbol/types.lil";
import { labelEnd } from "./label-end.lil";

JsValue tokenizeLabelStartLink = JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
  JsValue after = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cCaret) && JS.in("_hiddenFootnoteSupport", JS.get(JS.get(self, "parser"), "constructs"))) {
      return JS.call(nok, JS.undefined(), code);
    }
    return JS.call(ok, JS.undefined(), code);
  });

  return JS.method1((JsValue _s, JsValue code) => {
    JS.invoke(effects, "enter", tLabelLink);
    JS.invoke(effects, "enter", tLabelMarker);
    JS.invoke(effects, "consume", code);
    JS.invoke(effects, "exit", tLabelMarker);
    JS.invoke(effects, "exit", tLabelLink);
    return after;
  });
});

export JsValue labelStartLink = JS.object("name", "labelStartLink", "resolveAll", JS.get(labelEnd, "resolveAll"), "tokenize", tokenizeLabelStartLink);
