import { factorySpace } from "../factory-space.lil";
import { asciiAlpha, asciiAlphanumeric, markdownLineEnding, markdownLineEndingOrSpace, markdownSpace } from "../util-character.lil";
import { cApostrophe, cColon, cDash, cDot, cEqualsTo, cExclamationMark, cGraveAccent, cGreaterThan, cLeftSquareBracket, cLessThan, cQuestionMark, cQuotationMark, cRightSquareBracket, cSlash, cUnderscore, codeEq } from "../symbol/codes.lil";
import { kCdataOpeningString, kTabSize } from "../symbol/constants.lil";
import { tHtmlText, tHtmlTextData, tLineEnding, tLinePrefix } from "../symbol/types.lil";

JsValue tokenizeHtmlText = JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
  JsValue marker = JS.undefined();
  float index = 0.0;
  JsValue returnState = JS.undefined();
  JsValue open = JS.undefined();
  JsValue declarationOpen = JS.undefined();
  JsValue commentOpenInside = JS.undefined();
  JsValue comment = JS.undefined();
  JsValue commentClose = JS.undefined();
  JsValue commentEnd = JS.undefined();
  JsValue cdataOpenInside = JS.undefined();
  JsValue cdata = JS.undefined();
  JsValue cdataClose = JS.undefined();
  JsValue cdataEnd = JS.undefined();
  JsValue declaration = JS.undefined();
  JsValue instruction = JS.undefined();
  JsValue instructionClose = JS.undefined();
  JsValue tagCloseStart = JS.undefined();
  JsValue tagClose = JS.undefined();
  JsValue tagCloseBetween = JS.undefined();
  JsValue tagOpen = JS.undefined();
  JsValue tagOpenBetween = JS.undefined();
  JsValue tagOpenAttributeName = JS.undefined();
  JsValue tagOpenAttributeNameAfter = JS.undefined();
  JsValue tagOpenAttributeValueBefore = JS.undefined();
  JsValue tagOpenAttributeValueQuoted = JS.undefined();
  JsValue tagOpenAttributeValueUnquoted = JS.undefined();
  JsValue tagOpenAttributeValueQuotedAfter = JS.undefined();
  JsValue end = JS.undefined();
  JsValue lineEndingBefore = JS.undefined();
  JsValue lineEndingAfter = JS.undefined();
  JsValue lineEndingAfterPrefix = JS.undefined();

  auto consume = (JsValue code) => {
    JS.invoke(effects, "consume", code);
  };

  JsValue start = JS.method1((JsValue _s, JsValue code) => {
    JS.invoke(effects, "enter", tHtmlText);
    JS.invoke(effects, "enter", tHtmlTextData);
    consume(code);
    return open;
  });

  open = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cExclamationMark)) {
      consume(code);
      return declarationOpen;
    }
    if (codeEq(code, cSlash)) {
      consume(code);
      return tagCloseStart;
    }
    if (codeEq(code, cQuestionMark)) {
      consume(code);
      return instruction;
    }
    if (asciiAlpha(code)) {
      consume(code);
      return tagOpen;
    }
    return JS.call(nok, JS.undefined(), code);
  });

  declarationOpen = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cDash)) {
      consume(code);
      return commentOpenInside;
    }
    if (codeEq(code, cLeftSquareBracket)) {
      consume(code);
      index = 0;
      return cdataOpenInside;
    }
    if (asciiAlpha(code)) {
      consume(code);
      return declaration;
    }
    return JS.call(nok, JS.undefined(), code);
  });

  commentOpenInside = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cDash)) {
      consume(code);
      return commentEnd;
    }
    return JS.call(nok, JS.undefined(), code);
  });

  comment = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null)) {
      return JS.call(nok, JS.undefined(), code);
    }
    if (codeEq(code, cDash)) {
      consume(code);
      return commentClose;
    }
    if (markdownLineEnding(code)) {
      returnState = comment;
      return JS.call(lineEndingBefore, JS.undefined(), code);
    }
    consume(code);
    return comment;
  });

  commentClose = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cDash)) {
      consume(code);
      return commentEnd;
    }
    return JS.call(comment, JS.undefined(), code);
  });

  commentEnd = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cGreaterThan)) {
      return JS.call(end, JS.undefined(), code);
    }
    if (codeEq(code, cDash)) {
      return JS.call(commentClose, JS.undefined(), code);
    }
    return JS.call(comment, JS.undefined(), code);
  });

  cdataOpenInside = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, JS.invoke(kCdataOpeningString, "charCodeAt", index))) {
      index++;
      consume(code);
      return if (index == kCdataOpeningString.length) { cdata } else { cdataOpenInside };
    }
    return JS.call(nok, JS.undefined(), code);
  });

  cdata = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null)) {
      return JS.call(nok, JS.undefined(), code);
    }
    if (codeEq(code, cRightSquareBracket)) {
      consume(code);
      return cdataClose;
    }
    if (markdownLineEnding(code)) {
      returnState = cdata;
      return JS.call(lineEndingBefore, JS.undefined(), code);
    }
    consume(code);
    return cdata;
  });

  cdataClose = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cRightSquareBracket)) {
      consume(code);
      return cdataEnd;
    }
    return JS.call(cdata, JS.undefined(), code);
  });

  cdataEnd = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cGreaterThan)) {
      return JS.call(end, JS.undefined(), code);
    }
    if (codeEq(code, cRightSquareBracket)) {
      consume(code);
      return cdataEnd;
    }
    return JS.call(cdata, JS.undefined(), code);
  });

  declaration = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null) || codeEq(code, cGreaterThan)) {
      return JS.call(end, JS.undefined(), code);
    }
    if (markdownLineEnding(code)) {
      returnState = declaration;
      return JS.call(lineEndingBefore, JS.undefined(), code);
    }
    consume(code);
    return declaration;
  });

  instruction = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null)) {
      return JS.call(nok, JS.undefined(), code);
    }
    if (codeEq(code, cQuestionMark)) {
      consume(code);
      return instructionClose;
    }
    if (markdownLineEnding(code)) {
      returnState = instruction;
      return JS.call(lineEndingBefore, JS.undefined(), code);
    }
    consume(code);
    return instruction;
  });

  instructionClose = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cGreaterThan)) {
      return JS.call(end, JS.undefined(), code);
    }
    return JS.call(instruction, JS.undefined(), code);
  });

  tagCloseStart = JS.method1((JsValue _s, JsValue code) => {
    if (asciiAlpha(code)) {
      consume(code);
      return tagClose;
    }
    return JS.call(nok, JS.undefined(), code);
  });

  tagClose = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cDash) || asciiAlphanumeric(code)) {
      consume(code);
      return tagClose;
    }
    return JS.call(tagCloseBetween, JS.undefined(), code);
  });

  tagCloseBetween = JS.method1((JsValue _s, JsValue code) => {
    if (markdownLineEnding(code)) {
      returnState = tagCloseBetween;
      return JS.call(lineEndingBefore, JS.undefined(), code);
    }
    if (markdownSpace(code)) {
      consume(code);
      return tagCloseBetween;
    }
    return JS.call(end, JS.undefined(), code);
  });

  tagOpen = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cDash) || asciiAlphanumeric(code)) {
      consume(code);
      return tagOpen;
    }
    if (codeEq(code, cSlash) || codeEq(code, cGreaterThan) || markdownLineEndingOrSpace(code)) {
      return JS.call(tagOpenBetween, JS.undefined(), code);
    }
    return JS.call(nok, JS.undefined(), code);
  });

  tagOpenBetween = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cSlash)) {
      consume(code);
      return end;
    }
    if (codeEq(code, cColon) || codeEq(code, cUnderscore) || asciiAlpha(code)) {
      consume(code);
      return tagOpenAttributeName;
    }
    if (markdownLineEnding(code)) {
      returnState = tagOpenBetween;
      return JS.call(lineEndingBefore, JS.undefined(), code);
    }
    if (markdownSpace(code)) {
      consume(code);
      return tagOpenBetween;
    }
    return JS.call(end, JS.undefined(), code);
  });

  tagOpenAttributeName = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cDash) || codeEq(code, cDot) || codeEq(code, cColon) || codeEq(code, cUnderscore) || asciiAlphanumeric(code)) {
      consume(code);
      return tagOpenAttributeName;
    }
    return JS.call(tagOpenAttributeNameAfter, JS.undefined(), code);
  });

  tagOpenAttributeNameAfter = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cEqualsTo)) {
      consume(code);
      return tagOpenAttributeValueBefore;
    }
    if (markdownLineEnding(code)) {
      returnState = tagOpenAttributeNameAfter;
      return JS.call(lineEndingBefore, JS.undefined(), code);
    }
    if (markdownSpace(code)) {
      consume(code);
      return tagOpenAttributeNameAfter;
    }
    return JS.call(tagOpenBetween, JS.undefined(), code);
  });

  tagOpenAttributeValueBefore = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null) || codeEq(code, cLessThan) || codeEq(code, cEqualsTo) || codeEq(code, cGreaterThan) || codeEq(code, cGraveAccent)) {
      return JS.call(nok, JS.undefined(), code);
    }
    if (codeEq(code, cQuotationMark) || codeEq(code, cApostrophe)) {
      consume(code);
      marker = code;
      return tagOpenAttributeValueQuoted;
    }
    if (markdownLineEnding(code)) {
      returnState = tagOpenAttributeValueBefore;
      return JS.call(lineEndingBefore, JS.undefined(), code);
    }
    if (markdownSpace(code)) {
      consume(code);
      return tagOpenAttributeValueBefore;
    }
    consume(code);
    return tagOpenAttributeValueUnquoted;
  });

  tagOpenAttributeValueQuoted = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, marker)) {
      consume(code);
      marker = JS.undefined();
      return tagOpenAttributeValueQuotedAfter;
    }
    if (JS.strictEqual(code, null)) {
      return JS.call(nok, JS.undefined(), code);
    }
    if (markdownLineEnding(code)) {
      returnState = tagOpenAttributeValueQuoted;
      return JS.call(lineEndingBefore, JS.undefined(), code);
    }
    consume(code);
    return tagOpenAttributeValueQuoted;
  });

  tagOpenAttributeValueUnquoted = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null) || codeEq(code, cQuotationMark) || codeEq(code, cApostrophe) || codeEq(code, cLessThan) || codeEq(code, cEqualsTo) || codeEq(code, cGraveAccent)) {
      return JS.call(nok, JS.undefined(), code);
    }
    if (codeEq(code, cSlash) || codeEq(code, cGreaterThan) || markdownLineEndingOrSpace(code)) {
      return JS.call(tagOpenBetween, JS.undefined(), code);
    }
    consume(code);
    return tagOpenAttributeValueUnquoted;
  });

  tagOpenAttributeValueQuotedAfter = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cSlash) || codeEq(code, cGreaterThan) || markdownLineEndingOrSpace(code)) {
      return JS.call(tagOpenBetween, JS.undefined(), code);
    }
    return JS.call(nok, JS.undefined(), code);
  });

  end = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cGreaterThan)) {
      consume(code);
      JS.invoke(effects, "exit", tHtmlTextData);
      JS.invoke(effects, "exit", tHtmlText);
      return ok;
    }
    return JS.call(nok, JS.undefined(), code);
  });

  lineEndingBefore = JS.method1((JsValue _s, JsValue code) => {
    JS.invoke(effects, "exit", tHtmlTextData);
    JS.invoke(effects, "enter", tLineEnding);
    consume(code);
    JS.invoke(effects, "exit", tLineEnding);
    return lineEndingAfter;
