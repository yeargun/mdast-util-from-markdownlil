  lineEndingAfter = JS.method1((JsValue _s, JsValue code) => {
    if (markdownSpace(code)) {
      JsValue max = if (JS.invoke(JS.get(JS.get(JS.get(self, "parser"), "constructs"), "disable")["null"], "includes", "codeIndented").truthy()) { JS.undefined() } else { kTabSize };
      return JS.call(factorySpace(effects, lineEndingAfterPrefix, tLinePrefix, max), JS.undefined(), code);
    }
    return JS.call(lineEndingAfterPrefix, JS.undefined(), code);
  });

  lineEndingAfterPrefix = JS.method1((JsValue _s, JsValue code) => {
    JS.invoke(effects, "enter", tHtmlTextData);
    return JS.call(returnState, JS.undefined(), code);
  });

