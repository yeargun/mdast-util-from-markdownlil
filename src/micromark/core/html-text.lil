import { call1, includesStr, isEof, makeNamedConstruct, objGet, undef } from "../host.lil";
import { factorySpace } from "../factory-space.lil";
import { asciiAlpha, asciiAlphanumeric, markdownLineEnding, markdownLineEndingOrSpace, markdownSpace } from "../util-character.lil";
import { cApostrophe, cColon, cDash, cDot, cEqualsTo, cExclamationMark, cGraveAccent, cGreaterThan, cLeftSquareBracket, cLessThan, cQuestionMark, cQuotationMark, cRightSquareBracket, cSlash, cUnderscore, codeEq, codeInt } from "../symbol/codes.lil";
import { kCdataOpeningString, kTabSize } from "../symbol/constants.lil";
import { tHtmlText, tHtmlTextData, tLineEnding, tLinePrefix } from "../symbol/types.lil";

JsValue tokenizeHtmlText = JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
  int marker = 0;
  int index = 0;
  JsValue returnState = undef();
  JsValue tagOpenBetween = undef();
  JsValue instructionClose = undef();
  JsValue cdataClose = undef();
  JsValue commentClose = undef();
  JsValue commentEnd = undef();

  JsValue consume = JS.method1((JsValue _s, JsValue code) => {
    call1(objGet(effects, "consume"), effects, code);
    return undef();
  });

  JsValue lineEndingAfterPrefix = JS.method1((JsValue _s, JsValue code) => {
    call1(objGet(effects, "enter"), effects, tHtmlTextData);
    return call1(returnState, undef(), code);
  });

  JsValue lineEndingAfter = JS.method1((JsValue _s, JsValue code) => {
    if (markdownSpace(code)) {
      float max = kTabSize;
      if (includesStr(objGet(objGet(objGet(self, "parser"), "constructs"), "disable")["null"], "codeIndented")) {
        max = 0;
      }
      return call1(factorySpace(effects, lineEndingAfterPrefix, tLinePrefix, max), undef(), code);
    }
    return call1(lineEndingAfterPrefix, undef(), code);
  });

  JsValue lineEndingBefore = JS.method1((JsValue _s, JsValue code) => {
    call1(objGet(effects, "exit"), effects, tHtmlTextData);
    call1(objGet(effects, "enter"), effects, tLineEnding);
    call1(consume, undef(), code);
    call1(objGet(effects, "exit"), effects, tLineEnding);
    return lineEndingAfter;
  });

  JsValue end = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cGreaterThan)) {
      call1(consume, undef(), code);
      call1(objGet(effects, "exit"), effects, tHtmlTextData);
      call1(objGet(effects, "exit"), effects, tHtmlText);
      return ok;
    }
    return call1(nok, undef(), code);
  });

  JsValue tagOpenAttributeValueQuotedAfter = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cSlash) || codeEq(code, cGreaterThan) || markdownLineEndingOrSpace(code)) {
      return call1(tagOpenBetween, undef(), code);
    }
    return call1(nok, undef(), code);
  });

  JsValue tagOpenAttributeValueUnquoted = JS.method1((JsValue _s, JsValue code) => {
    if (isEof(code) || codeEq(code, cQuotationMark) || codeEq(code, cApostrophe) || codeEq(code, cLessThan) || codeEq(code, cEqualsTo) || codeEq(code, cGraveAccent)) {
      return call1(nok, undef(), code);
    }
    if (codeEq(code, cSlash) || codeEq(code, cGreaterThan) || markdownLineEndingOrSpace(code)) {
      return call1(tagOpenBetween, undef(), code);
    }
    call1(consume, undef(), code);
    return tagOpenAttributeValueUnquoted;
  });

  JsValue tagOpenAttributeValueQuoted = JS.method1((JsValue _s, JsValue code) => {
    if (code == marker) {
      call1(consume, undef(), code);
      marker = 0;
      return tagOpenAttributeValueQuotedAfter;
    }
    if (isEof(code)) {
      return call1(nok, undef(), code);
    }
    if (markdownLineEnding(code)) {
      returnState = tagOpenAttributeValueQuoted;
      return call1(lineEndingBefore, undef(), code);
    }
    call1(consume, undef(), code);
    return tagOpenAttributeValueQuoted;
  });

  JsValue tagOpenAttributeValueBefore = JS.method1((JsValue _s, JsValue code) => {
    if (isEof(code) || codeEq(code, cLessThan) || codeEq(code, cEqualsTo) || codeEq(code, cGreaterThan) || codeEq(code, cGraveAccent)) {
      return call1(nok, undef(), code);
    }
    if (codeEq(code, cQuotationMark) || codeEq(code, cApostrophe)) {
      call1(consume, undef(), code);
      marker = JS.number(code).toInt();
      return tagOpenAttributeValueQuoted;
    }
    if (markdownLineEnding(code)) {
      returnState = tagOpenAttributeValueBefore;
      return call1(lineEndingBefore, undef(), code);
    }
    if (markdownSpace(code)) {
      call1(consume, undef(), code);
      return tagOpenAttributeValueBefore;
    }
    call1(consume, undef(), code);
    return tagOpenAttributeValueUnquoted;
  });

  JsValue tagOpenAttributeNameAfter = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cEqualsTo)) {
      call1(consume, undef(), code);
      return tagOpenAttributeValueBefore;
    }
    if (markdownLineEnding(code)) {
      returnState = tagOpenAttributeNameAfter;
      return call1(lineEndingBefore, undef(), code);
    }
    if (markdownSpace(code)) {
      call1(consume, undef(), code);
      return tagOpenAttributeNameAfter;
    }
    return call1(tagOpenBetween, undef(), code);
  });

  JsValue tagOpenAttributeName = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cDash) || codeEq(code, cDot) || codeEq(code, cColon) || codeEq(code, cUnderscore) || asciiAlphanumeric(code)) {
      call1(consume, undef(), code);
      return tagOpenAttributeName;
    }
    return call1(tagOpenAttributeNameAfter, undef(), code);
  });

  tagOpenBetween = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cSlash)) {
      call1(consume, undef(), code);
      return end;
    }
    if (codeEq(code, cColon) || codeEq(code, cUnderscore) || asciiAlpha(code)) {
      call1(consume, undef(), code);
      return tagOpenAttributeName;
    }
    if (markdownLineEnding(code)) {
      returnState = tagOpenBetween;
      return call1(lineEndingBefore, undef(), code);
    }
    if (markdownSpace(code)) {
      call1(consume, undef(), code);
      return tagOpenBetween;
    }
    return call1(end, undef(), code);
  });

  JsValue tagOpen = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cDash) || asciiAlphanumeric(code)) {
      call1(consume, undef(), code);
      return tagOpen;
    }
    if (codeEq(code, cSlash) || codeEq(code, cGreaterThan) || markdownLineEndingOrSpace(code)) {
      return call1(tagOpenBetween, undef(), code);
    }
    return call1(nok, undef(), code);
  });

  JsValue tagCloseBetween = JS.method1((JsValue _s, JsValue code) => {
    if (markdownLineEnding(code)) {
      returnState = tagCloseBetween;
      return call1(lineEndingBefore, undef(), code);
    }
    if (markdownSpace(code)) {
      call1(consume, undef(), code);
      return tagCloseBetween;
    }
    return call1(end, undef(), code);
  });

  JsValue tagClose = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cDash) || asciiAlphanumeric(code)) {
      call1(consume, undef(), code);
      return tagClose;
    }
    return call1(tagCloseBetween, undef(), code);
  });

  JsValue tagCloseStart = JS.method1((JsValue _s, JsValue code) => {
    if (asciiAlpha(code)) {
      call1(consume, undef(), code);
      return tagClose;
    }
    return call1(nok, undef(), code);
  });

  JsValue instruction = JS.method1((JsValue _s, JsValue code) => {
    if (isEof(code)) {
      return call1(nok, undef(), code);
    }
    if (codeEq(code, cQuestionMark)) {
      call1(consume, undef(), code);
      return instructionClose;
    }
    if (markdownLineEnding(code)) {
      returnState = instruction;
      return call1(lineEndingBefore, undef(), code);
    }
    call1(consume, undef(), code);
    return instruction;
  });

  instructionClose = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cGreaterThan)) {
      return call1(end, undef(), code);
    }
    return call1(instruction, undef(), code);
  });

  JsValue declaration = JS.method1((JsValue _s, JsValue code) => {
    if (isEof(code) || codeEq(code, cGreaterThan)) {
      return call1(end, undef(), code);
    }
    if (markdownLineEnding(code)) {
      returnState = declaration;
      return call1(lineEndingBefore, undef(), code);
    }
    call1(consume, undef(), code);
    return declaration;
  });

  JsValue cdata = JS.method1((JsValue _s, JsValue code) => {
    if (isEof(code)) {
      return call1(nok, undef(), code);
    }
    if (codeEq(code, cRightSquareBracket)) {
      call1(consume, undef(), code);
      return cdataClose;
    }
    if (markdownLineEnding(code)) {
      returnState = cdata;
      return call1(lineEndingBefore, undef(), code);
    }
    call1(consume, undef(), code);
    return cdata;
  });

  JsValue cdataEnd = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cGreaterThan)) {
      return call1(end, undef(), code);
    }
    if (codeEq(code, cRightSquareBracket)) {
      call1(consume, undef(), code);
      return cdataEnd;
    }
    return call1(cdata, undef(), code);
  });

  cdataClose = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cRightSquareBracket)) {
      call1(consume, undef(), code);
      return cdataEnd;
    }
    return call1(cdata, undef(), code);
  });

  JsValue cdataOpenInside = JS.method1((JsValue _s, JsValue code) => {
    int currentIndex = index;
    index = index + 1;
    if (!isEof(code) && codeInt(code) == kCdataOpeningString.charCodeAt(currentIndex)) {
      call1(consume, undef(), code);
      if (currentIndex + 1 == kCdataOpeningString.length) {
        return cdata;
      }
      return cdataOpenInside;
    }
    return call1(nok, undef(), code);
  });

  JsValue comment = JS.method1((JsValue _s, JsValue code) => {
    if (isEof(code)) {
      return call1(nok, undef(), code);
    }
    if (codeEq(code, cDash)) {
      call1(consume, undef(), code);
      return commentClose;
    }
    if (markdownLineEnding(code)) {
      returnState = comment;
      return call1(lineEndingBefore, undef(), code);
    }
    call1(consume, undef(), code);
    return comment;
  });

  commentClose = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cDash)) {
      call1(consume, undef(), code);
      return commentEnd;
    }
    return call1(comment, undef(), code);
  });

  commentEnd = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cGreaterThan)) {
      return call1(end, undef(), code);
    }
    if (codeEq(code, cDash)) {
      return call1(commentClose, undef(), code);
    }
    return call1(comment, undef(), code);
  });

  JsValue commentOpenInside = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cDash)) {
      call1(consume, undef(), code);
      return commentEnd;
    }
    return call1(nok, undef(), code);
  });

  JsValue declarationOpen = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cDash)) {
      call1(consume, undef(), code);
      return commentOpenInside;
    }
    if (codeEq(code, cLeftSquareBracket)) {
      call1(consume, undef(), code);
      index = 0;
      return cdataOpenInside;
    }
    if (asciiAlpha(code)) {
      call1(consume, undef(), code);
      return declaration;
    }
    return call1(nok, undef(), code);
  });

  JsValue open = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cExclamationMark)) {
      call1(consume, undef(), code);
      return declarationOpen;
    }
    if (codeEq(code, cSlash)) {
      call1(consume, undef(), code);
      return tagCloseStart;
    }
    if (codeEq(code, cQuestionMark)) {
      call1(consume, undef(), code);
      return instruction;
    }
    if (asciiAlpha(code)) {
      call1(consume, undef(), code);
      return tagOpen;
    }
    return call1(nok, undef(), code);
  });

  JsValue start = JS.method1((JsValue _s, JsValue code) => {
    call1(objGet(effects, "enter"), effects, tHtmlText);
    call1(objGet(effects, "enter"), effects, tHtmlTextData);
    call1(consume, undef(), code);
    return open;
  });

  return start;
});

export JsValue htmlText = makeNamedConstruct("htmlText", tokenizeHtmlText);
