import { decodeNamedCharacterReference } from "../decode-named.lil";
import { asciiAlphanumeric, asciiDigit, asciiHexDigit } from "../util-character.lil";
import { cLowercaseX, cNumberSign, cSemicolon, cUppercaseX, codeEq } from "../symbol/codes.lil";
import { kCharacterReferenceDecimalSizeMax, kCharacterReferenceHexadecimalSizeMax, kCharacterReferenceNamedSizeMax } from "../symbol/constants.lil";
import { tCharacterReference, tCharacterReferenceMarker, tCharacterReferenceMarkerHexadecimal, tCharacterReferenceMarkerNumeric, tCharacterReferenceValue } from "../symbol/types.lil";

JsValue tokenizeCharacterReference = JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
  float size = 0.0;
  float max = 0.0;
  func(JsValue)->bool test = asciiAlphanumeric;
  JsValue open = JS.undefined();
  JsValue numeric = JS.undefined();
  JsValue value = JS.undefined();

  JsValue start = JS.method1((JsValue _s, JsValue code) => {
    JS.invoke(effects, "enter", tCharacterReference);
    JS.invoke(effects, "enter", tCharacterReferenceMarker);
    JS.invoke(effects, "consume", code);
    JS.invoke(effects, "exit", tCharacterReferenceMarker);
    return open;
  });

  open = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cNumberSign)) {
      JS.invoke(effects, "enter", tCharacterReferenceMarkerNumeric);
      JS.invoke(effects, "consume", code);
      JS.invoke(effects, "exit", tCharacterReferenceMarkerNumeric);
      return numeric;
    }
    JS.invoke(effects, "enter", tCharacterReferenceValue);
    max = kCharacterReferenceNamedSizeMax;
    test = asciiAlphanumeric;
    return JS.call(value, JS.undefined(), code);
  });

  numeric = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cUppercaseX) || codeEq(code, cLowercaseX)) {
      JS.invoke(effects, "enter", tCharacterReferenceMarkerHexadecimal);
      JS.invoke(effects, "consume", code);
      JS.invoke(effects, "exit", tCharacterReferenceMarkerHexadecimal);
      JS.invoke(effects, "enter", tCharacterReferenceValue);
      max = kCharacterReferenceHexadecimalSizeMax;
      test = asciiHexDigit;
      return value;
    }
    JS.invoke(effects, "enter", tCharacterReferenceValue);
    max = kCharacterReferenceDecimalSizeMax;
    test = asciiDigit;
    return JS.call(value, JS.undefined(), code);
  });

  value = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cSemicolon) && size != 0.0) {
      JsValue token = JS.invoke(effects, "exit", tCharacterReferenceValue);
      if (test == asciiAlphanumeric && !decodeNamedCharacterReference(JS.assume(JS.invoke(self, "sliceSerialize", token))).truthy()) {
        return JS.call(nok, JS.undefined(), code);
      }
      JS.invoke(effects, "enter", tCharacterReferenceMarker);
      JS.invoke(effects, "consume", code);
      JS.invoke(effects, "exit", tCharacterReferenceMarker);
      JS.invoke(effects, "exit", tCharacterReference);
      return ok;
    }
    if (test(code) && size < max) {
      size++;
      JS.invoke(effects, "consume", code);
      return value;
    }
    return JS.call(nok, JS.undefined(), code);
  });

  return start;
});

export JsValue characterReference = JS.object("name", "characterReference", "tokenize", tokenizeCharacterReference);
