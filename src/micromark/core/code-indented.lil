import { factorySpace } from "../factory-space.lil";
import { markdownLineEnding } from "../util-character.lil";
import { kTabSize } from "../symbol/constants.lil";
import { tCodeFlowValue, tCodeIndented, tLineEnding, tLinePrefix } from "../symbol/types.lil";

JsValue tokenizeFurtherStart = JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
  JsValue furtherStart = JS.undefined();

  JsValue afterPrefix = JS.method1((JsValue _s, JsValue code) => {
    JsValue tail = JS.get(self, "events")[JS.get(self, "events").length - 1.0];
    if (tail.truthy() && JS.strictEqual(JS.get(tail[1], "type"), tLinePrefix) && JS.invoke(tail[2], "sliceSerialize", tail[1], true).length >= kTabSize) {
      return JS.call(ok, JS.undefined(), code);
    }
    if (markdownLineEnding(code)) {
      return JS.call(furtherStart, JS.undefined(), code);
    }
    return JS.call(nok, JS.undefined(), code);
  });

  furtherStart = JS.method1((JsValue _s, JsValue code) => {
    if (JS.get(JS.get(self, "parser"), "lazy")[JS.get(JS.invoke(self, "now"), "line")].truthy()) {
      return JS.call(nok, JS.undefined(), code);
    }
    if (markdownLineEnding(code)) {
      JS.invoke(effects, "enter", tLineEnding);
      JS.invoke(effects, "consume", code);
      JS.invoke(effects, "exit", tLineEnding);
      return furtherStart;
    }
    return JS.call(factorySpace(effects, afterPrefix, tLinePrefix, kTabSize + 1), JS.undefined(), code);
  });

  return furtherStart;
});

JsValue furtherStartConstruct = JS.object("partial", true, "tokenize", tokenizeFurtherStart);

JsValue tokenizeCodeIndented = JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
  JsValue atBreak = JS.undefined();
  JsValue inside = JS.undefined();

  JsValue after = JS.method1((JsValue _s, JsValue code) => {
    JS.invoke(effects, "exit", tCodeIndented);
    return JS.call(ok, JS.undefined(), code);
  });

  JsValue afterPrefix = JS.method1((JsValue _s, JsValue code) => {
    JsValue tail = JS.get(self, "events")[JS.get(self, "events").length - 1.0];
    if (tail.truthy() && JS.strictEqual(JS.get(tail[1], "type"), tLinePrefix) && JS.invoke(tail[2], "sliceSerialize", tail[1], true).length >= kTabSize) {
      return JS.call(atBreak, JS.undefined(), code);
    }
    return JS.call(nok, JS.undefined(), code);
  });

  atBreak = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null)) {
      return JS.call(after, JS.undefined(), code);
    }
    if (markdownLineEnding(code)) {
      return JS.call(JS.invoke(effects, "attempt", furtherStartConstruct, atBreak, after), JS.undefined(), code);
    }
    JS.invoke(effects, "enter", tCodeFlowValue);
    return JS.call(inside, JS.undefined(), code);
  });

  inside = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null) || markdownLineEnding(code)) {
      JS.invoke(effects, "exit", tCodeFlowValue);
      return JS.call(atBreak, JS.undefined(), code);
    }
    JS.invoke(effects, "consume", code);
    return inside;
  });

  return JS.method1((JsValue _s, JsValue code) => {
    JS.invoke(effects, "enter", tCodeIndented);
    return JS.call(factorySpace(effects, afterPrefix, tLinePrefix, kTabSize + 1), JS.undefined(), code);
  });
});

export JsValue codeIndented = JS.object("name", "codeIndented", "tokenize", tokenizeCodeIndented);
