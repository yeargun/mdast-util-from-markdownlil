import { factorySpace } from "../factory-space.lil";
import { markdownLineEnding, markdownSpace } from "../util-character.lil";
import { tContent, tDefinition, tLineEnding, tLinePrefix, tLineSuffix, tParagraph, tSetextHeading, tSetextHeadingLine, tSetextHeadingLineSequence, tSetextHeadingText } from "../symbol/types.lil";

import { copyPoint } from "../host.lil";

JsValue resolveToSetextUnderline = JS.method2((JsValue _self, JsValue events, JsValue context) => {
  float index = events.length;
  float content = 0.0;
  float text = 0.0;
  float definition = 0.0;
  while (true) {
    index--;
    if (index < 0.0) {
      break;
    }
    if (JS.strictEqual(events[index][0], "enter")) {
      if (JS.strictEqual(JS.get(events[index][1], "type"), tContent)) {
        content = index;
        break;
      }
      if (JS.strictEqual(JS.get(events[index][1], "type"), tParagraph)) {
        text = index;
      }
    } else {
      if (JS.strictEqual(JS.get(events[index][1], "type"), tContent)) {
        JS.invoke(events, "splice", index, 1);
      }
      if (definition == 0.0 && JS.strictEqual(JS.get(events[index][1], "type"), tDefinition)) {
        definition = index;
      }
    }
  }
  JsValue heading = JS.object(
    "type", tSetextHeading,
    "start", copyPoint(JS.get(events[content][1], "start")),
    "end", copyPoint(JS.get(events[events.length - 1.0][1], "end"))
  );
  JS.set(events[text][1], "type", tSetextHeadingText);
  if (definition != 0.0) {
    JS.invoke(events, "splice", text, 0, JS.array("enter", heading, context));
    JS.invoke(events, "splice", definition + 1.0, 0, JS.array("exit", events[content][1], context));
    JS.set(events[content][1], "end", copyPoint(JS.get(events[definition][1], "end")));
  } else {
    events[content][1] = heading;
  }
  JS.invoke(events, "push", JS.array("exit", heading, context));
  return events;
});

JsValue tokenizeSetextUnderline = JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
  JsValue marker = JS.undefined();
  JsValue inside = JS.undefined();
  JsValue after = JS.undefined();

  JsValue start = JS.method1((JsValue _s, JsValue code) => {
    float index = JS.get(self, "events").length;
    bool paragraph = false;
    while (true) {
      index--;
      if (index < 0.0) {
        break;
      }
      JsValue typ = JS.get(JS.get(self, "events")[index][1], "type");
      if (JS.strictNotEqual(typ, tLineEnding) && JS.strictNotEqual(typ, tLinePrefix) && JS.strictNotEqual(typ, tContent)) {
        paragraph = JS.strictEqual(typ, tParagraph);
        break;
      }
    }
    if (!JS.get(JS.get(self, "parser"), "lazy")[JS.get(JS.invoke(self, "now"), "line")].truthy() && (JS.get(self, "interrupt").truthy() || paragraph)) {
      JS.invoke(effects, "enter", tSetextHeadingLine);
      marker = code;
      JS.invoke(effects, "enter", tSetextHeadingLineSequence);
      return JS.call(inside, JS.undefined(), code);
    }
    return JS.call(nok, JS.undefined(), code);
  });

  inside = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, marker)) {
      JS.invoke(effects, "consume", code);
      return inside;
    }
    JS.invoke(effects, "exit", tSetextHeadingLineSequence);
    if (markdownSpace(code)) {
      return JS.call(factorySpace(effects, after, tLineSuffix, JS.undefined()), JS.undefined(), code);
    }
    return JS.call(after, JS.undefined(), code);
  });

  after = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null) || markdownLineEnding(code)) {
      JS.invoke(effects, "exit", tSetextHeadingLine);
      return JS.call(ok, JS.undefined(), code);
    }
    return JS.call(nok, JS.undefined(), code);
  });

  return start;
});

export JsValue setextUnderline = JS.object("name", "setextUnderline", "resolveTo", resolveToSetextUnderline, "tokenize", tokenizeSetextUnderline);
