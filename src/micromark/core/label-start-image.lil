import { cCaret, cLeftSquareBracket, codeEq } from "../symbol/codes.lil";
import { tLabelImage, tLabelImageMarker, tLabelMarker } from "../symbol/types.lil";
import { labelEnd } from "./label-end.lil";

JsValue tokenizeLabelStartImage = JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
  JsValue after = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cCaret) && JS.in("_hiddenFootnoteSupport", JS.get(JS.get(self, "parser"), "constructs"))) {
      return JS.call(nok, JS.undefined(), code);
    }
    return JS.call(ok, JS.undefined(), code);
  });

  JsValue open = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cLeftSquareBracket)) {
      JS.invoke(effects, "enter", tLabelMarker);
      JS.invoke(effects, "consume", code);
      JS.invoke(effects, "exit", tLabelMarker);
      JS.invoke(effects, "exit", tLabelImage);
      return after;
    }
    return JS.call(nok, JS.undefined(), code);
  });

  return JS.method1((JsValue _s, JsValue code) => {
    JS.invoke(effects, "enter", tLabelImage);
    JS.invoke(effects, "enter", tLabelImageMarker);
    JS.invoke(effects, "consume", code);
    JS.invoke(effects, "exit", tLabelImageMarker);
    return open;
  });
});

export JsValue labelStartImage = JS.object("name", "labelStartImage", "resolveAll", JS.get(labelEnd, "resolveAll"), "tokenize", tokenizeLabelStartImage);
