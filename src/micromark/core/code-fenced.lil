import { factorySpace } from "../factory-space.lil";
import { markdownLineEnding, markdownSpace } from "../util-character.lil";
import { cGraveAccent, codeEq } from "../symbol/codes.lil";
import { kCodeFencedSequenceSizeMin, kContentTypeString, kTabSize } from "../symbol/constants.lil";
import { tChunkString, tCodeFenced, tCodeFencedFence, tCodeFencedFenceInfo, tCodeFencedFenceMeta, tCodeFencedFenceSequence, tCodeFlowValue, tLineEnding, tLinePrefix, tWhitespace } from "../symbol/types.lil";

JsValue tokenizeNonLazyContinuation = JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
  JsValue lineStart = JS.method1((JsValue _s, JsValue code) => {
    if (JS.get(JS.get(self, "parser"), "lazy")[JS.get(JS.invoke(self, "now"), "line")].truthy()) {
      return JS.call(nok, JS.undefined(), code);
    }
    return JS.call(ok, JS.undefined(), code);
  });

  return JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null)) {
      return JS.call(nok, JS.undefined(), code);
    }
    JS.invoke(effects, "enter", tLineEnding);
    JS.invoke(effects, "consume", code);
    JS.invoke(effects, "exit", tLineEnding);
    return lineStart;
  });
});

JsValue nonLazyContinuation = JS.object("partial", true, "tokenize", tokenizeNonLazyContinuation);

JsValue tokenizeCodeFenced = JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
  float initialPrefix = 0.0;
  float sizeOpen = 0.0;
  JsValue marker = JS.undefined();
  JsValue sequenceOpen = JS.undefined();
  JsValue infoBefore = JS.undefined();
  JsValue info = JS.undefined();
  JsValue metaBefore = JS.undefined();
  JsValue meta = JS.undefined();
  JsValue atNonLazyBreak = JS.undefined();
  JsValue contentBefore = JS.undefined();
  JsValue contentStart = JS.undefined();
  JsValue beforeContentChunk = JS.undefined();
  JsValue contentChunk = JS.undefined();
  JsValue after = JS.undefined();

  JsValue tokenizeCloseStart = JS.method3((JsValue _ctx, JsValue closeEffects, JsValue closeOk, JsValue closeNok) => {
    float size = 0.0;
    JsValue beforeSequenceClose = JS.undefined();
    JsValue sequenceClose = JS.undefined();
    JsValue sequenceCloseAfter = JS.undefined();

    JsValue closeLineStart = JS.method1((JsValue _s, JsValue code) => {
      JS.invoke(closeEffects, "enter", tCodeFencedFence);
      if (markdownSpace(code)) {
        JsValue max = if (JS.invoke(JS.get(JS.get(JS.get(self, "parser"), "constructs"), "disable")["null"], "includes", "codeIndented").truthy()) { JS.undefined() } else { kTabSize };
        return JS.call(factorySpace(closeEffects, beforeSequenceClose, tLinePrefix, max), JS.undefined(), code);
      }
      return JS.call(beforeSequenceClose, JS.undefined(), code);
    });

    beforeSequenceClose = JS.method1((JsValue _s, JsValue code) => {
      if (JS.strictEqual(code, marker)) {
        JS.invoke(closeEffects, "enter", tCodeFencedFenceSequence);
        return JS.call(sequenceClose, JS.undefined(), code);
      }
      return JS.call(closeNok, JS.undefined(), code);
    });

    sequenceClose = JS.method1((JsValue _s, JsValue code) => {
      if (JS.strictEqual(code, marker)) {
        size++;
        JS.invoke(closeEffects, "consume", code);
        return sequenceClose;
      }
      if (size >= sizeOpen) {
        JS.invoke(closeEffects, "exit", tCodeFencedFenceSequence);
        if (markdownSpace(code)) {
          return JS.call(factorySpace(closeEffects, sequenceCloseAfter, tWhitespace, JS.undefined()), JS.undefined(), code);
        }
        return JS.call(sequenceCloseAfter, JS.undefined(), code);
      }
      return JS.call(closeNok, JS.undefined(), code);
    });

    sequenceCloseAfter = JS.method1((JsValue _s, JsValue code) => {
      if (JS.strictEqual(code, null) || markdownLineEnding(code)) {
        JS.invoke(closeEffects, "exit", tCodeFencedFence);
        return JS.call(closeOk, JS.undefined(), code);
      }
      return JS.call(closeNok, JS.undefined(), code);
    });

    return JS.method1((JsValue _s, JsValue code) => {
      JS.invoke(closeEffects, "enter", tLineEnding);
      JS.invoke(closeEffects, "consume", code);
      JS.invoke(closeEffects, "exit", tLineEnding);
      return closeLineStart;
    });
  });

  JsValue closeStart = JS.object("partial", true, "tokenize", tokenizeCloseStart);

  JsValue start = JS.method1((JsValue _s, JsValue code) => {
    JsValue tail = JS.get(self, "events")[JS.get(self, "events").length - 1.0];
    initialPrefix = if (tail.truthy() && JS.strictEqual(JS.get(tail[1], "type"), tLinePrefix)) { JS.invoke(tail[2], "sliceSerialize", tail[1], true).length } else { 0.0 };
    marker = code;
    JS.invoke(effects, "enter", tCodeFenced);
    JS.invoke(effects, "enter", tCodeFencedFence);
    JS.invoke(effects, "enter", tCodeFencedFenceSequence);
    return JS.call(sequenceOpen, JS.undefined(), code);
  });

  sequenceOpen = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, marker)) {
      sizeOpen++;
      JS.invoke(effects, "consume", code);
      return sequenceOpen;
    }
    if (sizeOpen < kCodeFencedSequenceSizeMin) {
      return JS.call(nok, JS.undefined(), code);
    }
    JS.invoke(effects, "exit", tCodeFencedFenceSequence);
    if (markdownSpace(code)) {
      return JS.call(factorySpace(effects, infoBefore, tWhitespace, JS.undefined()), JS.undefined(), code);
    }
    return JS.call(infoBefore, JS.undefined(), code);
  });

  infoBefore = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null) || markdownLineEnding(code)) {
      JS.invoke(effects, "exit", tCodeFencedFence);
      if (JS.get(self, "interrupt").truthy()) {
        return JS.call(ok, JS.undefined(), code);
      }
      return JS.call(JS.invoke(effects, "check", nonLazyContinuation, atNonLazyBreak, after), JS.undefined(), code);
    }
    JS.invoke(effects, "enter", tCodeFencedFenceInfo);
    JS.invoke(effects, "enter", tChunkString, JS.object("contentType", kContentTypeString));
    return JS.call(info, JS.undefined(), code);
  });

  info = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null) || markdownLineEnding(code)) {
      JS.invoke(effects, "exit", tChunkString);
      JS.invoke(effects, "exit", tCodeFencedFenceInfo);
      return JS.call(infoBefore, JS.undefined(), code);
    }
    if (markdownSpace(code)) {
      JS.invoke(effects, "exit", tChunkString);
      JS.invoke(effects, "exit", tCodeFencedFenceInfo);
      return JS.call(factorySpace(effects, metaBefore, tWhitespace, JS.undefined()), JS.undefined(), code);
    }
    if (codeEq(code, cGraveAccent) && JS.strictEqual(code, marker)) {
      return JS.call(nok, JS.undefined(), code);
    }
    JS.invoke(effects, "consume", code);
    return info;
  });

  metaBefore = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null) || markdownLineEnding(code)) {
      return JS.call(infoBefore, JS.undefined(), code);
    }
    JS.invoke(effects, "enter", tCodeFencedFenceMeta);
    JS.invoke(effects, "enter", tChunkString, JS.object("contentType", kContentTypeString));
    return JS.call(meta, JS.undefined(), code);
  });

  meta = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null) || markdownLineEnding(code)) {
      JS.invoke(effects, "exit", tChunkString);
      JS.invoke(effects, "exit", tCodeFencedFenceMeta);
      return JS.call(infoBefore, JS.undefined(), code);
    }
    if (codeEq(code, cGraveAccent) && JS.strictEqual(code, marker)) {
      return JS.call(nok, JS.undefined(), code);
    }
    JS.invoke(effects, "consume", code);
    return meta;
  });

  atNonLazyBreak = JS.method1((JsValue _s, JsValue code) => {
    return JS.call(JS.invoke(effects, "attempt", closeStart, after, contentBefore), JS.undefined(), code);
  });

  contentBefore = JS.method1((JsValue _s, JsValue code) => {
    JS.invoke(effects, "enter", tLineEnding);
    JS.invoke(effects, "consume", code);
    JS.invoke(effects, "exit", tLineEnding);
    return contentStart;
  });

  contentStart = JS.method1((JsValue _s, JsValue code) => {
    if (initialPrefix > 0.0 && markdownSpace(code)) {
      return JS.call(factorySpace(effects, beforeContentChunk, tLinePrefix, initialPrefix + 1.0), JS.undefined(), code);
    }
    return JS.call(beforeContentChunk, JS.undefined(), code);
  });

  beforeContentChunk = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null) || markdownLineEnding(code)) {
      return JS.call(JS.invoke(effects, "check", nonLazyContinuation, atNonLazyBreak, after), JS.undefined(), code);
    }
    JS.invoke(effects, "enter", tCodeFlowValue);
    return JS.call(contentChunk, JS.undefined(), code);
  });

  contentChunk = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null) || markdownLineEnding(code)) {
      JS.invoke(effects, "exit", tCodeFlowValue);
      return JS.call(beforeContentChunk, JS.undefined(), code);
    }
    JS.invoke(effects, "consume", code);
    return contentChunk;
  });

  after = JS.method1((JsValue _s, JsValue code) => {
    JS.invoke(effects, "exit", tCodeFenced);
    return JS.call(ok, JS.undefined(), code);
  });

  return start;
});

export JsValue codeFenced = JS.object("concrete", true, "name", "codeFenced", "tokenize", tokenizeCodeFenced);
