import { arrLen, call0, call1, call2, call3, includesStr, isEof, jsString, makeConstruct, makeNamedConstruct, objGet, undef } from "../host.lil";
import { factorySpace } from "../factory-space.lil";
import { markdownLineEnding, markdownSpace } from "../util-character.lil";
import { cGraveAccent, codeEq } from "../symbol/codes.lil";
import { kCodeFencedSequenceSizeMin, kContentTypeString, kTabSize } from "../symbol/constants.lil";
import { tChunkString, tCodeFenced, tCodeFencedFence, tCodeFencedFenceInfo, tCodeFencedFenceMeta, tCodeFencedFenceSequence, tCodeFlowValue, tLineEnding, tLinePrefix, tWhitespace } from "../symbol/types.lil";

JsValue tokenizeNonLazyContinuation = JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
  JsValue lineStart = JS.method1((JsValue _s, JsValue code) => {
    if (objGet(objGet(self, "parser"), "lazy")[objGet(call0(objGet(self, "now"), self), "line")].truthy()) {
      return call1(nok, undef(), code);
    }
    return call1(ok, undef(), code);
  });

  JsValue start = JS.method1((JsValue _s, JsValue code) => {
    if (isEof(code)) {
      return call1(nok, undef(), code);
    }
    call1(objGet(effects, "enter"), effects, tLineEnding);
    call1(objGet(effects, "consume"), effects, code);
    call1(objGet(effects, "exit"), effects, tLineEnding);
    return lineStart;
  });

  return start;
});

JsValue nonLazyContinuation = makeConstruct(tokenizeNonLazyContinuation);
JS.set(nonLazyContinuation, "partial", true);

JsValue tokenizeCodeFenced = JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
  JsValue st = JS.object();
  JS.set(st, "initialPrefix", 0);
  JS.set(st, "sizeOpen", 0);
  JS.set(st, "marker", undef());

  JsValue tokenizeCloseStart = JS.method3((JsValue _ctx, JsValue closeEffects, JsValue closeOk, JsValue closeNok) => {
    JsValue closeSt = JS.object();
    JS.set(closeSt, "size", 0);

    JsValue sequenceCloseAfter = JS.method1((JsValue _s, JsValue code) => {
      if (isEof(code) || markdownLineEnding(code)) {
        call1(objGet(closeEffects, "exit"), closeEffects, tCodeFencedFence);
        return call1(closeOk, undef(), code);
      }
      return call1(closeNok, undef(), code);
    });

    JsValue sequenceClose = JS.method1((JsValue _s, JsValue code) => {
      if (code == objGet(st, "marker")) {
        JS.set(closeSt, "size", JS.number(objGet(closeSt, "size")) + 1.0);
        call1(objGet(closeEffects, "consume"), closeEffects, code);
        return sequenceClose;
      }
      if (JS.number(objGet(closeSt, "size")) >= JS.number(objGet(st, "sizeOpen"))) {
        call1(objGet(closeEffects, "exit"), closeEffects, tCodeFencedFenceSequence);
        if (markdownSpace(code)) {
          return call1(factorySpace(closeEffects, sequenceCloseAfter, tWhitespace, undef()), undef(), code);
        }
        return call1(sequenceCloseAfter, undef(), code);
      }
      return call1(closeNok, undef(), code);
    });

    JsValue beforeSequenceClose = JS.method1((JsValue _s, JsValue code) => {
      if (code == objGet(st, "marker")) {
        call1(objGet(closeEffects, "enter"), closeEffects, tCodeFencedFenceSequence);
        return call1(sequenceClose, undef(), code);
      }
      return call1(closeNok, undef(), code);
    });

    JsValue closeLineStart = JS.method1((JsValue _s, JsValue code) => {
      call1(objGet(closeEffects, "enter"), closeEffects, tCodeFencedFence);
      if (markdownSpace(code)) {
        JsValue max = kTabSize;
        if (includesStr(objGet(objGet(objGet(self, "parser"), "constructs"), "disable")["null"], "codeIndented")) {
          max = undef();
        }
        return call1(factorySpace(closeEffects, beforeSequenceClose, tLinePrefix, max), undef(), code);
      }
      return call1(beforeSequenceClose, undef(), code);
    });

    JsValue startBefore = JS.method1((JsValue _s, JsValue code) => {
      call1(objGet(closeEffects, "enter"), closeEffects, tLineEnding);
      call1(objGet(closeEffects, "consume"), closeEffects, code);
      call1(objGet(closeEffects, "exit"), closeEffects, tLineEnding);
      return closeLineStart;
    });

    return startBefore;
  });

  JsValue closeStart = makeConstruct(tokenizeCloseStart);
  JS.set(closeStart, "partial", true);

  JsValue after = JS.method1((JsValue _s, JsValue code) => {
    call1(objGet(effects, "exit"), effects, tCodeFenced);
    return call1(ok, undef(), code);
  });

  JsValue contentChunk = JS.method1((JsValue _s, JsValue code) => {
    if (isEof(code) || markdownLineEnding(code)) {
      call1(objGet(effects, "exit"), effects, tCodeFlowValue);
      return call1(objGet(st, "beforeContentChunk"), undef(), code);
    }
    call1(objGet(effects, "consume"), effects, code);
    return contentChunk;
  });

  JsValue beforeContentChunk = JS.method1((JsValue _s, JsValue code) => {
    if (isEof(code) || markdownLineEnding(code)) {
      return call1(call3(objGet(effects, "check"), effects, nonLazyContinuation, objGet(st, "atNonLazyBreak"), after), undef(), code);
    }
    call1(objGet(effects, "enter"), effects, tCodeFlowValue);
    return call1(contentChunk, undef(), code);
  });

  JsValue contentStart = JS.method1((JsValue _s, JsValue code) => {
    if (JS.number(objGet(st, "initialPrefix")) > 0.0 && markdownSpace(code)) {
      return call1(factorySpace(effects, beforeContentChunk, tLinePrefix, JS.number(objGet(st, "initialPrefix")) + 1.0), undef(), code);
    }
    return call1(beforeContentChunk, undef(), code);
  });

  JsValue contentBefore = JS.method1((JsValue _s, JsValue code) => {
    call1(objGet(effects, "enter"), effects, tLineEnding);
    call1(objGet(effects, "consume"), effects, code);
    call1(objGet(effects, "exit"), effects, tLineEnding);
    return contentStart;
  });

  JsValue atNonLazyBreak = JS.method1((JsValue _s, JsValue code) => {
    return call1(call3(objGet(effects, "attempt"), effects, closeStart, after, contentBefore), undef(), code);
  });

  JsValue info = JS.method1((JsValue _s, JsValue code) => {
    if (isEof(code) || markdownLineEnding(code)) {
      call1(objGet(effects, "exit"), effects, tChunkString);
      call1(objGet(effects, "exit"), effects, tCodeFencedFenceInfo);
      return call1(objGet(st, "infoBefore"), undef(), code);
    }
    if (markdownSpace(code)) {
      call1(objGet(effects, "exit"), effects, tChunkString);
      call1(objGet(effects, "exit"), effects, tCodeFencedFenceInfo);
      return call1(factorySpace(effects, objGet(st, "metaBefore"), tWhitespace, undef()), undef(), code);
    }
    if (codeEq(code, cGraveAccent) && code == objGet(st, "marker")) {
      return call1(nok, undef(), code);
    }
    call1(objGet(effects, "consume"), effects, code);
    return info;
  });

  JsValue meta = JS.method1((JsValue _s, JsValue code) => {
    if (isEof(code) || markdownLineEnding(code)) {
      call1(objGet(effects, "exit"), effects, tChunkString);
      call1(objGet(effects, "exit"), effects, tCodeFencedFenceMeta);
      return call1(objGet(st, "infoBefore"), undef(), code);
    }
    if (codeEq(code, cGraveAccent) && code == objGet(st, "marker")) {
      return call1(nok, undef(), code);
    }
    call1(objGet(effects, "consume"), effects, code);
    return meta;
  });

  JsValue metaBefore = JS.method1((JsValue _s, JsValue code) => {
    if (isEof(code) || markdownLineEnding(code)) {
      return call1(objGet(st, "infoBefore"), undef(), code);
    }
    call1(objGet(effects, "enter"), effects, tCodeFencedFenceMeta);
    JsValue fields = JS.object();
    JS.set(fields, "contentType", kContentTypeString);
    call2(objGet(effects, "enter"), effects, tChunkString, fields);
    return call1(meta, undef(), code);
  });

  JsValue infoBefore = JS.method1((JsValue _s, JsValue code) => {
    if (isEof(code) || markdownLineEnding(code)) {
      call1(objGet(effects, "exit"), effects, tCodeFencedFence);
      if (objGet(self, "interrupt").truthy()) {
        return call1(ok, undef(), code);
      }
      return call1(call3(objGet(effects, "check"), effects, nonLazyContinuation, atNonLazyBreak, after), undef(), code);
    }
    call1(objGet(effects, "enter"), effects, tCodeFencedFenceInfo);
    JsValue fields = JS.object();
    JS.set(fields, "contentType", kContentTypeString);
    call2(objGet(effects, "enter"), effects, tChunkString, fields);
    return call1(info, undef(), code);
  });

  JsValue sequenceOpen = JS.method1((JsValue _s, JsValue code) => {
    if (code == objGet(st, "marker")) {
      JS.set(st, "sizeOpen", JS.number(objGet(st, "sizeOpen")) + 1.0);
      call1(objGet(effects, "consume"), effects, code);
      return sequenceOpen;
    }
    if (JS.number(objGet(st, "sizeOpen")) < JS.number(kCodeFencedSequenceSizeMin)) {
      return call1(nok, undef(), code);
    }
    call1(objGet(effects, "exit"), effects, tCodeFencedFenceSequence);
    if (markdownSpace(code)) {
      return call1(factorySpace(effects, infoBefore, tWhitespace, undef()), undef(), code);
    }
    return call1(infoBefore, undef(), code);
  });

  JsValue beforeSequenceOpen = JS.method1((JsValue _s, JsValue code) => {
    JsValue events = objGet(self, "events");
    JsValue tail = events[arrLen(events) - 1];
    float prefix = 0.0;
    if (tail.truthy() && objGet(tail[1], "type") == tLinePrefix) {
      prefix = JS.number(jsString(call2(objGet(tail[2], "sliceSerialize"), tail[2], tail[1], true)).length);
    }
    JS.set(st, "initialPrefix", prefix);
    JS.set(st, "marker", code);
    call1(objGet(effects, "enter"), effects, tCodeFenced);
    call1(objGet(effects, "enter"), effects, tCodeFencedFence);
    call1(objGet(effects, "enter"), effects, tCodeFencedFenceSequence);
    return call1(sequenceOpen, undef(), code);
  });

  JsValue start = JS.method1((JsValue _s, JsValue code) => {
    return call1(beforeSequenceOpen, undef(), code);
  });

  JS.set(st, "infoBefore", infoBefore);
  JS.set(st, "metaBefore", metaBefore);
  JS.set(st, "beforeContentChunk", beforeContentChunk);
  JS.set(st, "atNonLazyBreak", atNonLazyBreak);
  return start;
});

export JsValue codeFenced = makeNamedConstruct("codeFenced", tokenizeCodeFenced);
JS.set(codeFenced, "concrete", true);
