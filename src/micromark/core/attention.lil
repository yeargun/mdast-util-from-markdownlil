import { pushAll, splice } from "../util-chunked.lil";
import { classifyCharacter } from "../util-classify-character.lil";
import { resolveAll } from "../util-resolve-all.lil";
import { cAsterisk } from "../symbol/codes.lil";
import { kCharacterGroupPunctuation } from "../symbol/constants.lil";
import { tAttentionSequence, tData, tEmphasis, tEmphasisSequence, tEmphasisText, tStrong, tStrongSequence, tStrongText } from "../symbol/types.lil";

import { copyPoint } from "../host.lil";

// The tokenizer's own point and token objects, read and written in place.
extern class AttentionPoint {
  float _bufferIndex;
  float _index;
  float line;
  float column;
  float offset;
}

extern class AttentionToken {
  string type;
  AttentionPoint start;
  AttentionPoint end;
  bool _open;
  bool _close;
}

AttentionPoint copyAttentionPoint(AttentionPoint point) {
  return JS.assume(copyPoint(point));
}

void movePoint(AttentionPoint point, float offset) {
  point.column += offset;
  point.offset += offset;
  point._bufferIndex += offset;
}

JsValue resolveAllAttention = JS.method2((JsValue _self, JsValue events, JsValue context) => {
  float index = -1.0;
  while (true) {
    index++;
    if (index >= events.length) {
      break;
    }
    AttentionToken close = JS.assume(events[index][1]);
    if (JS.strictEqual(events[index][0], "enter") && close.type == tAttentionSequence && close._close) {
      float open = index;
      while (true) {
        open--;
        if (open < 0.0) {
          break;
        }
        AttentionToken opening = JS.assume(events[open][1]);
        if (JS.strictEqual(events[open][0], "exit") && opening.type == tAttentionSequence && opening._open && JS.strictEqual(JS.invoke(JS.invoke(context, "sliceSerialize", opening), "charCodeAt", 0), JS.invoke(JS.invoke(context, "sliceSerialize", close), "charCodeAt", 0))) {
          float openSize = opening.end.offset - opening.start.offset;
          float closeSize = close.end.offset - close.start.offset;
          if ((opening._close || close._open) && JS.mod(closeSize, 3).truthy() && !JS.mod(openSize + closeSize, 3).truthy()) {
            continue;
          }
          float use = if (openSize > 1.0 && closeSize > 1.0) { 2.0 } else { 1.0 };
          AttentionPoint start = copyAttentionPoint(opening.end);
          AttentionPoint end = copyAttentionPoint(close.start);
          movePoint(start, -use);
          movePoint(end, use);
          AttentionToken openingSequence = JS.assume(JS.object("type", if (use > 1.0) { tStrongSequence } else { tEmphasisSequence }, "start", start, "end", copyAttentionPoint(opening.end)));
          AttentionToken closingSequence = JS.assume(JS.object("type", if (use > 1.0) { tStrongSequence } else { tEmphasisSequence }, "start", copyAttentionPoint(close.start), "end", end));
          JsValue text = JS.object("type", if (use > 1.0) { tStrongText } else { tEmphasisText }, "start", copyAttentionPoint(opening.end), "end", copyAttentionPoint(close.start));
          JsValue group = JS.object("type", if (use > 1.0) { tStrong } else { tEmphasis }, "start", copyAttentionPoint(openingSequence.start), "end", copyAttentionPoint(closingSequence.end));
          opening.end = copyAttentionPoint(openingSequence.start);
          close.start = copyAttentionPoint(closingSequence.end);
          JsValue nextEvents = JS.array();
          if (opening.end.offset - opening.start.offset != 0.0) {
            nextEvents = pushAll(nextEvents, JS.array(JS.array("enter", opening, context), JS.array("exit", opening, context)));
          }
          nextEvents = pushAll(nextEvents, JS.array(JS.array("enter", group, context), JS.array("enter", openingSequence, context), JS.array("exit", openingSequence, context), JS.array("enter", text, context)));
          nextEvents = pushAll(nextEvents, resolveAll(JS.get(JS.get(JS.get(JS.get(context, "parser"), "constructs"), "insideSpan"), "null"), JS.invoke(events, "slice", open + 1.0, index), context));
          nextEvents = pushAll(nextEvents, JS.array(JS.array("exit", text, context), JS.array("enter", closingSequence, context), JS.array("exit", closingSequence, context), JS.array("exit", group, context)));
          float offset = 0.0;
          if (close.end.offset - close.start.offset != 0.0) {
            offset = 2.0;
            nextEvents = pushAll(nextEvents, JS.array(JS.array("enter", close, context), JS.array("exit", close, context)));
          }
          splice(events, open - 1.0, index - open + 3.0, nextEvents);
          index = open + nextEvents.length - offset - 2.0;
          break;
        }
      }
    }
  }
  index = -1.0;
  while (true) {
    index++;
    if (index >= events.length) {
      break;
    }
    AttentionToken token = JS.assume(events[index][1]);
    if (token.type == tAttentionSequence) {
      token.type = tData;
    }
  }
  return events;
});

JsValue tokenizeAttention = JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue _nok) => {
  JsValue attentionMarkers = JS.get(JS.get(JS.get(JS.get(self, "parser"), "constructs"), "attentionMarkers"), "null");
  JsValue previous = JS.get(self, "previous");
  JsValue before = classifyCharacter(previous);
  JsValue marker = JS.undefined();
  JsValue inside = JS.undefined();

  JsValue start = JS.method1((JsValue _s, JsValue code) => {
    marker = code;
    JS.invoke(effects, "enter", tAttentionSequence);
    return JS.call(inside, JS.undefined(), code);
  });

  inside = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, marker)) {
      JS.invoke(effects, "consume", code);
      return inside;
    }
    AttentionToken token = JS.assume(JS.invoke(effects, "exit", tAttentionSequence));
    JsValue after = classifyCharacter(code);
    JsValue open = JS.or(JS.or(!after.truthy(), JS.and(JS.strictEqual(after, kCharacterGroupPunctuation), before)), JS.invoke(attentionMarkers, "includes", code));
    JsValue close = JS.or(JS.or(!before.truthy(), JS.and(JS.strictEqual(before, kCharacterGroupPunctuation), after)), JS.invoke(attentionMarkers, "includes", previous));
    token._open = (if (JS.strictEqual(marker, cAsterisk)) { open } else { JS.and(open, JS.or(before, !close.truthy())) }).truthy();
    token._close = (if (JS.strictEqual(marker, cAsterisk)) { close } else { JS.and(close, JS.or(after, !open.truthy())) }).truthy();
    return JS.call(ok, JS.undefined(), code);
  });

  return start;
});

export JsValue attention = JS.object("name", "attention", "resolveAll", resolveAllAttention, "tokenize", tokenizeAttention);
