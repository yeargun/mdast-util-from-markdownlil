import { factorySpace } from "../factory-space.lil";
import { markdownLineEnding, markdownSpace } from "../util-character.lil";
import { kThematicBreakMarkerCountMin } from "../symbol/constants.lil";
import { tThematicBreak, tThematicBreakSequence, tWhitespace } from "../symbol/types.lil";

JsValue tokenizeThematicBreak = JS.method3((JsValue _self, JsValue effects, JsValue ok, JsValue nok) => {
  float size = 0.0;
  JsValue marker = JS.undefined();
  JsValue atBreak = JS.undefined();
  JsValue sequence = JS.undefined();

  JsValue start = JS.method1((JsValue _s, JsValue code) => {
    JS.invoke(effects, "enter", tThematicBreak);
    marker = code;
    return JS.call(atBreak, JS.undefined(), code);
  });

  atBreak = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, marker)) {
      JS.invoke(effects, "enter", tThematicBreakSequence);
      return JS.call(sequence, JS.undefined(), code);
    }
    if (size >= kThematicBreakMarkerCountMin && (JS.strictEqual(code, null) || markdownLineEnding(code))) {
      JS.invoke(effects, "exit", tThematicBreak);
      return JS.call(ok, JS.undefined(), code);
    }
    return JS.call(nok, JS.undefined(), code);
  });

  sequence = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, marker)) {
      JS.invoke(effects, "consume", code);
      size++;
      return sequence;
    }
    JS.invoke(effects, "exit", tThematicBreakSequence);
    if (markdownSpace(code)) {
      return JS.call(factorySpace(effects, atBreak, tWhitespace, JS.undefined()), JS.undefined(), code);
    }
    return JS.call(atBreak, JS.undefined(), code);
  });

  return start;
});

export JsValue thematicBreak = JS.object("name", "thematicBreak", "tokenize", tokenizeThematicBreak);
