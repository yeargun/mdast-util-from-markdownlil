import { factorySpace } from "../factory-space.lil";
import { markdownLineEnding, markdownLineEndingOrSpace, markdownSpace } from "../util-character.lil";
import { splice } from "../util-chunked.lil";
import { cNumberSign, codeEq } from "../symbol/codes.lil";
import { kAtxHeadingOpeningFenceSizeMax, kContentTypeText } from "../symbol/constants.lil";
import { tAtxHeading, tAtxHeadingSequence, tAtxHeadingText, tChunkText, tWhitespace } from "../symbol/types.lil";

JsValue resolveHeadingAtx = JS.method2((JsValue _self, JsValue events, JsValue context) => {
  float contentEnd = events.length - 2.0;
  float contentStart = 3.0;
  if (JS.strictEqual(JS.get(events[contentStart][1], "type"), tWhitespace)) {
    contentStart += 2.0;
  }
  if (contentEnd - 2.0 > contentStart && JS.strictEqual(JS.get(events[contentEnd][1], "type"), tWhitespace)) {
    contentEnd -= 2.0;
  }
  if (JS.strictEqual(JS.get(events[contentEnd][1], "type"), tAtxHeadingSequence) && (contentStart == contentEnd - 1.0 || (contentEnd - 4.0 > contentStart && JS.strictEqual(JS.get(events[contentEnd - 2.0][1], "type"), tWhitespace)))) {
    contentEnd -= if (contentStart + 1.0 == contentEnd) { 2.0 } else { 4.0 };
  }
  if (contentEnd > contentStart) {
    JsValue content = JS.object("type", tAtxHeadingText, "start", JS.get(events[contentStart][1], "start"), "end", JS.get(events[contentEnd][1], "end"));
    JsValue text = JS.object("type", tChunkText, "start", JS.get(events[contentStart][1], "start"), "end", JS.get(events[contentEnd][1], "end"), "contentType", kContentTypeText);
    splice(events, contentStart, contentEnd - contentStart + 1.0, JS.array(JS.array("enter", content, context), JS.array("enter", text, context), JS.array("exit", text, context), JS.array("exit", content, context)));
  }
  return events;
});

JsValue tokenizeHeadingAtx = JS.method3((JsValue _self, JsValue effects, JsValue ok, JsValue nok) => {
  float size = 0.0;
  JsValue sequenceOpen = JS.undefined();
  JsValue atBreak = JS.undefined();
  JsValue sequenceFurther = JS.undefined();
  JsValue data = JS.undefined();

  JsValue start = JS.method1((JsValue _s, JsValue code) => {
    JS.invoke(effects, "enter", tAtxHeading);
    JS.invoke(effects, "enter", tAtxHeadingSequence);
    return JS.call(sequenceOpen, JS.undefined(), code);
  });

  sequenceOpen = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cNumberSign) && size < kAtxHeadingOpeningFenceSizeMax) {
      size++;
      JS.invoke(effects, "consume", code);
      return sequenceOpen;
    }
    if (JS.strictEqual(code, null) || markdownLineEndingOrSpace(code)) {
      JS.invoke(effects, "exit", tAtxHeadingSequence);
      return JS.call(atBreak, JS.undefined(), code);
    }
    return JS.call(nok, JS.undefined(), code);
  });

  atBreak = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cNumberSign)) {
      JS.invoke(effects, "enter", tAtxHeadingSequence);
      return JS.call(sequenceFurther, JS.undefined(), code);
    }
    if (JS.strictEqual(code, null) || markdownLineEnding(code)) {
      JS.invoke(effects, "exit", tAtxHeading);
      return JS.call(ok, JS.undefined(), code);
    }
    if (markdownSpace(code)) {
      return JS.call(factorySpace(effects, atBreak, tWhitespace, JS.undefined()), JS.undefined(), code);
    }
    JS.invoke(effects, "enter", tAtxHeadingText);
    return JS.call(data, JS.undefined(), code);
  });

  sequenceFurther = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cNumberSign)) {
      JS.invoke(effects, "consume", code);
      return sequenceFurther;
    }
    JS.invoke(effects, "exit", tAtxHeadingSequence);
    return JS.call(atBreak, JS.undefined(), code);
  });

  data = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null) || codeEq(code, cNumberSign) || markdownLineEndingOrSpace(code)) {
      JS.invoke(effects, "exit", tAtxHeadingText);
      return JS.call(atBreak, JS.undefined(), code);
    }
    JS.invoke(effects, "consume", code);
    return data;
  });

  return start;
});

export JsValue headingAtx = JS.object("name", "headingAtx", "resolve", resolveHeadingAtx, "tokenize", tokenizeHeadingAtx);
