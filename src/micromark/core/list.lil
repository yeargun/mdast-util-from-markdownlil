import { factorySpace } from "../factory-space.lil";
import { asciiDigit, markdownSpace } from "../util-character.lil";
import { cAsterisk, cDash, cDigit1, cDot, cPlusSign, cRightParenthesis, codeEq } from "../symbol/codes.lil";
import { kListItemValueSizeMax, kTabSize } from "../symbol/constants.lil";
import { tLinePrefix, tListItemIndent, tListItemMarker, tListItemPrefix, tListItemPrefixWhitespace, tListItemValue, tListOrdered, tListUnordered } from "../symbol/types.lil";
import { blankLine } from "./blank-line.lil";
import { thematicBreak } from "./thematic-break.lil";

JsValue tokenizeListItemPrefixWhitespace = JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
  JsValue afterPrefix = JS.method1((JsValue _s, JsValue code) => {
    JsValue tail = JS.get(self, "events")[JS.get(self, "events").length - 1.0];
    if (!markdownSpace(code) && tail.truthy() && JS.strictEqual(JS.get(tail[1], "type"), tListItemPrefixWhitespace)) {
      return JS.call(ok, JS.undefined(), code);
    }
    return JS.call(nok, JS.undefined(), code);
  });
  JsValue max = if (JS.invoke(JS.get(JS.get(JS.get(self, "parser"), "constructs"), "disable")["null"], "includes", "codeIndented").truthy()) { JS.undefined() } else { kTabSize + 1 };
  return factorySpace(effects, afterPrefix, tListItemPrefixWhitespace, max);
});

JsValue listItemPrefixWhitespaceConstruct = JS.object("partial", true, "tokenize", tokenizeListItemPrefixWhitespace);

JsValue tokenizeIndent = JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
  JsValue afterPrefix = JS.method1((JsValue _s, JsValue code) => {
    JsValue tail = JS.get(self, "events")[JS.get(self, "events").length - 1.0];
    if (tail.truthy() && JS.strictEqual(JS.get(tail[1], "type"), tListItemIndent) && JS.strictEqual(JS.get(JS.invoke(tail[2], "sliceSerialize", tail[1], true), "length"), JS.get(JS.get(self, "containerState"), "size"))) {
      return JS.call(ok, JS.undefined(), code);
    }
    return JS.call(nok, JS.undefined(), code);
  });
  return factorySpace(effects, afterPrefix, tListItemIndent, JS.add(JS.get(JS.get(self, "containerState"), "size"), 1));
});

JsValue indentConstruct = JS.object("partial", true, "tokenize", tokenizeIndent);

JsValue tokenizeListStart = JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
  JsValue tail = JS.get(self, "events")[JS.get(self, "events").length - 1.0];
  float initialSize = if (tail.truthy() && JS.strictEqual(JS.get(tail[1], "type"), tLinePrefix)) { JS.invoke(tail[2], "sliceSerialize", tail[1], true).length } else { 0.0 };
  float size = 0.0;
  JsValue inside = JS.undefined();
  JsValue atMarker = JS.undefined();
  JsValue onBlank = JS.undefined();
  JsValue otherPrefix = JS.undefined();
  JsValue endOfPrefix = JS.undefined();

  JsValue start = JS.method1((JsValue _s, JsValue code) => {
    JsValue state = JS.get(self, "containerState");
    JsValue kind = JS.or(JS.get(state, "type"), if (codeEq(code, cAsterisk) || codeEq(code, cPlusSign) || codeEq(code, cDash)) { tListUnordered } else { tListOrdered });
    bool unordered = JS.strictEqual(kind, tListUnordered);
    if (if (unordered) { !JS.get(state, "marker").truthy() || JS.strictEqual(code, JS.get(state, "marker")) } else { asciiDigit(code) }) {
      if (!JS.get(state, "type").truthy()) {
        JS.set(state, "type", kind);
        JS.invoke(effects, "enter", kind, JS.object("_container", true));
      }
      if (unordered) {
        JS.invoke(effects, "enter", tListItemPrefix);
        if (codeEq(code, cAsterisk) || codeEq(code, cDash)) {
          return JS.call(JS.invoke(effects, "check", thematicBreak, nok, atMarker), JS.undefined(), code);
        }
        return JS.call(atMarker, JS.undefined(), code);
      }
      if (!JS.get(self, "interrupt").truthy() || codeEq(code, cDigit1)) {
        JS.invoke(effects, "enter", tListItemPrefix);
        JS.invoke(effects, "enter", tListItemValue);
        return JS.call(inside, JS.undefined(), code);
      }
    }
    return JS.call(nok, JS.undefined(), code);
  });

  inside = JS.method1((JsValue _s, JsValue code) => {
    if (asciiDigit(code) && size + 1.0 < kListItemValueSizeMax) {
      size++;
      JS.invoke(effects, "consume", code);
      return inside;
    }
    JsValue marker = JS.get(JS.get(self, "containerState"), "marker");
    if ((!JS.get(self, "interrupt").truthy() || size < 2.0) && (if (marker.truthy()) { JS.strictEqual(code, marker) } else { codeEq(code, cRightParenthesis) || codeEq(code, cDot) })) {
      JS.invoke(effects, "exit", tListItemValue);
      return JS.call(atMarker, JS.undefined(), code);
    }
    return JS.call(nok, JS.undefined(), code);
  });

  atMarker = JS.method1((JsValue _s, JsValue code) => {
    JS.invoke(effects, "enter", tListItemMarker);
    JS.invoke(effects, "consume", code);
    JS.invoke(effects, "exit", tListItemMarker);
    JsValue state = JS.get(self, "containerState");
    JS.set(state, "marker", JS.or(JS.get(state, "marker"), code));
    return JS.invoke(effects, "check", blankLine, if (JS.get(self, "interrupt").truthy()) { nok } else { onBlank }, JS.invoke(effects, "attempt", listItemPrefixWhitespaceConstruct, endOfPrefix, otherPrefix));
  });

  onBlank = JS.method1((JsValue _s, JsValue code) => {
    JS.set(JS.get(self, "containerState"), "initialBlankLine", true);
    initialSize++;
    return JS.call(endOfPrefix, JS.undefined(), code);
  });

  otherPrefix = JS.method1((JsValue _s, JsValue code) => {
    if (markdownSpace(code)) {
      JS.invoke(effects, "enter", tListItemPrefixWhitespace);
      JS.invoke(effects, "consume", code);
      JS.invoke(effects, "exit", tListItemPrefixWhitespace);
      return endOfPrefix;
    }
    return JS.call(nok, JS.undefined(), code);
  });

  endOfPrefix = JS.method1((JsValue _s, JsValue code) => {
    JS.set(JS.get(self, "containerState"), "size", initialSize + JS.invoke(self, "sliceSerialize", JS.invoke(effects, "exit", tListItemPrefix), true).length);
    return JS.call(ok, JS.undefined(), code);
  });

  return start;
});

JsValue tokenizeListEnd = JS.method1((JsValue self, JsValue effects) => {
  JS.invoke(effects, "exit", JS.get(JS.get(self, "containerState"), "type"));
  return JS.undefined();
});

// The continuation tokenizer attempts `list` itself, so it is written inside the
// construct's own initializer.
export JsValue list = JS.object(
  "continuation", JS.object("tokenize", JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
    JS.set(JS.get(self, "containerState"), "_closeFlow", JS.undefined());

    JsValue notInCurrentItem = JS.method1((JsValue _s, JsValue code) => {
      JS.set(JS.get(self, "containerState"), "_closeFlow", true);
      JS.set(self, "interrupt", JS.undefined());
      JsValue max = if (JS.invoke(JS.get(JS.get(JS.get(self, "parser"), "constructs"), "disable")["null"], "includes", "codeIndented").truthy()) { JS.undefined() } else { kTabSize };
      return JS.call(factorySpace(effects, JS.invoke(effects, "attempt", list, ok, nok), tLinePrefix, max), JS.undefined(), code);
    });

    JsValue onBlank = JS.method1((JsValue _s, JsValue code) => {
      JsValue state = JS.get(self, "containerState");
      JS.set(state, "furtherBlankLines", JS.or(JS.get(state, "furtherBlankLines"), JS.get(state, "initialBlankLine")));
      return JS.call(factorySpace(effects, ok, tListItemIndent, JS.add(JS.get(state, "size"), 1)), JS.undefined(), code);
    });

    JsValue notBlank = JS.method1((JsValue _s, JsValue code) => {
      JsValue state = JS.get(self, "containerState");
      if (JS.get(state, "furtherBlankLines").truthy() || !markdownSpace(code)) {
        JS.set(state, "furtherBlankLines", JS.undefined());
        JS.set(state, "initialBlankLine", JS.undefined());
        return JS.call(notInCurrentItem, JS.undefined(), code);
      }
      JS.set(state, "furtherBlankLines", JS.undefined());
      JS.set(state, "initialBlankLine", JS.undefined());
      return JS.call(JS.invoke(effects, "attempt", indentConstruct, ok, notInCurrentItem), JS.undefined(), code);
    });

    return JS.invoke(effects, "check", blankLine, onBlank, notBlank);
  })),
  "exit", tokenizeListEnd,
  "name", "list",
  "tokenize", tokenizeListStart
);
