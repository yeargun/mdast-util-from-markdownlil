import { arrLen, call1, call2, call3, includesStr, jsInt, jsString, makeConstruct, objGet, undef } from "../host.lil";
import { factorySpace } from "../factory-space.lil";
import { asciiDigit, markdownSpace } from "../util-character.lil";
import { cAsterisk, cDash, cDigit1, cDot, cPlusSign, cRightParenthesis, codeEq } from "../symbol/codes.lil";
import { kListItemValueSizeMax, kTabSize } from "../symbol/constants.lil";
import { tLinePrefix, tListItemIndent, tListItemMarker, tListItemPrefix, tListItemPrefixWhitespace, tListItemValue, tListOrdered, tListUnordered } from "../symbol/types.lil";
import { blankLine } from "./blank-line.lil";
import { thematicBreak } from "./thematic-break.lil";

JsValue tokenizeListItemPrefixWhitespace = JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
  JsValue afterPrefix = JS.method1((JsValue _s, JsValue code) => {
    JsValue events = objGet(self, "events");
    JsValue tail = events[arrLen(events) - 1];
    if (!markdownSpace(code) && tail.truthy() && objGet(tail[1], "type") == tListItemPrefixWhitespace) {
      return call1(ok, undef(), code);
    }
    return call1(nok, undef(), code);
  });
  JsValue max = kTabSize + 1;
  if (includesStr(objGet(objGet(objGet(self, "parser"), "constructs"), "disable")["null"], "codeIndented")) {
    max = undef();
  }
  return factorySpace(effects, afterPrefix, tListItemPrefixWhitespace, max);
});

JsValue listItemPrefixWhitespaceConstruct = makeConstruct(tokenizeListItemPrefixWhitespace);
JS.set(listItemPrefixWhitespaceConstruct, "partial", true);

JsValue tokenizeIndent = JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
  JsValue afterPrefix = JS.method1((JsValue _s, JsValue code) => {
    JsValue events = objGet(self, "events");
    JsValue tail = events[arrLen(events) - 1];
    if (tail.truthy() && objGet(tail[1], "type") == tListItemIndent && jsString(call2(objGet(tail[2], "sliceSerialize"), tail[2], tail[1], true)).length == jsInt(objGet(objGet(self, "containerState"), "size"))) {
      return call1(ok, undef(), code);
    }
    return call1(nok, undef(), code);
  });
  return factorySpace(effects, afterPrefix, tListItemIndent, JS.number(objGet(objGet(self, "containerState"), "size")) + 1.0);
});

JsValue indentConstruct = makeConstruct(tokenizeIndent);
JS.set(indentConstruct, "partial", true);

export JsValue list = JS.object();
JS.set(list, "name", "list");

JsValue tokenizeListStart = JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
  JsValue events = objGet(self, "events");
  JsValue tail = events[arrLen(events) - 1];
  JsValue st = JS.object();
  float initialSize = 0.0;
  if (tail.truthy() && objGet(tail[1], "type") == tLinePrefix) {
    initialSize = JS.number(jsString(call2(objGet(tail[2], "sliceSerialize"), tail[2], tail[1], true)).length);
  }
  JS.set(st, "initialSize", initialSize);
  JS.set(st, "size", 0);

  JsValue endOfPrefix = JS.method1((JsValue _s, JsValue code) => {
    JsValue prefix = call1(objGet(effects, "exit"), effects, tListItemPrefix);
    JS.set(objGet(self, "containerState"), "size", JS.number(objGet(st, "initialSize")) + JS.number(jsString(call2(objGet(self, "sliceSerialize"), self, prefix, true)).length));
    return call1(ok, undef(), code);
  });

  JsValue otherPrefix = JS.method1((JsValue _s, JsValue code) => {
    if (markdownSpace(code)) {
      call1(objGet(effects, "enter"), effects, tListItemPrefixWhitespace);
      call1(objGet(effects, "consume"), effects, code);
      call1(objGet(effects, "exit"), effects, tListItemPrefixWhitespace);
      return endOfPrefix;
    }
    return call1(nok, undef(), code);
  });

  JsValue onBlank = JS.method1((JsValue _s, JsValue code) => {
    JS.set(objGet(self, "containerState"), "initialBlankLine", true);
    JS.set(st, "initialSize", JS.number(objGet(st, "initialSize")) + 1.0);
    return call1(endOfPrefix, undef(), code);
  });

  JsValue atMarker = JS.method1((JsValue _s, JsValue code) => {
    call1(objGet(effects, "enter"), effects, tListItemMarker);
    call1(objGet(effects, "consume"), effects, code);
    call1(objGet(effects, "exit"), effects, tListItemMarker);
    if (!objGet(objGet(self, "containerState"), "marker").truthy()) {
      JS.set(objGet(self, "containerState"), "marker", code);
    }
    JsValue blankOk = onBlank;
    if (objGet(self, "interrupt").truthy()) {
      blankOk = nok;
    }
    return call3(objGet(effects, "check"), effects, blankLine, blankOk, call3(objGet(effects, "attempt"), effects, listItemPrefixWhitespaceConstruct, endOfPrefix, otherPrefix));
  });

  JsValue inside = JS.method1((JsValue _s, JsValue code) => {
    int size = JS.number(objGet(st, "size")).toInt();
    if (asciiDigit(code) && size + 1 < kListItemValueSizeMax) {
      JS.set(st, "size", size + 1);
      call1(objGet(effects, "consume"), effects, code);
      return inside;
    }
    bool sizeOk = !objGet(self, "interrupt").truthy() || size < 2;
    JsValue marker = objGet(objGet(self, "containerState"), "marker");
    bool markerOk = false;
    if (marker.truthy()) {
      markerOk = code == marker;
    } else {
      markerOk = codeEq(code, cRightParenthesis) || codeEq(code, cDot);
    }
    if (sizeOk && markerOk) {
      call1(objGet(effects, "exit"), effects, tListItemValue);
      return call1(atMarker, undef(), code);
    }
    return call1(nok, undef(), code);
  });

  JsValue start = JS.method1((JsValue _s, JsValue code) => {
    JsValue state = objGet(self, "containerState");
    string kind = tListOrdered;
    if (objGet(state, "type").truthy()) {
      kind = jsString(objGet(state, "type"));
    } else if (codeEq(code, cAsterisk) || codeEq(code, cPlusSign) || codeEq(code, cDash)) {
      kind = tListUnordered;
    }
    bool allowed = false;
    if (kind == tListUnordered) {
      allowed = !objGet(state, "marker").truthy() || code == objGet(state, "marker");
    } else {
      allowed = asciiDigit(code);
    }
    if (allowed) {
      if (!objGet(state, "type").truthy()) {
        JS.set(state, "type", kind);
        JsValue fields = JS.object();
        JS.set(fields, "_container", true);
        call2(objGet(effects, "enter"), effects, kind, fields);
      }
      if (kind == tListUnordered) {
        call1(objGet(effects, "enter"), effects, tListItemPrefix);
        if (codeEq(code, cAsterisk) || codeEq(code, cDash)) {
          return call1(call3(objGet(effects, "check"), effects, thematicBreak, nok, atMarker), undef(), code);
        }
        return call1(atMarker, undef(), code);
      }
      if (!objGet(self, "interrupt").truthy() || codeEq(code, cDigit1)) {
        call1(objGet(effects, "enter"), effects, tListItemPrefix);
        call1(objGet(effects, "enter"), effects, tListItemValue);
        return call1(inside, undef(), code);
      }
    }
    return call1(nok, undef(), code);
  });

  return start;
});

JsValue tokenizeListContinuation = JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
  JS.set(objGet(self, "containerState"), "_closeFlow", undef());

  JsValue notInCurrentItem = JS.method1((JsValue _s, JsValue code) => {
    JS.set(objGet(self, "containerState"), "_closeFlow", true);
    JS.set(self, "interrupt", undef());
    JsValue max = kTabSize;
    if (includesStr(objGet(objGet(objGet(self, "parser"), "constructs"), "disable")["null"], "codeIndented")) {
      max = undef();
    }
    return call1(factorySpace(effects, call3(objGet(effects, "attempt"), effects, list, ok, nok), tLinePrefix, max), undef(), code);
  });

  JsValue notBlank = JS.method1((JsValue _s, JsValue code) => {
    if (objGet(objGet(self, "containerState"), "furtherBlankLines").truthy() || !markdownSpace(code)) {
      JS.set(objGet(self, "containerState"), "furtherBlankLines", undef());
      JS.set(objGet(self, "containerState"), "initialBlankLine", undef());
      return call1(notInCurrentItem, undef(), code);
    }
    JS.set(objGet(self, "containerState"), "furtherBlankLines", undef());
    JS.set(objGet(self, "containerState"), "initialBlankLine", undef());
    return call1(call3(objGet(effects, "attempt"), effects, indentConstruct, ok, notInCurrentItem), undef(), code);
  });

  JsValue onBlank = JS.method1((JsValue _s, JsValue code) => {
    if (!objGet(objGet(self, "containerState"), "furtherBlankLines").truthy()) {
      JS.set(objGet(self, "containerState"), "furtherBlankLines", objGet(objGet(self, "containerState"), "initialBlankLine"));
    }
    return call1(factorySpace(effects, ok, tListItemIndent, JS.number(objGet(objGet(self, "containerState"), "size")) + 1.0), undef(), code);
  });

  return call3(objGet(effects, "check"), effects, blankLine, onBlank, notBlank);
});

JsValue tokenizeListEnd = JS.method1((JsValue self, JsValue effects) => {
  call1(objGet(effects, "exit"), effects, objGet(objGet(self, "containerState"), "type"));
  return undef();
});

JS.set(list, "tokenize", tokenizeListStart);
JsValue continuation = JS.object();
JS.set(continuation, "tokenize", tokenizeListContinuation);
JS.set(list, "continuation", continuation);
JS.set(list, "exit", tokenizeListEnd);
