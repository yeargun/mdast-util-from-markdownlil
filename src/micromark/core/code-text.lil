import { markdownLineEnding } from "../util-character.lil";
import { cGraveAccent, cSpace, codeEq } from "../symbol/codes.lil";
import { tCharacterEscape, tCodeText, tCodeTextData, tCodeTextPadding, tCodeTextSequence, tLineEnding } from "../symbol/types.lil";

JsValue resolveCodeText = JS.method2((JsValue _self, JsValue events, JsValue _context) => {
  float tailExitIndex = events.length - 4.0;
  float headEnterIndex = 3.0;
  float index = 0.0;
  float enter = -1.0;
  if ((JS.strictEqual(JS.get(events[headEnterIndex][1], "type"), tLineEnding) || JS.strictEqual(JS.get(events[headEnterIndex][1], "type"), "space")) && (JS.strictEqual(JS.get(events[tailExitIndex][1], "type"), tLineEnding) || JS.strictEqual(JS.get(events[tailExitIndex][1], "type"), "space"))) {
    index = headEnterIndex;
    while (true) {
      index++;
      if (index >= tailExitIndex) {
        break;
      }
      if (JS.strictEqual(JS.get(events[index][1], "type"), tCodeTextData)) {
        JS.set(events[headEnterIndex][1], "type", tCodeTextPadding);
        JS.set(events[tailExitIndex][1], "type", tCodeTextPadding);
        headEnterIndex += 2.0;
        tailExitIndex -= 2.0;
        break;
      }
    }
  }
  index = headEnterIndex - 1.0;
  tailExitIndex++;
  while (true) {
    index++;
    if (index > tailExitIndex) {
      break;
    }
    if (enter < 0.0) {
      if (index != tailExitIndex && JS.strictNotEqual(JS.get(events[index][1], "type"), tLineEnding)) {
        enter = index;
      }
    } else if (index == tailExitIndex || JS.strictEqual(JS.get(events[index][1], "type"), tLineEnding)) {
      JS.set(events[enter][1], "type", tCodeTextData);
      if (index != enter + 2.0) {
        JS.set(events[enter][1], "end", JS.get(events[index - 1.0][1], "end"));
        JS.invoke(events, "splice", enter + 2.0, index - enter - 2.0);
        tailExitIndex -= index - enter - 2.0;
        index = enter + 2.0;
      }
      enter = -1.0;
    }
  }
  return events;
});

JsValue previousCodeText = JS.method1((JsValue self, JsValue code) => {
  return !codeEq(code, cGraveAccent) || JS.strictEqual(JS.get(JS.get(self, "events")[JS.get(self, "events").length - 1.0][1], "type"), tCharacterEscape);
});

JsValue tokenizeCodeText = JS.method3((JsValue _self, JsValue effects, JsValue ok, JsValue nok) => {
  float sizeOpen = 0.0;
  float size = 0.0;
  JsValue token = JS.undefined();
  JsValue sequenceOpen = JS.undefined();
  JsValue between = JS.undefined();
  JsValue data = JS.undefined();
  JsValue sequenceClose = JS.undefined();

  JsValue start = JS.method1((JsValue _s, JsValue code) => {
    JS.invoke(effects, "enter", tCodeText);
    JS.invoke(effects, "enter", tCodeTextSequence);
    return JS.call(sequenceOpen, JS.undefined(), code);
  });

  sequenceOpen = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cGraveAccent)) {
      JS.invoke(effects, "consume", code);
      sizeOpen++;
      return sequenceOpen;
    }
    JS.invoke(effects, "exit", tCodeTextSequence);
    return JS.call(between, JS.undefined(), code);
  });

  between = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null)) {
      return JS.call(nok, JS.undefined(), code);
    }
    if (codeEq(code, cSpace)) {
      JS.invoke(effects, "enter", "space");
      JS.invoke(effects, "consume", code);
      JS.invoke(effects, "exit", "space");
      return between;
    }
    if (codeEq(code, cGraveAccent)) {
      token = JS.invoke(effects, "enter", tCodeTextSequence);
      size = 0.0;
      return JS.call(sequenceClose, JS.undefined(), code);
    }
    if (markdownLineEnding(code)) {
      JS.invoke(effects, "enter", tLineEnding);
      JS.invoke(effects, "consume", code);
      JS.invoke(effects, "exit", tLineEnding);
      return between;
    }
    JS.invoke(effects, "enter", tCodeTextData);
    return JS.call(data, JS.undefined(), code);
  });

  data = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null) || codeEq(code, cSpace) || codeEq(code, cGraveAccent) || markdownLineEnding(code)) {
      JS.invoke(effects, "exit", tCodeTextData);
      return JS.call(between, JS.undefined(), code);
    }
    JS.invoke(effects, "consume", code);
    return data;
  });

  sequenceClose = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cGraveAccent)) {
      JS.invoke(effects, "consume", code);
      size++;
      return sequenceClose;
    }
    if (size == sizeOpen) {
      JS.invoke(effects, "exit", tCodeTextSequence);
      JS.invoke(effects, "exit", tCodeText);
      return JS.call(ok, JS.undefined(), code);
    }
    JS.set(token, "type", tCodeTextData);
    return JS.call(data, JS.undefined(), code);
  });

  return start;
});

export JsValue codeText = JS.object("name", "codeText", "previous", previousCodeText, "resolve", resolveCodeText, "tokenize", tokenizeCodeText);
