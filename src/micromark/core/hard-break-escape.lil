import { markdownLineEnding } from "../util-character.lil";
import { tHardBreakEscape } from "../symbol/types.lil";

JsValue tokenizeHardBreakEscape = JS.method3((JsValue _self, JsValue effects, JsValue ok, JsValue nok) => {
  JsValue after = JS.method1((JsValue _s, JsValue code) => {
    if (markdownLineEnding(code)) {
      JS.invoke(effects, "exit", tHardBreakEscape);
      return JS.call(ok, JS.undefined(), code);
    }
    return JS.call(nok, JS.undefined(), code);
  });

  return JS.method1((JsValue _s, JsValue code) => {
    JS.invoke(effects, "enter", tHardBreakEscape);
    JS.invoke(effects, "consume", code);
    return after;
  });
});

export JsValue hardBreakEscape = JS.object("name", "hardBreakEscape", "tokenize", tokenizeHardBreakEscape);
