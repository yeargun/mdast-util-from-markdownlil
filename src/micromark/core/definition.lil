import { factoryDestination } from "../factory-destination.lil";
import { factoryLabel } from "../factory-label.lil";
import { factorySpace } from "../factory-space.lil";
import { factoryTitle } from "../factory-title.lil";
import { factoryWhitespace } from "../factory-whitespace.lil";
import { markdownLineEnding, markdownLineEndingOrSpace, markdownSpace } from "../util-character.lil";
import { normalizeIdentifier } from "../util-normalize-identifier.lil";
import { cColon, codeEq } from "../symbol/codes.lil";
import { tDefinition, tDefinitionDestination, tDefinitionDestinationLiteral, tDefinitionDestinationLiteralMarker, tDefinitionDestinationRaw, tDefinitionDestinationString, tDefinitionLabel, tDefinitionLabelMarker, tDefinitionLabelString, tDefinitionMarker, tDefinitionTitle, tDefinitionTitleMarker, tDefinitionTitleString, tWhitespace } from "../symbol/types.lil";

JsValue tokenizeTitleBefore = JS.method3((JsValue _self, JsValue effects, JsValue ok, JsValue nok) => {
  JsValue titleAfterOptionalWhitespace = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null) || markdownLineEnding(code)) {
      return JS.call(ok, JS.undefined(), code);
    }
    return JS.call(nok, JS.undefined(), code);
  });

  JsValue titleAfter = JS.method1((JsValue _s, JsValue code) => {
    if (markdownSpace(code)) {
      return JS.call(factorySpace(effects, titleAfterOptionalWhitespace, tWhitespace, JS.undefined()), JS.undefined(), code);
    }
    return JS.call(titleAfterOptionalWhitespace, JS.undefined(), code);
  });

  JsValue beforeMarker = JS.method1((JsValue _s, JsValue code) => {
    return JS.call(factoryTitle(effects, titleAfter, nok, tDefinitionTitle, tDefinitionTitleMarker, tDefinitionTitleString), JS.undefined(), code);
  });

  return JS.method1((JsValue _s, JsValue code) => {
    if (markdownLineEndingOrSpace(code)) {
      return JS.call(factoryWhitespace(effects, beforeMarker), JS.undefined(), code);
    }
    return JS.call(nok, JS.undefined(), code);
  });
});

JsValue titleBefore = JS.object("partial", true, "tokenize", tokenizeTitleBefore);

JsValue tokenizeDefinition = JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
  string identifier = "";
  JsValue labelAfter = JS.undefined();
  JsValue markerAfter = JS.undefined();
  JsValue destinationBefore = JS.undefined();
  JsValue destinationAfter = JS.undefined();
  JsValue after = JS.undefined();
  JsValue afterWhitespace = JS.undefined();

  JsValue start = JS.method1((JsValue _s, JsValue code) => {
    JS.invoke(effects, "enter", tDefinition);
    return JS.call(factoryLabel(self, effects, labelAfter, nok, tDefinitionLabel, tDefinitionLabelMarker, tDefinitionLabelString), JS.undefined(), code);
  });

  labelAfter = JS.method1((JsValue _s, JsValue code) => {
    string label = JS.assume(JS.invoke(self, "sliceSerialize", JS.get(self, "events")[JS.get(self, "events").length - 1.0][1]));
    identifier = normalizeIdentifier(label.slice(1, -1));
    if (codeEq(code, cColon)) {
      JS.invoke(effects, "enter", tDefinitionMarker);
      JS.invoke(effects, "consume", code);
      JS.invoke(effects, "exit", tDefinitionMarker);
      return markerAfter;
    }
    return JS.call(nok, JS.undefined(), code);
  });

  markerAfter = JS.method1((JsValue _s, JsValue code) => {
    if (markdownLineEndingOrSpace(code)) {
      return JS.call(factoryWhitespace(effects, destinationBefore), JS.undefined(), code);
    }
    return JS.call(destinationBefore, JS.undefined(), code);
  });

  destinationBefore = JS.method1((JsValue _s, JsValue code) => {
    return JS.call(factoryDestination(effects, destinationAfter, nok, tDefinitionDestination, tDefinitionDestinationLiteral, tDefinitionDestinationLiteralMarker, tDefinitionDestinationRaw, tDefinitionDestinationString, JS.undefined()), JS.undefined(), code);
  });

  destinationAfter = JS.method1((JsValue _s, JsValue code) => {
    return JS.call(JS.invoke(effects, "attempt", titleBefore, after, after), JS.undefined(), code);
  });

  after = JS.method1((JsValue _s, JsValue code) => {
    if (markdownSpace(code)) {
      return JS.call(factorySpace(effects, afterWhitespace, tWhitespace, JS.undefined()), JS.undefined(), code);
    }
    return JS.call(afterWhitespace, JS.undefined(), code);
  });

  afterWhitespace = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null) || markdownLineEnding(code)) {
      JS.invoke(effects, "exit", tDefinition);
      JS.invoke(JS.get(JS.get(self, "parser"), "defined"), "push", identifier);
      return JS.call(ok, JS.undefined(), code);
    }
    return JS.call(nok, JS.undefined(), code);
  });

  return start;
});

export JsValue definition = JS.object("name", "definition", "tokenize", tokenizeDefinition);
