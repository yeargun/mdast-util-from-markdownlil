import { apply, arrLen, call1, call2, call3, isEof, jsString, makeConstruct, makeNamedConstruct, objGet, push, undef } from "../host.lil";
import { factoryDestination } from "../factory-destination.lil";
import { factoryLabel } from "../factory-label.lil";
import { factorySpace } from "../factory-space.lil";
import { factoryTitle } from "../factory-title.lil";
import { factoryWhitespace } from "../factory-whitespace.lil";
import { markdownLineEnding, markdownLineEndingOrSpace, markdownSpace } from "../util-character.lil";
import { normalizeIdentifier } from "../util-normalize-identifier.lil";
import { cColon, codeEq } from "../symbol/codes.lil";
import { tDefinition, tDefinitionDestination, tDefinitionDestinationLiteral, tDefinitionDestinationLiteralMarker, tDefinitionDestinationRaw, tDefinitionDestinationString, tDefinitionLabel, tDefinitionLabelMarker, tDefinitionLabelString, tDefinitionMarker, tDefinitionTitle, tDefinitionTitleMarker, tDefinitionTitleString, tWhitespace } from "../symbol/types.lil";

JsValue tokenizeTitleBefore = JS.method3((JsValue _self, JsValue effects, JsValue ok, JsValue nok) => {
  JsValue st = JS.object();

  JsValue titleAfterOptionalWhitespace = JS.method1((JsValue _s, JsValue code) => {
    if (isEof(code) || markdownLineEnding(code)) {
      return call1(ok, undef(), code);
    }
    return call1(nok, undef(), code);
  });

  JsValue titleAfter = JS.method1((JsValue _s, JsValue code) => {
    if (markdownSpace(code)) {
      return call1(factorySpace(effects, titleAfterOptionalWhitespace, tWhitespace, undef()), undef(), code);
    }
    return call1(titleAfterOptionalWhitespace, undef(), code);
  });

  JsValue beforeMarker = JS.method1((JsValue _s, JsValue code) => {
    return call1(factoryTitle(effects, titleAfter, nok, tDefinitionTitle, tDefinitionTitleMarker, tDefinitionTitleString), undef(), code);
  });

  JsValue titleBefore = JS.method1((JsValue _s, JsValue code) => {
    if (markdownLineEndingOrSpace(code)) {
      return call1(factoryWhitespace(effects, beforeMarker), undef(), code);
    }
    return call1(nok, undef(), code);
  });

  JS.set(st, "titleBefore", titleBefore);
  return titleBefore;
});

JsValue titleBeforeConstruct = makeConstruct(tokenizeTitleBefore);
JS.set(titleBeforeConstruct, "partial", true);

JsValue tokenizeDefinition = JS.method3((JsValue self, JsValue effects, JsValue ok, JsValue nok) => {
  JsValue st = JS.object();
  JS.set(st, "identifier", "");

  JsValue afterWhitespace = JS.method1((JsValue _s, JsValue code) => {
    if (isEof(code) || markdownLineEnding(code)) {
      call1(objGet(effects, "exit"), effects, tDefinition);
      push(objGet(objGet(self, "parser"), "defined"), objGet(st, "identifier"));
      return call1(ok, undef(), code);
    }
    return call1(nok, undef(), code);
  });

  JsValue after = JS.method1((JsValue _s, JsValue code) => {
    if (markdownSpace(code)) {
      return call1(factorySpace(effects, afterWhitespace, tWhitespace, undef()), undef(), code);
    }
    return call1(afterWhitespace, undef(), code);
  });

  JsValue destinationAfter = JS.method1((JsValue _s, JsValue code) => {
    return call1(call3(objGet(effects, "attempt"), effects, titleBeforeConstruct, after, after), undef(), code);
  });

  JsValue destinationBefore = JS.method1((JsValue _s, JsValue code) => {
    return call1(factoryDestination(effects, destinationAfter, nok, tDefinitionDestination, tDefinitionDestinationLiteral, tDefinitionDestinationLiteralMarker, tDefinitionDestinationRaw, tDefinitionDestinationString, undef()), undef(), code);
  });

  JsValue markerAfter = JS.method1((JsValue _s, JsValue code) => {
    if (markdownLineEndingOrSpace(code)) {
      return call1(factoryWhitespace(effects, destinationBefore), undef(), code);
    }
    return call1(destinationBefore, undef(), code);
  });

  JsValue labelAfter = JS.method1((JsValue _s, JsValue code) => {
    JsValue events = objGet(self, "events");
    string raw = jsString(call1(objGet(self, "sliceSerialize"), self, events[arrLen(events) - 1][1]));
    JS.set(st, "identifier", normalizeIdentifier(jsString(JS.call(JS.get(raw, "slice"), raw, 1, -1))));
    if (codeEq(code, cColon)) {
      call1(objGet(effects, "enter"), effects, tDefinitionMarker);
      call1(objGet(effects, "consume"), effects, code);
      call1(objGet(effects, "exit"), effects, tDefinitionMarker);
      return markerAfter;
    }
    return call1(nok, undef(), code);
  });

  JsValue before = JS.method1((JsValue _s, JsValue code) => {
    JsValue labelArgs = JS.array();
    push(labelArgs, effects);
    push(labelArgs, labelAfter);
    push(labelArgs, nok);
    push(labelArgs, tDefinitionLabel);
    push(labelArgs, tDefinitionLabelMarker);
    push(labelArgs, tDefinitionLabelString);
    return call1(apply(factoryLabel, self, labelArgs), undef(), code);
  });

  JsValue start = JS.method1((JsValue _s, JsValue code) => {
    call1(objGet(effects, "enter"), effects, tDefinition);
    return call1(before, undef(), code);
  });

  return start;
});

export JsValue definition = makeNamedConstruct("definition", tokenizeDefinition);
