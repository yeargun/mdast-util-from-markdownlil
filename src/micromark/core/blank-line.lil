import { factorySpace } from "../factory-space.lil";
import { markdownLineEnding, markdownSpace } from "../util-character.lil";
import { tLinePrefix } from "../symbol/types.lil";

JsValue tokenizeBlankLine = JS.method3((JsValue _self, JsValue effects, JsValue ok, JsValue nok) => {
  JsValue after = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, null) || markdownLineEnding(code)) {
      return JS.call(ok, JS.undefined(), code);
    }
    return JS.call(nok, JS.undefined(), code);
  });

  return JS.method1((JsValue _s, JsValue code) => {
    if (markdownSpace(code)) {
      return JS.call(factorySpace(effects, after, tLinePrefix, JS.undefined()), JS.undefined(), code);
    }
    return JS.call(after, JS.undefined(), code);
  });
});

export JsValue blankLine = JS.object("partial", true, "tokenize", tokenizeBlankLine);
