import { factorySpace } from "./factory-space.lil";
import { markdownLineEnding } from "./util-character.lil";
import { cApostrophe, cBackslash, cLeftParenthesis, cQuotationMark, cRightParenthesis, codeEq } from "./symbol/codes.lil";
import { kContentTypeString } from "./symbol/constants.lil";
import { tChunkString, tLineEnding, tLinePrefix } from "./symbol/types.lil";

export JsValue factoryTitle(JsValue effects, JsValue ok, JsValue nok, string typ, string markerType, string stringType) {
  JsValue marker = JS.undefined();
  JsValue begin = JS.undefined();
  JsValue atBreak = JS.undefined();
  JsValue inside = JS.undefined();
  JsValue escape = JS.undefined();

  JsValue start = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cQuotationMark) || codeEq(code, cApostrophe) || codeEq(code, cLeftParenthesis)) {
      JS.invoke(effects, "enter", typ);
      JS.invoke(effects, "enter", markerType);
      JS.invoke(effects, "consume", code);
      JS.invoke(effects, "exit", markerType);
      marker = if (codeEq(code, cLeftParenthesis)) { cRightParenthesis } else { code };
      return begin;
    }
    return JS.call(nok, JS.undefined(), code);
  });

  begin = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, marker)) {
      JS.invoke(effects, "enter", markerType);
      JS.invoke(effects, "consume", code);
      JS.invoke(effects, "exit", markerType);
      JS.invoke(effects, "exit", typ);
      return ok;
    }
    JS.invoke(effects, "enter", stringType);
    return JS.call(atBreak, JS.undefined(), code);
  });

  atBreak = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, marker)) {
      JS.invoke(effects, "exit", stringType);
      return JS.call(begin, JS.undefined(), marker);
    }
    if (JS.strictEqual(code, null)) {
      return JS.call(nok, JS.undefined(), code);
    }
    if (markdownLineEnding(code)) {
      JS.invoke(effects, "enter", tLineEnding);
      JS.invoke(effects, "consume", code);
      JS.invoke(effects, "exit", tLineEnding);
      return factorySpace(effects, atBreak, tLinePrefix, JS.undefined());
    }
    JS.invoke(effects, "enter", tChunkString, JS.object("contentType", kContentTypeString));
    return JS.call(inside, JS.undefined(), code);
  });

  inside = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, marker) || JS.strictEqual(code, null) || markdownLineEnding(code)) {
      JS.invoke(effects, "exit", tChunkString);
      return JS.call(atBreak, JS.undefined(), code);
    }
    JS.invoke(effects, "consume", code);
    return if (codeEq(code, cBackslash)) { escape } else { inside };
  });

  escape = JS.method1((JsValue _s, JsValue code) => {
    if (JS.strictEqual(code, marker) || codeEq(code, cBackslash)) {
      JS.invoke(effects, "consume", code);
      return inside;
    }
    return JS.call(inside, JS.undefined(), code);
  });

  return start;
}
