import { arrLen, call1, isNullish, objGet, optionOrEmpty, push } from "./host.lil";
import { combineExtensions } from "./util-combine-extensions.lil";
import { createTokenizer } from "./create-tokenizer.lil";
import { contentConstruct } from "./initialize/content.lil";
import { documentConstruct } from "./initialize/document.lil";
import { flowConstruct } from "./initialize/flow.lil";
import { stringConstruct, textConstruct } from "./initialize/text.lil";
import { defaultConstructs } from "./constructs.lil";

JsValue makeCreate(JsValue parser, JsValue initial) {
  return JS.method1((JsValue _self, JsValue from) => {
    return createTokenizer(parser, initial, from);
  });
}

export JsValue parse(JsValue options) {
  JsValue settings = optionOrEmpty(options);
  JsValue list = JS.array();
  push(list, defaultConstructs);
  JsValue extras = objGet(settings, "extensions");
  if (extras.truthy()) {
    int i = 0;
    int n = arrLen(extras);
    while (i < n) {
      push(list, extras[i]);
      i = i + 1;
    }
  }
  JsValue constructs = combineExtensions(list);
  JsValue parser = JS.object();
  JS.set(parser, "constructs", constructs);
  JS.set(parser, "defined", JS.array());
  JS.set(parser, "lazy", JS.object());
  JS.set(parser, "content", makeCreate(parser, contentConstruct));
  JS.set(parser, "document", makeCreate(parser, documentConstruct));
  JS.set(parser, "flow", makeCreate(parser, flowConstruct));
  JS.set(parser, "string", makeCreate(parser, stringConstruct));
  JS.set(parser, "text", makeCreate(parser, textConstruct));
  return parser;
}
