import { markdownLineEndingOrSpace, unicodePunctuation, unicodeWhitespace } from "./util-character.lil";
import { kCharacterGroupPunctuation, kCharacterGroupWhitespace } from "./symbol/constants.lil";

// 1 (whitespace), 2 (punctuation), or undefined (anything else), as upstream.
export JsValue classifyCharacter(JsValue code) {
  if (JS.strictEqual(code, null) || markdownLineEndingOrSpace(code) || unicodeWhitespace(code)) {
    return kCharacterGroupWhitespace;
  }
  if (unicodePunctuation(code)) {
    return kCharacterGroupPunctuation;
  }
  return JS.undefined();
}
