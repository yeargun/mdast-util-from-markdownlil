import { markdownSpace } from "./util-character.lil";

// `max` is optional, as upstream's: pass `JS.undefined()` (elided at the call
// site) or a falsy value for no limit.
export JsValue factorySpace(JsValue effects, JsValue ok, string typ, JsValue max) {
  float limit = if (max.truthy()) { JS.number(max) - 1.0 } else { 1.0 / 0.0 };
  float size = 0.0;
  JsValue prefix = JS.undefined();

  prefix = JS.method1((JsValue _s, JsValue code) => {
    if (markdownSpace(code) && size < limit) {
      size++;
      JS.invoke(effects, "consume", code);
      return prefix;
    }
    JS.invoke(effects, "exit", typ);
    return JS.call(ok, JS.undefined(), code);
  });

  return JS.method1((JsValue _s, JsValue code) => {
    if (markdownSpace(code)) {
      JS.invoke(effects, "enter", typ);
      return JS.call(prefix, JS.undefined(), code);
    }
    return JS.call(ok, JS.undefined(), code);
  });
}
