import { labelStartLink } from "./core/label-start-link.lil";
import { lineEnding } from "./core/line-ending.lil";
import { list } from "./core/list.lil";
import { setextUnderline } from "./core/setext-underline.lil";
import { thematicBreak } from "./core/thematic-break.lil";
import { resolver as resolveText } from "./initialize/text.lil";

export JsValue document = JS.object(
  "42", list,
  "43", list,
  "45", list,
  "48", list,
  "49", list,
  "50", list,
  "51", list,
  "52", list,
  "53", list,
  "54", list,
  "55", list,
  "56", list,
  "57", list,
  "62", blockQuote
);

export JsValue contentInitial = JS.object("91", definition);

export JsValue flowInitial = JS.object(
  "-2", codeIndented,
  "-1", codeIndented,
  "32", codeIndented
);

export JsValue flow = JS.object(
  "35", headingAtx,
  "42", thematicBreak,
  "45", JS.array(setextUnderline, thematicBreak),
  "60", htmlFlow,
  "61", setextUnderline,
  "95", thematicBreak,
  "96", codeFenced,
  "126", codeFenced
);

export JsValue stringMap = JS.object(
  "38", characterReference,
  "92", characterEscape
);

export JsValue text = JS.object(
  "-5", lineEnding,
  "-4", lineEnding,
  "-3", lineEnding,
  "33", labelStartImage,
  "38", characterReference,
  "42", attention,
  "60", JS.array(autolink, htmlText),
  "91", labelStartLink,
  "92", JS.array(hardBreakEscape, characterEscape),
  "93", labelEnd,
  "95", attention,
  "96", codeText
);

export JsValue insideSpan = JS.object("null", JS.array(attention, resolveText));

export JsValue attentionMarkers = JS.object("null", JS.array(42, 95));

export JsValue disable = JS.object("null", JS.array());

// Upstream passes its constructs module namespace, whose keys enumerate in sorted order.
export JsValue defaultConstructs = JS.object(
  "attentionMarkers", attentionMarkers,
  "contentInitial", contentInitial,
  "disable", disable,
  "document", document,
  "flow", flow,
  "flowInitial", flowInitial,
  "insideSpan", insideSpan,
  "string", stringMap,
  "text", text
);
