import { markdownLineEnding, markdownSpace } from "./util-character.lil";
import { tLineEnding, tLinePrefix, tLineSuffix } from "./symbol/types.lil";

export JsValue factoryWhitespace(JsValue effects, JsValue ok) {
  JsValue st = JS.object();
  JS.set(st, "seen", false);

  JsValue start = JS.method1((JsValue _self, JsValue code) => {
    if (markdownLineEnding(code)) {
      call1(objGet(effects, "enter"), effects, tLineEnding);
      call1(objGet(effects, "consume"), effects, code);
      call1(objGet(effects, "exit"), effects, tLineEnding);
      JS.set(st, "seen", true);
      return objGet(st, "start");
    }
    if (markdownSpace(code)) {
      string typ = tLineSuffix;
      if (objGet(st, "seen").truthy()) {
        typ = tLinePrefix;
      }
      return call1(factorySpace(effects, objGet(st, "start"), typ, JS.undefined()), JS.undefined(), code);
    }
    return call1(ok, JS.undefined(), code);
  });

  JS.set(st, "start", start);
  return start;
}
