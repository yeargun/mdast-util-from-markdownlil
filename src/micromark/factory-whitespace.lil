import { factorySpace } from "./factory-space.lil";
import { markdownLineEnding, markdownSpace } from "./util-character.lil";
import { tLineEnding, tLinePrefix, tLineSuffix } from "./symbol/types.lil";

export JsValue factoryWhitespace(JsValue effects, JsValue ok) {
  bool seen = false;
  JsValue start = JS.undefined();

  start = JS.method1((JsValue _s, JsValue code) => {
    if (markdownLineEnding(code)) {
      JS.invoke(effects, "enter", tLineEnding);
      JS.invoke(effects, "consume", code);
      JS.invoke(effects, "exit", tLineEnding);
      seen = true;
      return start;
    }
    if (markdownSpace(code)) {
      return JS.call(factorySpace(effects, start, if (seen) { tLinePrefix } else { tLineSuffix }, JS.undefined()), JS.undefined(), code);
    }
    return JS.call(ok, JS.undefined(), code);
  });

  return start;
}
