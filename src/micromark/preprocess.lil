import { codeEof, decodeBytes, MathRef, push } from "./host.lil";
import { cByteOrderMarker, cCarriageReturn, cCarriageReturnLineFeed, cCr, cHorizontalTab, cHt, cLf, cLineFeed, cNul, cReplacementCharacter, cVirtualSpace } from "./symbol/codes.lil";
import { kTabSize } from "./symbol/constants.lil";

export JsValue preprocess() {
  float column = 1.0;
  string buffer = "";
  bool start = true;
  bool atCarriageReturn = false;

  return JS.method3((JsValue _self, JsValue value, JsValue encoding, JsValue end) => {
    JsValue[] chunks = [];
    string text = buffer + decodeBytes(value, encoding);
    int startPosition = 0;
    buffer = "";
    if (start) {
      if (text.length > 0 && text.charCodeAt(0) == cByteOrderMarker) {
        startPosition = 1;
      }
      start = false;
    }
    int n = text.length;
    while (startPosition < n) {
      int endPosition = startPosition;
      int found = -1;
      while (endPosition < n) {
        int ch = text.charCodeAt(endPosition);
        if (ch == cNul || ch == cHt || ch == cLf || ch == cCr) {
          found = ch;
          break;
        }
        endPosition = endPosition + 1;
      }
      if (found < 0) {
        buffer = text.slice(startPosition);
        break;
      }
      int code = found;
      if (code == cLf && startPosition == endPosition && atCarriageReturn) {
        push(chunks, cCarriageReturnLineFeed);
        atCarriageReturn = false;
      } else {
        if (atCarriageReturn) {
          push(chunks, cCarriageReturn);
          atCarriageReturn = false;
        }
        if (startPosition < endPosition) {
          push(chunks, text.slice(startPosition, endPosition));
          column = column + (endPosition - startPosition);
        }
        if (code == cNul) {
          push(chunks, cReplacementCharacter);
          column = column + 1.0;
        } else if (code == cHt) {
          float next = JS.number(JS.call(JS.get(MathRef, "ceil"), MathRef, column / JS.number(kTabSize))) * JS.number(kTabSize);
          push(chunks, cHorizontalTab);
          while (column < next) {
            push(chunks, cVirtualSpace);
            column = column + 1.0;
          }
          column = column + 1.0;
        } else if (code == cLf) {
          push(chunks, cLineFeed);
          column = 1.0;
        } else {
          atCarriageReturn = true;
          column = 1.0;
        }
      }
      startPosition = endPosition + 1;
    }
    if (end.truthy()) {
      if (atCarriageReturn) {
        push(chunks, cCarriageReturn);
      }
      if (buffer.length > 0) {
        push(chunks, buffer);
      }
      push(chunks, codeEof);
    }
    return chunks;
  });
}
