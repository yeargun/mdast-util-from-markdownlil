extern JsValue TextDecoder;

export JsValue preprocess() {
  float column = 1.0;
  string buffer = "";
  bool start = true;
  bool atCarriageReturn = false;

  return JS.method3((JsValue _self, JsValue value, JsValue encoding, JsValue end) => {
    JsValue[] chunks = [];
    string decoded = JS.assume(if (JS.typeOf(value) == "string") { value } else { JS.invoke(JS.construct(TextDecoder, JS.or(encoding, JS.undefined())), "decode", value) });
    string text = buffer + decoded;
    int startPosition = 0;
    buffer = "";
    if (start) {
      if (JS.strictEqual(JS.invoke(text, "charCodeAt", 0), 65279)) {
        startPosition = 1;
      }
      start = false;
    }
    while (startPosition < text.length) {
      int endPosition = startPosition;
      int code = -1;
      while (endPosition < text.length) {
        int ch = text.charCodeAt(endPosition);
        if (ch == 0 || ch == 9 || ch == 10 || ch == 13) {
          code = ch;
          break;
        }
        endPosition++;
      }
      if (code < 0) {
        buffer = text.slice(startPosition);
        break;
      }
      if (code == 10 && startPosition == endPosition && atCarriageReturn) {
        chunks.push(-3);
        atCarriageReturn = false;
      } else {
        if (atCarriageReturn) {
          chunks.push(-5);
          atCarriageReturn = false;
        }
        if (startPosition < endPosition) {
          chunks.push(text.slice(startPosition, endPosition));
          column = column + (endPosition - startPosition);
        }
        if (code == 0) {
          chunks.push(65533);
          column++;
        } else if (code == 9) {
          float next = (column / 4.0).ceil() * 4.0;
          chunks.push(-2);
          while (column < next) {
            chunks.push(-1);
            column++;
          }
          column++;
        } else if (code == 10) {
          chunks.push(-4);
          column = 1.0;
        } else {
          atCarriageReturn = true;
          column = 1.0;
        }
      }
      startPosition = endPosition + 1;
    }
    if (end.truthy()) {
      if (atCarriageReturn) {
        chunks.push(-5);
      }
      if (buffer.length > 0) {
        chunks.push(buffer);
      }
      chunks.push(null);
    }
    return chunks;
  });
}
