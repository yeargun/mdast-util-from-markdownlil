import { copyPoint } from "./host.lil";
import { splice } from "./util-chunked.lil";
import { SpliceBuffer } from "./splice-buffer.lil";

extern JsValue Object;

export { SpliceBuffer };

JsValue typeOf(JsValue event) {
  return JS.get(event[1], "type");
}

JsValue subcontent(JsValue events, float eventIndex) {
  JsValue event = JS.invoke(events, "get", eventIndex);
  JsValue token = event[1];
  JsValue context = event[2];
  float startPosition = eventIndex - 1.0;
  JsValue[] startPositions = [];
  JsValue tokenizer = JS.get(token, "_tokenizer");
  if (!tokenizer.truthy()) {
    tokenizer = JS.invoke(JS.get(context, "parser"), JS.assume(JS.get(token, "contentType")), JS.get(token, "start"));
    if (JS.get(token, "_contentTypeTextTrailing").truthy()) {
      JS.set(tokenizer, "_contentTypeTextTrailing", true);
    }
  }
  JsValue childEvents = JS.get(tokenizer, "events");
  JsValue jumps = JS.array();
  JsValue gaps = JS.object();
  JsValue previous = JS.undefined();
  JsValue current = token;
  float adjust = 0.0;
  JsValue breaks = JS.array(0);

  while (current.truthy()) {
    while (true) {
      startPosition++;
      if (JS.strictEqual(JS.invoke(events, "get", startPosition)[1], current)) {
        break;
      }
    }
    startPositions.push(startPosition);
    if (!JS.get(current, "_tokenizer").truthy()) {
      JsValue stream = JS.invoke(context, "sliceStream", current);
      if (!JS.get(current, "next").truthy()) {
        JS.invoke(stream, "push", null);
      }
      if (previous.truthy()) {
        JS.invoke(tokenizer, "defineSkip", JS.get(current, "start"));
      }
      if (JS.get(current, "_isInFirstContentOfListItem").truthy()) {
        JS.set(tokenizer, "_gfmTasklistFirstContentOfListItem", true);
      }
      JS.invoke(tokenizer, "write", stream);
      if (JS.get(current, "_isInFirstContentOfListItem").truthy()) {
        JS.set(tokenizer, "_gfmTasklistFirstContentOfListItem", JS.undefined());
      }
    }
    previous = current;
    current = JS.get(current, "next");
  }

  current = token;
  for (float index = 0.0; index < childEvents.length; index++) {
    JsValue exit = childEvents[index];
    JsValue enter = childEvents[index - 1.0];
    if (
      JS.strictEqual(exit[0], "exit") &&
      JS.strictEqual(enter[0], "enter") &&
      JS.strictEqual(typeOf(exit), typeOf(enter)) &&
      !JS.strictEqual(JS.get(JS.get(exit[1], "start"), "line"), JS.get(JS.get(exit[1], "end"), "line"))
    ) {
      JS.invoke(breaks, "push", index + 1.0);
      JS.set(current, "_tokenizer", JS.undefined());
      JS.set(current, "previous", JS.undefined());
      current = JS.get(current, "next");
    }
  }

  JS.set(tokenizer, "events", JS.array());

  if (current.truthy()) {
    JS.set(current, "_tokenizer", JS.undefined());
    JS.set(current, "previous", JS.undefined());
  } else {
    JS.invoke(breaks, "pop");
  }

  float index = breaks.length;
  while (index > 0.0) {
    index--;
    JsValue slice = JS.invoke(childEvents, "slice", breaks[index], breaks[index + 1.0]);
    JsValue start = startPositions.pop();
    float first = JS.assume(start);
    JS.invoke(jumps, "push", JS.array(start, first + slice.length - 1.0));
    JS.invoke(events, "splice", start, 2, slice);
  }

  JS.invoke(jumps, "reverse");
  for (float jump = 0.0; jump < jumps.length; jump++) {
    float jumpStart = JS.assume(jumps[jump][0]);
    float jumpEnd = JS.assume(jumps[jump][1]);
    gaps[adjust + jumpStart] = adjust + jumpEnd;
    adjust = adjust + jumpEnd - jumpStart - 1.0;
  }
  return gaps;
}

export bool subtokenize(JsValue eventsArray) {
  JsValue jumps = JS.object();
  bool more = false;
  JsValue events = JS.construct(SpliceBuffer, eventsArray);

  for (float index = 0.0; index < events.length; index++) {
    while (JS.in(index, jumps)) {
      index = JS.assume(jumps[index]);
    }
    JsValue event = JS.invoke(events, "get", index);
    if (
      index != 0.0 &&
      JS.strictEqual(typeOf(event), "chunkFlow") &&
      JS.strictEqual(typeOf(JS.invoke(events, "get", index - 1.0)), "listItemPrefix")
    ) {
      JsValue subevents = JS.get(JS.get(event[1], "_tokenizer"), "events");
      float otherIndex = 0.0;
      if (otherIndex < subevents.length && JS.strictEqual(typeOf(subevents[otherIndex]), "lineEndingBlank")) {
        otherIndex = otherIndex + 2.0;
      }
      if (otherIndex < subevents.length && JS.strictEqual(typeOf(subevents[otherIndex]), "content")) {
        while (true) {
          otherIndex++;
          if (otherIndex >= subevents.length || JS.strictEqual(typeOf(subevents[otherIndex]), "content")) {
            break;
          }
          if (JS.strictEqual(typeOf(subevents[otherIndex]), "chunkText")) {
            JS.set(subevents[otherIndex][1], "_isInFirstContentOfListItem", true);
            otherIndex++;
          }
        }
      }
    }

    if (JS.strictEqual(event[0], "enter")) {
      if (JS.get(event[1], "contentType").truthy()) {
        JS.call(JS.get(Object, "assign"), Object, jumps, subcontent(events, index));
        index = JS.assume(jumps[index]);
        more = true;
      }
    } else if (JS.get(event[1], "_container").truthy()) {
      float otherIndex = index;
      float lineIndex = 0.0;
      while (otherIndex > 0.0) {
        otherIndex--;
        JsValue otherEvent = JS.invoke(events, "get", otherIndex);
        JsValue otherType = typeOf(otherEvent);
        if (JS.strictEqual(otherType, "lineEnding") || JS.strictEqual(otherType, "lineEndingBlank")) {
          if (JS.strictEqual(otherEvent[0], "enter")) {
            if (lineIndex != 0.0) {
              JS.set(JS.invoke(events, "get", lineIndex)[1], "type", "lineEndingBlank");
            }
            JS.set(otherEvent[1], "type", "lineEnding");
            lineIndex = otherIndex;
          }
        } else if (!(JS.strictEqual(otherType, "linePrefix") || JS.strictEqual(otherType, "listItemIndent"))) {
          break;
        }
      }
      if (lineIndex != 0.0) {
        JS.set(event[1], "end", copyPoint(JS.get(JS.invoke(events, "get", lineIndex)[1], "start")));
        JsValue parameters = JS.invoke(events, "slice", lineIndex, index);
        JS.invoke(parameters, "unshift", event);
        JS.invoke(events, "splice", lineIndex, index - lineIndex + 1.0, parameters);
      }
    }
  }

  splice(eventsArray, 0, 1.0 / 0.0, JS.invoke(events, "slice", 0));
  return !more;
}
