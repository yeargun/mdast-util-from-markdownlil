import { decodeNamedCharacterReference } from "./decode-named.lil";
import { decodeNumericCharacterReference } from "./util-decode-numeric.lil";

Regex characterEscapeOrReference = new Regex("\\\\([!-/:-@[-`{-~])|&(#(?:\\d{1,7}|x[\\da-f]{1,6})|[\\da-z]{1,31});", "gi");

export string decodeString(string value) {
  return JS.assume(JS.call(JS.get(value, "replace"), value, characterEscapeOrReference, JS.method3((JsValue _s, JsValue whole, JsValue escape, JsValue reference) => {
    if (escape.truthy()) {
      return escape;
    }
    string ref = JS.assume(reference);
    if (ref.charCodeAt(0) == 35) {
      int head = ref.charCodeAt(1);
      bool hex = head == 120 || head == 88;
      return decodeNumericCharacterReference(ref.slice(if (hex) { 2 } else { 1 }), if (hex) { 16 } else { 10 });
    }
    JsValue named = decodeNamedCharacterReference(ref);
    if (!named.truthy()) {
      named = whole;
    }
    return named;
  })));
}
