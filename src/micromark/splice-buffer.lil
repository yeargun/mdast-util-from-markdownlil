extern JsValue Object;
extern JsValue Array;
extern JsValue Math;
extern JsValue RangeError;

void chunkedPush(JsValue list, JsValue right) {
  if (right.length < 10000.0) {
    JS.apply(JS.get(list, "push"), list, right);
  } else {
    for (float chunkStart = 0.0; chunkStart < right.length; chunkStart = chunkStart + 10000.0) {
      JS.apply(JS.get(list, "push"), list, JS.invoke(right, "slice", chunkStart, chunkStart + 10000.0));
    }
  }
}

void setCursor(JsValue self, float n) {
  JsValue left = JS.get(self, "left");
  JsValue right = JS.get(self, "right");
  if (n == left.length || (n > left.length && right.length == 0.0) || (n < 0.0 && left.length == 0.0)) {
    return;
  }
  if (n < left.length) {
    chunkedPush(right, JS.invoke(JS.invoke(left, "splice", n, 1.0 / 0.0), "reverse"));
  } else {
    chunkedPush(left, JS.invoke(JS.invoke(right, "splice", left.length + right.length - n, 1.0 / 0.0), "reverse"));
  }
}

float sizeOf(JsValue self) {
  return JS.get(self, "left").length + JS.get(self, "right").length;
}

export JsValue SpliceBuffer = JS.method1((JsValue self, JsValue initial) => {
  JS.set(self, "left", if (initial.truthy()) { JS.call(JS.get(Array, "from"), Array, initial) } else { JS.array() });
  JS.set(self, "right", JS.array());
  return JS.undefined();
});

JS.call(JS.get(Object, "assign"), Object, JS.get(SpliceBuffer, "prototype"), JS.object(
  "get", JS.method1((JsValue self, JsValue indexVal) => {
    float index = JS.assume(indexVal);
    JsValue left = JS.get(self, "left");
    JsValue right = JS.get(self, "right");
    if (index < 0.0 || index >= left.length + right.length) {
      throw JS.construct(RangeError, "Cannot access index `" + indexVal + "` in a splice buffer of size `" + JS.string(left.length + right.length) + "`");
    }
    if (index < left.length) {
      return left[index];
    }
    return right[right.length - index + left.length - 1.0];
  }),
  "shift", JS.method0((JsValue self) => {
    setCursor(self, 0.0);
    return JS.invoke(JS.get(self, "right"), "pop");
  }),
  "slice", JS.method2((JsValue self, JsValue startVal, JsValue endVal) => {
    float start = JS.assume(startVal);
    float stop = JS.assume(if (JS.isNullish(endVal)) { 1.0 / 0.0 } else { endVal });
    JsValue left = JS.get(self, "left");
    JsValue right = JS.get(self, "right");
    if (stop < left.length) {
      return JS.invoke(left, "slice", startVal, stop);
    }
    if (start > left.length) {
      return JS.invoke(JS.invoke(right, "slice", right.length - stop + left.length, right.length - start + left.length), "reverse");
    }
    return JS.invoke(JS.invoke(left, "slice", startVal), "concat", JS.invoke(JS.invoke(right, "slice", right.length - stop + left.length), "reverse"));
  }),
  "splice", JS.method3((JsValue self, JsValue start, JsValue deleteCount, JsValue items) => {
    float count = JS.assume(JS.or(deleteCount, 0));
    setCursor(self, JS.assume(JS.invoke(Math, "trunc", start)));
    JsValue right = JS.get(self, "right");
    JsValue removed = JS.invoke(right, "splice", right.length - count, 1.0 / 0.0);
    if (items.truthy()) {
      chunkedPush(JS.get(self, "left"), items);
    }
    return JS.invoke(removed, "reverse");
  }),
  "pop", JS.method0((JsValue self) => {
    setCursor(self, 1.0 / 0.0);
    return JS.invoke(JS.get(self, "left"), "pop");
  }),
  "push", JS.method1((JsValue self, JsValue item) => {
    setCursor(self, 1.0 / 0.0);
    JS.invoke(JS.get(self, "left"), "push", item);
    return JS.undefined();
  }),
  "pushMany", JS.method1((JsValue self, JsValue items) => {
    setCursor(self, 1.0 / 0.0);
    chunkedPush(JS.get(self, "left"), items);
    return JS.undefined();
  }),
  "unshift", JS.method1((JsValue self, JsValue item) => {
    setCursor(self, 0.0);
    JS.invoke(JS.get(self, "right"), "push", item);
    return JS.undefined();
  }),
  "unshiftMany", JS.method1((JsValue self, JsValue items) => {
    setCursor(self, 0.0);
    chunkedPush(JS.get(self, "right"), JS.invoke(items, "reverse"));
    return JS.undefined();
  }),
  "setCursor", JS.method1((JsValue self, JsValue n) => {
    setCursor(self, JS.assume(n));
    return JS.undefined();
  })
));

JS.invoke(Object, "defineProperty", JS.get(SpliceBuffer, "prototype"), "length", JS.object(
  "get", JS.method0((JsValue self) => {
    return sizeOf(self);
  })
));
