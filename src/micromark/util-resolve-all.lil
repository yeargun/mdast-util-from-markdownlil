export JsValue resolveAll(JsValue constructs, JsValue events, JsValue context) {
  JsValue[] called = [];
  JsValue next = events;
  for (float index = 0.0; index < constructs.length; index++) {
    JsValue resolve = JS.get(constructs[index], "resolveAll");
    if (resolve.truthy() && !called.includes(resolve)) {
      next = JS.call(resolve, JS.undefined(), next, context);
      called.push(resolve);
    }
  }
  return next;
}
