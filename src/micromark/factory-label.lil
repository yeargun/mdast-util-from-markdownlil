import { markdownLineEnding, markdownSpace } from "./util-character.lil";
import { cBackslash, cCaret, cLeftSquareBracket, cRightSquareBracket, codeEq } from "./symbol/codes.lil";
import { kContentTypeString, kLinkReferenceSizeMax } from "./symbol/constants.lil";
import { tChunkString, tLineEnding } from "./symbol/types.lil";

// Upstream calls this with the tokenize context as `this`; here it is the first
// parameter.
export JsValue factoryLabel(JsValue self, JsValue effects, JsValue ok, JsValue nok, string typ, string markerType, string stringType) {
  float size = 0.0;
  bool seen = false;
  JsValue atBreak = JS.undefined();
  JsValue labelInside = JS.undefined();
  JsValue labelEscape = JS.undefined();

  JsValue start = JS.method1((JsValue _s, JsValue code) => {
    JS.invoke(effects, "enter", typ);
    JS.invoke(effects, "enter", markerType);
    JS.invoke(effects, "consume", code);
    JS.invoke(effects, "exit", markerType);
    JS.invoke(effects, "enter", stringType);
    return atBreak;
  });

  atBreak = JS.method1((JsValue _s, JsValue code) => {
    if (
      size > kLinkReferenceSizeMax ||
      JS.strictEqual(code, null) ||
      codeEq(code, cLeftSquareBracket) ||
      (codeEq(code, cRightSquareBracket) && !seen) ||
      (codeEq(code, cCaret) && size == 0.0 && JS.in("_hiddenFootnoteSupport", JS.get(JS.get(self, "parser"), "constructs")))
    ) {
      return JS.call(nok, JS.undefined(), code);
    }
    if (codeEq(code, cRightSquareBracket)) {
      JS.invoke(effects, "exit", stringType);
      JS.invoke(effects, "enter", markerType);
      JS.invoke(effects, "consume", code);
      JS.invoke(effects, "exit", markerType);
      JS.invoke(effects, "exit", typ);
      return ok;
    }
    if (markdownLineEnding(code)) {
      JS.invoke(effects, "enter", tLineEnding);
      JS.invoke(effects, "consume", code);
      JS.invoke(effects, "exit", tLineEnding);
      return atBreak;
    }
    JS.invoke(effects, "enter", tChunkString, JS.object("contentType", kContentTypeString));
    return JS.call(labelInside, JS.undefined(), code);
  });

  labelInside = JS.method1((JsValue _s, JsValue code) => {
    if (
      JS.strictEqual(code, null) ||
      codeEq(code, cLeftSquareBracket) ||
      codeEq(code, cRightSquareBracket) ||
      markdownLineEnding(code) ||
      size > kLinkReferenceSizeMax
    ) {
      JS.invoke(effects, "exit", tChunkString);
      return JS.call(atBreak, JS.undefined(), code);
    }
    size++;
    JS.invoke(effects, "consume", code);
    if (!seen) {
      seen = !markdownSpace(code);
    }
    return if (codeEq(code, cBackslash)) { labelEscape } else { labelInside };
  });

  labelEscape = JS.method1((JsValue _s, JsValue code) => {
    if (codeEq(code, cLeftSquareBracket) || codeEq(code, cBackslash) || codeEq(code, cRightSquareBracket)) {
      JS.invoke(effects, "consume", code);
      size++;
      return labelInside;
    }
    return JS.call(labelInside, JS.undefined(), code);
  });

  return start;
}
