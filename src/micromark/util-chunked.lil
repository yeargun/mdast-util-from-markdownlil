extern JsValue Array;

export void splice(JsValue list, JsValue startVal, JsValue removeVal, JsValue items) {
  float end = list.length;
  float start = JS.assume(startVal);
  float remove = JS.assume(removeVal);
  float chunkStart = 0.0;
  if (start < 0.0) {
    start = if (-start > end) { 0.0 } else { end + start };
  } else {
    start = if (start > end) { end } else { start };
  }
  remove = if (remove > 0.0) { remove } else { 0.0 };
  if (items.length < 10000.0) {
    JsValue parameters = JS.call(JS.get(Array, "from"), Array, items);
    JS.invoke(parameters, "unshift", start, remove);
    JS.apply(JS.get(list, "splice"), list, parameters);
  } else {
    if (remove != 0.0) {
      JS.invoke(list, "splice", start, remove);
    }
    while (chunkStart < items.length) {
      JsValue parameters = JS.invoke(items, "slice", chunkStart, chunkStart + 10000.0);
      JS.invoke(parameters, "unshift", start, 0);
      JS.apply(JS.get(list, "splice"), list, parameters);
      chunkStart = chunkStart + 10000.0;
      start = start + 10000.0;
    }
  }
}

export JsValue pushAll(JsValue list, JsValue items) {
  if (list.length > 0.0) {
    splice(list, list.length, 0, items);
    return list;
  }
  return items;
}
