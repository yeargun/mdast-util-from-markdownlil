export JsValue kids() {
  return JS.array();
}

export void add(JsValue arr, JsValue node) {
  JS.invoke(arr, "push", node);
}

export int count(JsValue arr) {
  return JS.number(arr["length"]).toInt();
}

export JsValue at(JsValue arr, int i) {
  return arr[i];
}

export bool isWsCode(int c) {
  return c == 32 || c == 9 || c == 10 || c == 13;
}

export bool isSpaceTab(int c) {
  return c == 32 || c == 9;
}

export bool isDigit(int c) {
  return c >= 48 && c <= 57;
}

export bool isAlpha(int c) {
  return (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
}

export bool isAlnum(int c) {
  return isDigit(c) || isAlpha(c);
}

export bool isAsciiPunct(int c) {
  if (c >= 33 && c <= 47) {
    return true;
  }
  if (c >= 58 && c <= 64) {
    return true;
  }
  if (c >= 91 && c <= 96) {
    return true;
  }
  if (c >= 123 && c <= 126) {
    return true;
  }
  return false;
}

export int skipSpaceTab(string s, int i) {
  while (i < s.length && isSpaceTab(s.charCodeAt(i))) {
    i = i + 1;
  }
  return i;
}

export string rtrimWs(string s) {
  int end = s.length;
  while (end > 0 && isWsCode(s.charCodeAt(end - 1))) {
    end = end - 1;
  }
  return s.slice(0, end);
}

export string ltrimWs(string s) {
  int i = 0;
  while (i < s.length && isWsCode(s.charCodeAt(i))) {
    i = i + 1;
  }
  return s.slice(i);
}

export bool isBlank(string line) {
  int i = 0;
  while (i < line.length) {
    if (!isSpaceTab(line.charCodeAt(i))) {
      return false;
    }
    i = i + 1;
  }
  return true;
}

export int indentCols(string line) {
  int col = 0;
  int i = 0;
  while (i < line.length) {
    string ch = line.charAt(i);
    if (ch == " ") {
      col = col + 1;
    } else if (ch == "\t") {
      col = col + (4 - col % 4);
    } else {
      break;
    }
    i = i + 1;
  }
  return col;
}

export int indentChars(string line) {
  int i = 0;
  while (i < line.length) {
    string ch = line.charAt(i);
    if (ch != " " && ch != "\t") {
      break;
    }
    i = i + 1;
  }
  return i;
}

export string stripCols(string line, int cols) {
  if (cols <= 0) {
    return line;
  }
  int i = 0;
  int col = 0;
  while (i < line.length && col < cols) {
    string ch = line.charAt(i);
    if (ch == " ") {
      col = col + 1;
      i = i + 1;
    } else if (ch == "\t") {
      col = col + (4 - col % 4);
      i = i + 1;
    } else {
      break;
    }
  }
  return line.slice(i);
}

export string normalizeNewlines(string src) {
  Regex re = new Regex("\\r\\n?", "g");
  re.lastIndex = 0;
  return src.replace(re, "\n");
}

export string[] splitLines(string src) {
  return src.split("\n");
}

export string joinLines(string[] lines) {
  string out = "";
  int i = 0;
  while (i < lines.length) {
    if (i > 0) {
      out = out + "\n";
    }
    out = out + lines[i];
    i = i + 1;
  }
  return out;
}

export string normId(string label) {
  string t = label.trim().toLowerCase();
  string out = "";
  bool space = false;
  int i = 0;
  while (i < t.length) {
    int c = t.charCodeAt(i);
    if (isWsCode(c)) {
      if (!space) {
        out = out + " ";
        space = true;
      }
    } else {
      out = out + t.charAt(i);
      space = false;
    }
    i = i + 1;
  }
  return out;
}

export string unescape(string s) {
  string out = "";
  int i = 0;
  while (i < s.length) {
    string ch = s.charAt(i);
    if (ch == "\\" && i + 1 < s.length) {
      string next = s.charAt(i + 1);
      int c = next.charCodeAt(0);
      if (isAsciiPunct(c)) {
        out = out + next;
        i = i + 2;
        continue;
      }
    }
    out = out + ch;
    i = i + 1;
  }
  return out;
}

string protocolKey(string url) {
  string proto = "";
  int i = 0;
  while (i < url.length && url.charCodeAt(i) <= 32) {
    i = i + 1;
  }
  while (i < url.length) {
    string ch = url.charAt(i);
    if (ch == ":") {
      break;
    }
    int c = ch.charCodeAt(0);
    if (c > 32) {
      proto = proto + ch.toLowerCase();
    }
    i = i + 1;
  }
  return proto;
}

export string safeUrl(string url) {
  string proto = protocolKey(url);
  if (proto == "javascript" || proto == "vbscript") {
    return "";
  }
  return url;
}

export string escapeHtml(string html) {
  string out = "";
  int i = 0;
  while (i < html.length) {
    string ch = html.charAt(i);
    if (ch == "&") {
      out = out + "&amp;";
    } else if (ch == "<") {
      out = out + "&lt;";
    } else if (ch == ">") {
      out = out + "&gt;";
    } else if (ch == "\"") {
      out = out + "&quot;";
    } else if (ch == "'") {
      out = out + "&#39;";
    } else {
      out = out + ch;
    }
    i = i + 1;
  }
  return out;
}

export int findClosing(string s, int start, string openCh, string closeCh) {
  int i = start;
  if (openCh == closeCh) {
    while (i < s.length) {
      string ch = s.charAt(i);
      if (ch == "\\" && i + 1 < s.length) {
        i = i + 2;
        continue;
      }
      if (ch == closeCh) {
        return i;
      }
      i = i + 1;
    }
    return -1;
  }
  int depth = 1;
  while (i < s.length) {
    string ch = s.charAt(i);
    if (ch == "\\" && i + 1 < s.length) {
      i = i + 2;
      continue;
    }
    if (ch == openCh) {
      depth = depth + 1;
    } else if (ch == closeCh) {
      depth = depth - 1;
      if (depth == 0) {
        return i;
      }
    }
    i = i + 1;
  }
  return -1;
}

export string[] splitPipes(string row) {
  string[] cells = [];
  string cur = "";
  int i = 0;
  while (i < row.length) {
    string ch = row.charAt(i);
    if (ch == "\\" && i + 1 < row.length && row.charAt(i + 1) == "|") {
      cur = cur + "|";
      i = i + 2;
      continue;
    }
    if (ch == "|") {
      cells.push(cur);
      cur = "";
    } else {
      cur = cur + ch;
    }
    i = i + 1;
  }
  cells.push(cur);
  if (cells.length > 0 && cells[0].trim().length == 0) {
    cells.splice(0, 1);
  }
  if (cells.length > 0 && cells[cells.length - 1].trim().length == 0) {
    cells.splice(cells.length - 1, 1);
  }
  int j = 0;
  while (j < cells.length) {
    cells[j] = unescape(cells[j].trim());
    j = j + 1;
  }
  return cells;
}

export bool isPunctOrWs(int c) {
  return c < 0 || isWsCode(c) || isAsciiPunct(c);
}
